<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Criar conta - Calixto OmniSystem</title>
    <%- include('partials/auth-estilo') %>
</head>
<body>
    <header class="topo"><a class="marca" href="/"><span class="marca-icone" aria-hidden="true"><i class="ri-chat-smile-3-fill"></i></span>Calixto</a></header>
    <main>
        <div class="caixa">
            <h1>Criar conta</h1>
            <p class="sub">Depois do cadastro, o administrador libera seu acesso.</p>

            <% if (locals.message && message.length > 0) { %>
                <div class="msg erro" role="alert"><i class="ri-error-warning-line"></i><span><%= message %></span></div>
            <% } %>
            <% const d = locals.dados || {}; %>

            <form action="/registro" method="POST">
                <label for="nome">Nome</label>
                <input type="text" id="nome" name="nome" required maxlength="100" autocomplete="name" value="<%= d.nome || '' %>">

                <label for="email">E-mail</label>
                <input type="email" id="email" name="email" required autocomplete="email" value="<%= d.email || '' %>">

                <label for="senha">Senha</label>
                <div class="campo">
                    <input type="password" id="senha" name="senha" required minlength="8" maxlength="100" autocomplete="new-password">
                    <button type="button" class="ver-senha" aria-label="Mostrar senha"><i class="ri-eye-line"></i></button>
                </div>
                <p class="dica">Pelo menos 8 caracteres.</p>

                <label for="confirmar">Repita a senha</label>
                <div class="campo">
                    <input type="password" id="confirmar" name="confirmar" required minlength="8" maxlength="100" autocomplete="new-password">
                    <button type="button" class="ver-senha" aria-label="Mostrar senha"><i class="ri-eye-line"></i></button>
                </div>

                <label class="check"><input type="checkbox" name="termos" required>
                    <span>Li e concordo com os <a href="/termos" target="_blank">Termos de Uso</a> e a <a href="/privacidade" target="_blank">Política de Privacidade</a>.</span></label>

                <button class="btn" type="submit">Criar conta</button>
            </form>

            <p class="rodape">Já tem conta? <a href="/login">Entrar</a></p>
        </div>
    </main>
</body>
</html>
