<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calixto OmniSystem | V15.0</title>
    
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;500;700&display=swap" rel="stylesheet">

    <style>
        /* ==================== 1. CSS BASE & VARIÁVEIS ==================== */
        :root {
            --neon-pink: #ff0055;
            --neon-cyan: #00f3ff;
            --neon-purple: #bd00ff;
            --glass-dark: rgba(0, 0, 0, 0.85);
            --glass-border: rgba(255, 255, 255, 0.1);
            --text-white: #ffffff;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: #050505;
            color: var(--text-white);
            font-family: 'Rajdhani', sans-serif;
            overflow-x: hidden;
            /* Fundo Cyberpunk */
            background-image: url('/uploads/illustration-rain-futuristic-city_23-2151406573.avif');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            min-height: 100vh;
            cursor: default;
            transition: 0.5s; /* Suaviza a troca para Matrix/Red Alert */
        }

        body::after {
            content: ''; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(5, 5, 10, 0.7); z-index: -1; /* Máscara escura */
        }

        /* ==================== 2. LOADER JARVIS ==================== */
        #jarvis-loader {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-color: #000; z-index: 99999;
            display: flex; align-items: center; justify-content: center;
            background-image: radial-gradient(circle at center, #001a33 0%, #000 80%);
            transition: opacity 0.8s ease-out, visibility 0.8s;
        }
        #jarvis-loader.loaded { opacity: 0; visibility: hidden; }

        .hud-container { position: relative; width: 350px; height: 350px; display: flex; align-items: center; justify-content: center; }
        .hud-ring { position: absolute; border-radius: 50%; box-shadow: 0 0 10px rgba(0, 243, 255, 0.1); }
        .ring-1 { width: 100%; height: 100%; border: 2px solid transparent; border-top: 2px solid var(--neon-cyan); border-bottom: 2px solid var(--neon-cyan); animation: spin 10s linear infinite; }
        .ring-2 { width: 80%; height: 80%; border: 2px dashed var(--neon-cyan); opacity: 0.6; animation: spin-reverse 5s linear infinite; }
        .ring-3 { width: 65%; height: 65%; border: 1px solid transparent; border-left: 4px solid var(--neon-cyan); border-right: 4px solid var(--neon-cyan); box-shadow: 0 0 20px var(--neon-cyan); animation: spin 2s linear infinite; }
        .hud-core { position: absolute; width: 50%; height: 50%; border: 1px solid var(--neon-cyan); border-radius: 50%; box-shadow: inset 0 0 20px rgba(0, 243, 255, 0.5); opacity: 0.8; }
        .hud-text { position: absolute; color: #fff; font-family: 'Orbitron', sans-serif; font-weight: 700; font-size: 1.2rem; letter-spacing: 3px; text-align: center; text-shadow: 0 0 10px var(--neon-cyan); z-index: 10; animation: pulse 2s infinite; }
        .hud-text span { display: block; color: var(--neon-cyan); font-size: 0.8rem; letter-spacing: 1px; margin-top: 5px; opacity: 0.8; }

        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        @keyframes spin-reverse { 0% { transform: rotate(360deg); } 100% { transform: rotate(0deg); } }
        @keyframes pulse { 0% { opacity: 0.8; text-shadow: 0 0 10px var(--neon-cyan); } 100% { opacity: 1; text-shadow: 0 0 25px var(--neon-cyan); } }

        /* ==================== 3. GOD MODE CONSOLE (O SEGREDO DA LOGO) ==================== */
        #god-console {
            position: fixed; bottom: -300px; left: 0; width: 100%; height: 250px;
            background: rgba(0, 0, 0, 0.95); border-top: 2px solid #0f0; color: #0f0;
            font-family: 'Share Tech Mono', monospace; z-index: 1000000;
            transition: bottom 0.5s cubic-bezier(0.4, 0.0, 0.2, 1);
            display: flex; flex-direction: column; box-shadow: 0 -5px 20px rgba(0, 255, 0, 0.2);
        }
        #god-console.active { bottom: 0; }
        .console-header { background: #0f0; color: #000; padding: 5px 10px; font-weight: bold; font-size: 12px; letter-spacing: 1px; }
        .console-output { flex: 1; padding: 10px; overflow-y: auto; font-size: 14px; opacity: 0.8; }
        .console-input-line { display: flex; align-items: center; padding: 10px; background: #0a0a0a; border-top: 1px solid #333; }
        #console-input { flex: 1; background: transparent; border: none; color: #fff; font-family: 'Share Tech Mono', monospace; font-size: 16px; margin-left: 10px; outline: none; }

        /* EFEITOS ESPECIAIS (Matrix / Red Alert) */
        body.matrix-mode { background-image: url('https://media.giphy.com/media/hzIg4f671gBkA/giphy.gif') !important; background-size: cover; }
        body.matrix-mode * { color: #0f0 !important; border-color: #0f0 !important; text-shadow: 0 0 5px #0f0; }
        body.red-alert-mode { background-image: none !important; background-color: #1a0000 !important; --neon-pink: #ff0000 !important; --neon-cyan: #ff0000 !important; --neon-purple: #ff0000 !important; }
        body.red-alert-mode::after { background: rgba(50, 0, 0, 0.2); animation: pulse-red-bg 0.5s infinite alternate; }
        @keyframes pulse-red-bg { from { opacity: 0.1; } to { opacity: 0.5; } }

        /* ==================== 4. LAYOUT PRINCIPAL ==================== */
        nav {
            position: fixed; top: 0; width: 100%; display: flex; justify-content: space-between; align-items: center;
            padding: 20px 8%; z-index: 1000; backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255,255,255,0.05); background: linear-gradient(to bottom, rgba(0,0,0,0.9), transparent);
        }
        
        /* LOGO CLICÁVEL (GATILHO DO EASTER EGG) */
        .logo { 
            font-family: 'Orbitron', sans-serif; font-size: 1.8rem; font-weight: 900; 
            letter-spacing: 2px; color: #fff; text-shadow: 0 0 10px var(--neon-cyan); 
            cursor: pointer; user-select: none; /* Pointer avisa que é clicável */
        }
        .logo span { color: var(--neon-cyan); }
        
        .nav-right { display: flex; align-items: center; gap: 20px; }
        .social-link { color: #ccc; font-size: 1.4rem; text-decoration: none; transition: 0.3s; display: flex; align-items: center; cursor: pointer; }
        .social-link:hover { transform: scale(1.1); color: #fff; }
        .nav-divider { width: 1px; height: 25px; background: rgba(255,255,255,0.2); }
        .btn-login { text-decoration: none; color: var(--neon-cyan); font-weight: 700; font-size: 0.9rem; text-transform: uppercase; padding: 8px 25px; border: 1px solid var(--neon-cyan); border-radius: 4px; transition: 0.3s; background: rgba(0, 243, 255, 0.1); cursor: pointer; }
        .btn-login:hover { background: var(--neon-cyan); color: #000; box-shadow: 0 0 20px var(--neon-cyan); }

        /* HERO SECTION */
        .hero { height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 0 20px; position: relative; }
        .tag-version { background: linear-gradient(90deg, var(--neon-purple), var(--neon-pink)); padding: 5px 12px; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; margin-bottom: 20px; box-shadow: 0 0 15px rgba(255, 0, 85, 0.5); transform: skew(-10deg); }
        
        /* TÍTULO COM O "O" SECRETO */
        .hero h1 { 
            font-family: 'Orbitron'; font-size: clamp(3rem, 6vw, 5.5rem); line-height: 1.1; 
            text-transform: uppercase; margin-bottom: 20px; text-shadow: 0 0 30px rgba(0,0,0,0.8);
            display: flex; flex-direction: column; align-items: center; gap: 10px;
        }
        
        .hero h1 span.outline { display: block; color: transparent; -webkit-text-stroke: 1px #fff; opacity: 0.8; font-size: 0.7em; }
        
        .hero h1 strong { 
            background: linear-gradient(to bottom, #fff, var(--neon-cyan)); 
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; 
            filter: drop-shadow(0 0 10px var(--neon-cyan)); 
        }

        /* Lógica do "O" Secreto */
        #secret-o {
            cursor: default; background: inherit; -webkit-text-fill-color: inherit; transition: all 0.3s ease;
        }
        #secret-o.activated {
            background: none !important; -webkit-text-fill-color: #fff !important; color: #fff !important;
            text-shadow: 0 0 10px #fff, 0 0 20px var(--neon-cyan), 0 0 40px var(--neon-cyan), 0 0 80px var(--neon-cyan) !important;
        }

        .hero p { font-size: 1.2rem; max-width: 700px; color: #ddd; margin-bottom: 40px; line-height: 1.6; text-shadow: 0 2px 5px rgba(0,0,0,1); background: rgba(0,0,0,0.5); padding: 15px; border-radius: 10px; backdrop-filter: blur(5px); }
        .cta-btn { padding: 18px 50px; background: var(--neon-pink); color: #fff; text-decoration: none; font-weight: 800; font-size: 1.1rem; border-radius: 50px; transition: 0.3s; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 0 20px rgba(255, 0, 85, 0.4); border: 1px solid rgba(255,255,255,0.2); cursor: pointer; }
        .cta-btn:hover { transform: scale(1.05); box-shadow: 0 0 40px rgba(255, 0, 85, 0.8); background: #fff; color: var(--neon-pink); }

        /* PREÇOS */
        section { padding: 80px 5%; position: relative; }
        .section-title { text-align: center; font-family: 'Orbitron'; font-size: 2.5rem; margin-bottom: 10px; text-shadow: 0 0 10px var(--neon-purple); }
        .section-subtitle { text-align: center; color: #aaa; margin-bottom: 60px; font-size: 1.1rem; }
        .pricing-grid { display: flex; justify-content: center; flex-wrap: wrap; gap: 30px; }
        .price-card { background: var(--glass-dark); border: 1px solid var(--glass-border); backdrop-filter: blur(20px); padding: 40px 30px; border-radius: 15px; width: 350px; text-align: center; transition: 0.4s; position: relative; }
        .price-card:hover { transform: translateY(-10px); border-color: var(--neon-cyan); box-shadow: 0 0 30px rgba(0, 243, 255, 0.2); }
        .price-card.featured { border: 1px solid var(--neon-pink); background: rgba(20, 0, 10, 0.85); box-shadow: 0 0 20px rgba(255, 0, 85, 0.2); transform: scale(1.05); z-index: 10; }
        .badge-popular { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: var(--neon-pink); color: #fff; padding: 5px 15px; font-size: 0.8rem; font-weight: bold; border-radius: 20px; text-transform: uppercase; }
        .plan-name { font-family: 'Orbitron'; font-size: 1.5rem; margin-bottom: 10px; color: #fff; }
        .price { font-size: 2.8rem; font-weight: 700; color: #fff; display: block; margin: 15px 0; text-shadow: 0 0 10px rgba(255,255,255,0.3); }
        .price span { font-size: 1rem; color: #aaa; font-weight: 400; }
        .features { list-style: none; text-align: left; margin-bottom: 40px; }
        .features li { padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,0.1); color: #ddd; display: flex; align-items: center; gap: 10px; font-size: 0.95rem; }
        .features li i { color: var(--neon-cyan); font-size: 1.1rem; }
        .btn-plan { display: block; width: 100%; padding: 15px 0; text-decoration: none; color: #fff; border: 1px solid rgba(255,255,255,0.3); border-radius: 5px; font-weight: bold; text-transform: uppercase; transition: 0.3s; cursor: pointer; }
        .btn-plan:hover { background: #fff; color: #000; }
        .featured .btn-plan { background: var(--neon-pink); border-color: var(--neon-pink); }
        .featured .btn-plan:hover { background: #ff3377; color: #fff; box-shadow: 0 0 20px var(--neon-pink); }

        /* GALERIA (AI STUDIO) */
        .gallery-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-top: 40px; }
        .gallery-item { aspect-ratio: 16/9; background: rgba(0,0,0,0.5); border: 1px solid var(--glass-border); border-radius: 10px; overflow: hidden; position: relative; display: flex; align-items: center; justify-content: center; transition: 0.3s; }
        .gallery-item:hover { border-color: var(--neon-purple); transform: scale(1.02); }
        .placeholder-text { position:absolute; bottom:10px; left:0; width:100%; font-family:'Orbitron'; font-size:0.8rem; color:rgba(255,255,255,0.7); text-align: center; pointer-events:none; }
        
        footer { text-align: center; padding: 40px; font-size: 0.8rem; color: #888; border-top: 1px solid rgba(255,255,255,0.1); background: #000; margin-top: 50px; }
    </style>
</head>
