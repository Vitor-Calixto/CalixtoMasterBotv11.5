<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Entrar - Calixto OmniSystem</title>
    <%- include('partials/auth-estilo') %>
</head>
<body>
    <header class="topo"><a class="marca" href="/"><span class="marca-icone" aria-hidden="true"><i class="ri-chat-smile-3-fill"></i></span>Calixto</a></header>
    <main>
        <div class="caixa">
            <h1>Entrar</h1>
            <p class="sub">Acesse o painel dos seus robôs.</p>

            <% if (locals.aviso && aviso) { %>
                <div class="msg <%= aviso.tipo %>" role="status"><i class="<%= aviso.tipo === 'erro' ? 'ri-error-warning-line' : aviso.tipo === 'ok' ? 'ri-checkbox-circle-line' : 'ri-information-line' %>"></i><span><%= aviso.texto %></span></div>
            <% } %>
            <% const textoErro = (locals.erro) || (locals.message && message.length ? message : null); %>
            <% if (textoErro) { %>
                <div class="msg erro" role="alert"><i class="ri-error-warning-line"></i><span><%= textoErro %></span></div>
            <% } %>

            <form action="/login" method="POST">
                <label for="email">E-mail</label>
                <input type="email" id="email" name="email" required autocomplete="username" value="<%= locals.email || '' %>" <%= locals.email ? '' : 'autofocus' %>>

                <label for="senha">Senha</label>
                <div class="campo">
                    <input type="password" id="senha" name="senha" required autocomplete="current-password" <%= locals.email ? 'autofocus' : '' %>>
                    <button type="button" class="ver-senha" aria-label="Mostrar senha"><i class="ri-eye-line"></i></button>
                </div>
                <div class="linha-acoes"><a href="/esqueci-senha">Esqueci minha senha</a></div>

                <button class="btn" type="submit">Entrar</button>
            </form>

            <p class="rodape">Ainda não tem conta? <a href="/registro">Criar conta</a></p>
        </div>
    </main>
</body>
</html>
