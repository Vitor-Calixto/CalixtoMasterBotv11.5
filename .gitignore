# --- Dependências ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Ambiente e Segredos (CRÍTICO) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Sessões do WhatsApp (SEGURANÇA MÁXIMA) ---
