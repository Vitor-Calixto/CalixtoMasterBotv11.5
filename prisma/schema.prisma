// ARQUIVO: prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- NOVO: TABELA DE USUÁRIOS (LOGIN) ---
model Usuario {
  id           String    @id @default(uuid())
  email        String    @unique
  senha        String
  nome         String
  role         String    @default("CLIENTE") // "ADMIN" ou "CLIENTE"
  
  // Campos para recuperar senha (já deixamos pronto!)
  resetToken   String?   
  resetExpires DateTime?

  criadoEm     DateTime  @default(now())
  
  // Relacionamento: Um usuário pode ter vários bots
  clientes     Cliente[] 
}

// --- ATUALIZAÇÃO: TABELA CLIENTE ---
model Cliente {
  id        String   @id @default(uuid())
  nome      String
  numero    String?  @unique
  ativo     Boolean  @default(true)
  fluxoJson Json?
  status    String   @default("OFFLINE")
  criadoEm  DateTime @default(now())

  // --- VÍNCULO COM O DONO (Opcional para não quebrar bots antigos) ---
  donoId    String?  
  dono      Usuario? @relation(fields: [donoId], references: [id])
  // -------------------------------------------------------

  contatos      Contato[]
  sessoesAtivas SessaoAtiva[]
}

model SessaoAtiva {
  id        String   @id @default(uuid())
  clienteId String
  chatId    String
  noAtual   String
  dados     Json?
  updatedAt DateTime @updatedAt
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  @@unique([clienteId, chatId])
}

model Contato {
  id        String   @id @default(uuid())
  remoteJid String
  nome      String?
  clienteId String
  criadoEm  DateTime @default(now())
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  mensagens Mensagem[]
}

model Mensagem {
  id        String   @id @default(uuid())
  texto     String
  tipo      String   @default("texto")
  fromMe    Boolean
  contatoId String
  criadoEm  DateTime @default(now())
  contato   Contato  @relation(fields: [contatoId], references: [id], onDelete: Cascade)
}