<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Calixto OmniSystem | Automação de Elite</title>
    
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;800;900&family=Rajdhani:wght@300;500;700&display=swap" rel="stylesheet">

    <style>
        /* ==================== CSS BASE (CYBERPUNK COMMERCIAL) ==================== */
        :root {
            --neon-pink: #ff0055;
            --neon-cyan: #00f3ff;
            --neon-purple: #bd00ff;
            --bg-dark: #050505;
            --text-white: #ffffff;
            --glass-bg: rgba(10, 15, 20, 0.7);
            --glass-border: rgba(0, 243, 255, 0.2);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; scroll-behavior: smooth; }

        body {
            background-color: var(--bg-dark);
            color: var(--text-white);
            font-family: 'Rajdhani', sans-serif;
            overflow-x: hidden;
            background-image: url('/uploads/illustration-rain-futuristic-city_23-2151406573.avif');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            min-height: 100vh;
            transition: 0.5s;
        }

        /* Máscara escura */
        body::before {
            content: ''; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 5, 10, 0.85); z-index: -1; pointer-events: none;
        }

        /* Tipografia */
        h1, h2, h3, .logo, .btn-plan, .section-title, .hero-badge { font-family: 'Orbitron', sans-serif; }

        .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
        .section-padding { padding: 100px 0; }
        .text-center { text-align: center; }

        .section-title {
            font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 10px; text-transform: uppercase;
            letter-spacing: 2px; text-shadow: 0 0 15px var(--neon-cyan); color: #fff;
        }
        .section-subtitle { color: #aaa; font-size: 1.2rem; margin-bottom: 60px; max-width: 700px; margin-left: auto; margin-right: auto; }

        /* Botão Neon */
        .cta-btn {
            display: inline-block; padding: 18px 45px; 
            background: linear-gradient(90deg, var(--neon-pink), var(--neon-purple));
            color: #fff; text-decoration: none; font-weight: 700; border-radius: 5px; 
            text-transform: uppercase; letter-spacing: 2px; transition: 0.3s; border: 1px solid rgba(255,255,255,0.2);
            box-shadow: 0 0 20px rgba(255, 0, 85, 0.4); font-family: 'Orbitron'; font-size: 0.9rem;
        }
        .cta-btn:hover { transform: scale(1.05); box-shadow: 0 0 40px rgba(255, 0, 85, 0.8); background: #fff; color: #000; }

        /* ==================== NAVBAR ==================== */
        nav {
            display: flex; justify-content: space-between; align-items: center; padding: 15px 5%;
            position: fixed; width: 100%; top: 0; z-index: 1000;
            background: rgba(0, 0, 0, 0.8); backdrop-filter: blur(10px); 
            border-bottom: 1px solid var(--glass-border);
        }
        .logo { font-size: 1.5rem; font-weight: 900; color: #fff; cursor: pointer; user-select: none; letter-spacing: 2px; }
        .logo span { color: var(--neon-cyan); }
        
        .nav-right { display: flex; align-items: center; gap: 30px; }
        .social-link { color: #ccc; text-decoration: none; font-weight: 600; font-size: 0.9rem; transition: 0.3s; text-transform: uppercase; font-family: 'Orbitron'; letter-spacing: 1px; cursor: pointer; }
        .social-link:hover { color: var(--neon-cyan); text-shadow: 0 0 10px var(--neon-cyan); }
        
        .btn-login-nav { border: 1px solid var(--neon-cyan); padding: 8px 25px; border-radius: 4px; color: var(--neon-cyan) !important; text-decoration: none; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; transition: 0.3s; font-family: 'Orbitron'; }
        .btn-login-nav:hover { background: var(--neon-cyan); color: #000 !important; box-shadow: 0 0 20px var(--neon-cyan); }
        
        @media(max-width: 768px) { .nav-right .social-link { display: none; } }

        /* ==================== HERO ==================== */
        .hero { 
            min-height: 100vh; display: flex; flex-direction: column; 
            justify-content: center; align-items: center; text-align: center; 
            padding: 120px 20px 80px; position: relative; 
        }
        .hero-content { position: relative; z-index: 1; max-width: 900px; }
        .hero-badge { display: inline-block; background: linear-gradient(90deg, var(--neon-purple), var(--neon-pink)); padding: 5px 15px; font-size: 0.8rem; font-weight: 800; margin-bottom: 30px; transform: skew(-10deg); box-shadow: 0 0 15px rgba(255,0,85,0.5); }
        
        .hero h1 { font-size: clamp(2.5rem, 8vw, 5rem); line-height: 1.1; margin-bottom: 30px; text-transform: uppercase; text-shadow: 0 0 30px rgba(0,0,0,0.8); }
        .hero h1 .outline { -webkit-text-stroke: 1px #fff; color: transparent; display: block; opacity: 0.7; font-size: 0.6em; margin-bottom: 10px; }
        .hero h1 strong { background: linear-gradient(to bottom, #fff, var(--neon-cyan)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; filter: drop-shadow(0 0 10px var(--neon-cyan)); }
        
        #secret-o { cursor: default; transition: 0.3s; }
        #secret-o.activated { text-shadow: 0 0 20px #fff, 0 0 40px var(--neon-cyan); color: #fff !important; -webkit-text-fill-color: #fff !important; }

        .hero p { font-size: 1.2rem; color: #ddd; margin-bottom: 50px; text-shadow: 0 2px 4px #000; }
        
        .hero-btns { display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; }

        /* ==================== AI STUDIO ==================== */
        .ai-cta-text {
            font-family: 'Orbitron', sans-serif; color: var(--neon-pink); font-weight: 800; font-size: 1.4rem;
            margin-top: 40px; margin-bottom: 20px; text-transform: uppercase; letter-spacing: 2px;
            text-shadow: 0 0 15px var(--neon-pink); animation: pulse-pink 2s infinite alternate;
        }
        @keyframes pulse-pink { from { opacity: 0.8; text-shadow: 0 0 10px var(--neon-pink); } to { opacity: 1; text-shadow: 0 0 30px var(--neon-pink); } }

        .gallery-grid { 
            display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); 
            gap: 30px; margin-top: 30px; 
        }
        .gallery-item { 
            width: 100%; aspect-ratio: 16/9; background: #000; border: 1px solid var(--neon-purple); 
            position: relative; overflow: hidden; border-radius: 10px; 
            box-shadow: 0 0 15px rgba(189, 0, 255, 0.1); transition: 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .gallery-item video, .gallery-item img { width: 100%; height: 100%; object-fit: cover; opacity: 0.85; transition: 0.4s; }
        
        .gallery-item:hover { transform: translateY(-5px) scale(1.02); box-shadow: 0 0 30px rgba(189, 0, 255, 0.4); border-color: var(--neon-cyan); }
        .gallery-item:hover video, .gallery-item:hover img { opacity: 1; transform: scale(1.05); }

        .gallery-overlay {
            position: absolute; bottom: 0; left: 0; width: 100%; padding: 20px 15px;
            background: linear-gradient(to top, rgba(0,0,0,0.95) 10%, transparent);
            font-family: 'Share Tech Mono', monospace; color: var(--neon-cyan); font-size: 1rem; font-weight: bold;
            letter-spacing: 1px; text-shadow: 0 0 5px var(--neon-cyan);
            transform: translateY(100%); transition: 0.4s;
        }
        .gallery-item:hover .gallery-overlay { transform: translateY(0); }

        /* ==================== COMPARATIVO ==================== */
        .comparison-wrapper { background: rgba(0,0,0,0.6); border: 1px solid var(--neon-cyan); border-radius: 5px; overflow: hidden; max-width: 900px; margin: 0 auto; box-shadow: 0 0 20px rgba(0, 243, 255, 0.1); }
        .comparison-table { display: grid; grid-template-columns: 1fr 1fr; }
        .comp-col { padding: 50px 30px; text-align: center; }
        .comp-human { border-right: 1px solid rgba(255,255,255,0.1); }
        .comp-ai { background: rgba(0, 243, 255, 0.05); position: relative; }
        .comp-ai::before { content: ''; position: absolute; top:0; left:0; width:100%; height:2px; background: var(--neon-cyan); box-shadow: 0 0 15px var(--neon-cyan); }
        .comp-title { font-size: 1.2rem; font-weight: 700; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 2px; }
        .comp-price { font-size: 2.5rem; font-weight: 700; color: #fff; margin-bottom: 20px; }
        .comp-list li { list-style: none; margin-bottom: 15px; display: flex; align-items: center; gap: 10px; color: #ccc; font-size: 1rem; text-align: left; }

        @media(max-width: 768px) { .comparison-table { grid-template-columns: 1fr; } .comp-human { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.1); } }

        /* ==================== DEPOIMENTOS ==================== */
        .testimonials-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; }
        .testimonial-card { 
            background: rgba(10, 10, 10, 0.8); border: 1px solid var(--glass-border); 
            padding: 30px; border-radius: 5px; position: relative; transition: 0.3s;
        }
        .testimonial-card:hover { border-color: var(--neon-purple); box-shadow: 0 0 20px rgba(189, 0, 255, 0.2); }
        .test-text { font-style: italic; color: #ddd; margin-bottom: 20px; font-size: 1rem; line-height: 1.6; }
        .test-author { display: flex; align-items: center; gap: 15px; }
        .test-avatar { width: 50px; height: 50px; background: #222; border-radius: 50%; border: 1px solid var(--neon-purple); background-size: cover; }
        .test-info h4 { color: #fff; font-weight: 700; font-family: 'Orbitron'; font-size: 0.9rem; }
        .test-info p { font-size: 0.8rem; color: #888; }

        /* ==================== PREÇOS ==================== */
        .pricing-grid { display: flex; justify-content: center; flex-wrap: wrap; gap: 30px; }
        .price-card { 
            background: var(--glass-dark); border: 1px solid var(--glass-border); backdrop-filter: blur(20px); 
            padding: 40px 30px; border-radius: 5px; width: 350px; text-align: center; transition: 0.4s; position: relative; 
        }
        .price-card:hover { transform: translateY(-10px); border-color: var(--neon-cyan); box-shadow: 0 0 30px rgba(0, 243, 255, 0.2); }
        .price-card.featured { border: 1px solid var(--neon-pink); background: rgba(20, 0, 10, 0.85); box-shadow: 0 0 20px rgba(255, 0, 85, 0.2); transform: scale(1.05); z-index: 10; }
        .badge-popular { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: var(--neon-pink); color: #fff; padding: 5px 15px; font-size: 0.8rem; font-weight: bold; border-radius: 20px; text-transform: uppercase; font-family: 'Orbitron'; letter-spacing: 1px; }
        
        .plan-name { font-size: 1.5rem; margin-bottom: 10px; color: #fff; }
        .price { font-size: 3rem; font-weight: 700; color: #fff; display: block; margin: 20px 0; text-shadow: 0 0 10px rgba(255,255,255,0.3); }
        .price span { font-size: 1rem; color: #aaa; font-weight: 400; }
        .features-list { list-style: none; text-align: left; margin-bottom: 40px; }
        .features-list li { padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.1); color: #ddd; display: flex; align-items: center; gap: 10px; font-size: 0.95rem; }
        .features-list li i { color: var(--neon-cyan); font-size: 1.1rem; }
        .featured .features-list li i { color: var(--neon-pink); }
        
        .btn-plan { display: block; width: 100%; padding: 15px 0; text-decoration: none; color: #fff; border: 1px solid rgba(255,255,255,0.3); border-radius: 4px; font-weight: bold; text-transform: uppercase; transition: 0.3s; cursor: pointer; letter-spacing: 2px; }
        .btn-plan:hover { background: #fff; color: #000; }
        .featured .btn-plan { background: var(--neon-pink); border-color: var(--neon-pink); }
        .featured .btn-plan:hover { background: #ff3377; color: #fff; box-shadow: 0 0 20px var(--neon-pink); }

        /* ==================== FAQ ==================== */
        .faq-grid { max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: 15px; }
        .faq-item { background: rgba(0,0,0,0.5); border: 1px solid var(--glass-border); border-radius: 5px; overflow: hidden; transition: 0.3s; }
        .faq-question { width: 100%; padding: 20px; text-align: left; background: transparent; border: none; color: #fff; font-family: 'Rajdhani'; font-weight: 700; font-size: 1.1rem; display: flex; justify-content: space-between; align-items: center; cursor: pointer; }
        .faq-answer { padding: 0 20px; max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out; color: #ccc; }
        .faq-item.active { border-color: var(--neon-cyan); box-shadow: 0 0 10px rgba(0, 243, 255, 0.1); }
        .faq-item.active .faq-answer { max-height: 200px; padding-bottom: 20px; }
        .faq-item.active i { transform: rotate(180deg); transition: 0.3s; color: var(--neon-cyan); }

        /* ==================== FOOTER ==================== */
        footer { background: #000; padding: 80px 0 30px; margin-top: 100px; border-top: 1px solid rgba(255,255,255,0.1); font-size: 0.9rem; color: #888; }
        .footer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 40px; margin-bottom: 60px; }
        .footer-logo { font-size: 1.5rem; font-weight: 900; color: #fff; margin-bottom: 20px; display: block; font-family: 'Orbitron'; letter-spacing: 2px; }
        .footer-logo span { color: var(--neon-cyan); }
        .footer-col h4 { font-size: 1.1rem; color: #fff; margin-bottom: 20px; font-family: 'Orbitron'; letter-spacing: 1px; }
        .footer-links { list-style: none; }
        .footer-links li { margin-bottom: 12px; }
        .footer-links a { color: #888; text-decoration: none; transition: 0.3s; font-family: 'Share Tech Mono'; }
        .footer-links a:hover { color: var(--neon-cyan); text-shadow: 0 0 5px var(--neon-cyan); }
        .copyright { text-align: center; padding-top: 30px; border-top: 1px solid rgba(255,255,255,0.05); font-family: 'Share Tech Mono'; }

        /* ==================== EASTER EGGS & FX ==================== */
        #god-console { position: fixed; bottom: -300px; left: 0; width: 100%; height: 250px; background: rgba(0, 0, 0, 0.95); border-top: 2px solid #0f0; color: #0f0; font-family: 'Share Tech Mono', monospace; z-index: 1000000; transition: bottom 0.5s; display: flex; flex-direction: column; }
        #god-console.active { bottom: 0; }
        .console-header { background: #0f0; color: #000; padding: 5px 10px; font-weight: bold; font-size: 12px; letter-spacing: 1px; }
        .console-output { flex: 1; padding: 10px; overflow-y: auto; font-size: 14px; opacity: 0.8; }
        .console-input-line { display: flex; align-items: center; padding: 10px; background: #0a0a0a; border-top: 1px solid #333; }
        #console-input { flex: 1; background: transparent; border: none; color: #fff; font-family: 'Share Tech Mono', monospace; font-size: 16px; margin-left: 10px; outline: none; }

        body.matrix-mode { background-image: url('https://media.giphy.com/media/hzIg4f671gBkA/giphy.gif') !important; background-size: cover; }
        body.matrix-mode * { color: #0f0 !important; border-color: #0f0 !important; text-shadow: 0 0 5px #0f0 !important; }
        body.red-alert-mode { filter: sepia(1) saturate(5) hue-rotate(-50deg) !important; animation: pulse-red 0.5s infinite alternate; }
        @keyframes pulse-red { from { box-shadow: inset 0 0 0 red; } to { box-shadow: inset 0 0 50px red; } }
        body.nuke-mode { animation: flash 0.1s infinite; }
        @keyframes flash { 0% { background: #fff; filter: invert(1); } 50% { background: #000; filter: invert(0); } 100% { background: #fff; } }
    </style>
</head>
