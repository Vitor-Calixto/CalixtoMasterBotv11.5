<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Calixto OmniSystem</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/socket.io/socket.io.js"></script>
    
    <style>
        /* --- TEMA DARK NEON --- */
        :root {
            --bg-color: #050505;
            --card-bg: #0f0f0f;
            --border-color: #222;
            --primary-blue: #0066ff;
            --primary-hover: #0052cc;
            --text-main: #ffffff;
            --text-muted: #888;
            --danger: #ff3333;
            --success: #00e054;
            --warning: #ff9900;
            --primary-purple: #bd00ff;
            --primary-purple-hover: #a000cc;
            --ig-color: #E1306C; /* Cor oficial do Instagram */
        }

        body { background-color: var(--bg-color); color: var(--text-main); font-family: 'Inter', sans-serif; margin: 0; padding: 40px; }

        /* UTILITÁRIOS PARA MANUTENÇÃO (CSS PURO PARA EVITAR ERROS NO VSCODE) */
        .maintenance-banner { background: #ff3333; color: #fff; text-align: center; padding: 5px; font-size: 12px; font-weight: bold; position: fixed; top: 0; left: 0; width: 100%; z-index: 9999; }
        .mt-banner { margin-top: 30px; }
        
        .txt-red { color: #ff3333 !important; }
        .txt-green { color: #00e054 !important; }
        
        .btn-manutencao-on { background: #ff3333 !important; border-color: #ff3333 !important; color: #fff !important; }
        .btn-manutencao-off { background: #111 !important; border-color: #00e054 !important; color: #00e054 !important; }

        /* HEADER */
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; }
        .logo { font-size: 20px; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 10px; }
        .plan-badge { font-size: 11px; background: #1a1a1a; border: 1px solid #333; padding: 3px 10px; border-radius: 4px; color: #666; margin-left: 10px; text-transform: uppercase; letter-spacing: 1px; }

        .btn-new { background-color: var(--primary-blue); color: #fff; border: none; padding: 12px 20px; border-radius: 6px; font-weight: 600; cursor: pointer; transition: 0.2s; font-size: 13px; }
        .btn-new:hover { background-color: var(--primary-hover); }
        .btn-logout { color: #666; text-decoration: none; font-size: 13px; font-weight: 500; margin-right: 20px; }
        .btn-logout:hover { color: #fff; }

        /* GRID */
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 25px; }

        /* CARD */
        .card { background-color: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 20px; display: flex; flex-direction: column; gap: 15px; transition: 0.3s; }
        .card:hover { border-color: #333; transform: translateY(-2px); }

        .card-header { display: flex; justify-content: space-between; align-items: flex-start; }
        .bot-name { font-weight: 600; font-size: 15px; color: #fff; display: flex; align-items: center; gap: 8px; }
        .edit-icon { color: #666; cursor: pointer; font-size: 14px; transition: 0.2s; }
        .edit-icon:hover { color: #fff; }

        /* HEADER CONTROLS */
        .header-controls { display: flex; align-items: center; gap: 15px; }
        .help-btn { background: transparent; border: 1px solid #333; color: #666; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; cursor: pointer; transition: 0.2s; }
        .help-btn:hover { border-color: var(--primary-blue); color: var(--primary-blue); }

        /* CANAIS DE COMUNICAÇÃO (WA / IG) */
        .channel-box { background: #000; border: 1px solid #222; padding: 10px; border-radius: 6px; color: #888; font-family: monospace; font-size: 13px; display: flex; justify-content: space-between; align-items: center; }
        .channel-info { display: flex; align-items: center; gap: 8px; }
        .btn-connect-ig { background: var(--ig-color); color: #fff; border: none; padding: 4px 10px; border-radius: 4px; font-size: 10px; font-weight: bold; cursor: pointer; transition: 0.2s; }
        .btn-connect-ig:hover { filter: brightness(1.2); }
        .btn-disconnect-ig { background: transparent; border: 1px solid var(--ig-color); color: var(--ig-color); padding: 4px 10px; border-radius: 4px; font-size: 10px; font-weight: bold; cursor: pointer; transition: 0.2s; }
        .btn-disconnect-ig:hover { background: rgba(225, 48, 108, 0.1); }

        /* Melhoria visual para o status de conexão */
.channel-status {
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 700;
    text-transform: uppercase;
}
.status-connected { background: rgba(0, 224, 84, 0.1); color: #00e054; border: 1px solid #00e054; }
.status-waiting { background: rgba(255, 153, 0, 0.1); color: #ff9900; border: 1px solid #ff9900; }

/* Badge de Identificação do Canal */
.channel-label {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 600;
}

        /* BOTÕES DO CARD */
        .btn-disparo { flex: 1; background-color: var(--primary-purple); color: #fff; border: none; padding: 12px; border-radius: 6px; font-weight: 600; font-size: 13px; cursor: pointer; display: flex; justify-content: center; align-items: center; gap: 8px; transition: 0.2s; }
        .btn-disparo:hover { background-color: var(--primary-purple-hover); }
        .card-actions { display: flex; gap: 10px; }
        .btn-fluxo { flex: 1; background-color: var(--primary-blue) !important; color: #fff; border: none; padding: 12px; border-radius: 6px; font-weight: 600; font-size: 13px; cursor: pointer; display: flex; justify-content: center; align-items: center; gap: 8px; transition: 0.2s; }
        .btn-fluxo:hover { background-color: var(--primary-hover); }
        .btn-lixo { width: 45px; background-color: #1a1a1a; border: 1px solid #333; color: #666; border-radius: 6px; cursor: pointer; display: flex; justify-content: center; align-items: center; transition: 0.2s; }
        .btn-lixo:hover { background-color: #220000; border-color: #550000; color: #ff4444; }

        /* SWITCH */
        .switch { position: relative; display: inline-block; width: 60px; height: 24px; }
        .switch input { opacity: 0; width: 0; height: 0; }
        .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #222; transition: .4s; border-radius: 4px; }
        .slider:before { position: absolute; content: ""; height: 16px; width: 16px; left: 4px; bottom: 4px; background-color: #666; transition: .4s; border-radius: 2px; z-index: 2; }
        .slider:after { content: 'OFF'; position: absolute; right: 8px; top: 50%; transform: translateY(-50%); font-size: 9px; font-weight: 700; color: #666; font-family: sans-serif; }
        input:checked + .slider { background-color: rgba(0, 224, 84, 0.15); }
        input:checked + .slider:before { transform: translateX(36px); background-color: var(--success); }
        input:checked + .slider:after { content: 'ON'; left: 8px; right: auto; color: var(--success); }
        input:disabled + .slider { opacity: 0.5; cursor: not-allowed; }

        /* Pairing & Help */
        .pairing-box { background: #000; padding: 15px; border: 1px dashed var(--primary-blue); color: var(--primary-blue); font-family: monospace; text-align: center; font-size: 20px; letter-spacing: 3px; display: none; margin-top: 10px; border-radius: 6px; }
        .help-text { font-size: 11px; color: #555; text-align: center; margin-top: 5px; display: none; }

        /* ADMIN AREA */
        .admin-section { margin-top: 80px; padding: 0; border-top: 1px solid #222; padding-top: 40px; }
        .admin-header { font-size: 14px; font-weight: 700; color: #bd00ff; margin-bottom: 20px; text-transform: uppercase; letter-spacing: 1px; display: flex; justify-content: space-between; align-items: center; }
        
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th { text-align: left; padding: 15px 0; color: #666; font-size: 11px; text-transform: uppercase; border-bottom: 1px solid #222; }
        td { padding: 15px 0; border-bottom: 1px solid #111; color: #ccc; vertical-align: middle; }
        
        .status-badge { font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 3px; }
        .st-ativo { color: var(--success); }
        .st-pendente { color: var(--danger); }

        .btn-action-admin { padding: 6px 12px; border-radius: 4px; font-weight: 700; font-size: 10px; cursor: pointer; text-transform: uppercase; border: none; }
        .bg-orange { background: #ff9900; color: #000; }
        .bg-green { background: #00e054; color: #000; }
        .bg-outline { background: transparent; border: 1px solid #333; color: #666; width: 30px; display: flex; align-items: center; justify-content: center; }
        .bg-outline:hover { border-color: #ff3333; color: #ff3333; }
        
        .btn-renova { background: #111; border: 1px solid #333; color: #fff; padding: 6px 12px; cursor: pointer; font-size: 11px; border-radius: 4px; transition: 0.2s; }
        .btn-renova:hover { border-color: var(--primary-blue); color: var(--primary-blue); }

        .bot-badge-container { position: relative; display: inline-block; cursor: pointer; }
        .bot-badge { background: #1a1a1a; color: #fff; padding: 4px 10px; border-radius: 4px; font-size: 11px; border: 1px solid #333; font-weight: 600; display: inline-flex; align-items: center; gap: 5px; }
        .bot-tooltip-content { visibility: hidden; position: absolute; bottom: 120%; left: 50%; transform: translateX(-50%); background: #000; border: 1px solid #333; padding: 10px; border-radius: 6px; width: max-content; min-width: 150px; z-index: 10; opacity: 0; transition: 0.2s; box-shadow: 0 10px 30px rgba(0,0,0,0.8); pointer-events: none; }
        .bot-badge-container:hover .bot-tooltip-content { visibility: visible; opacity: 1; bottom: 130%; }
        .tooltip-row { display: flex; align-items: center; gap: 8px; font-size: 11px; color: #ccc; margin-bottom: 5px; }
        .tooltip-row:last-child { margin-bottom: 0; }
        .status-dot { width: 6px; height: 6px; border-radius: 50%; }
        
        /* Personalização do SweetAlert para Dark Mode */
        .swal2-popup { background: #111 !important; border: 1px solid #333 !important; }
        .swal2-title, .swal2-html-container { color: #fff !important; }
    </style>
</head>
<body>

    <% if (typeof systemMaintenance !== 'undefined' && systemMaintenance) { %>
        <div class="maintenance-banner">
            ⚠️ MODO MANUTENÇÃO ATIVO - CLIENTES ESTÃO BLOQUEADOS
        </div>
    <% } %>

    <div class="header <%= (typeof systemMaintenance !== 'undefined' && systemMaintenance) ? 'mt-banner' : '' %>">
        <div class="logo">
            <i class="ri-dashboard-3-line"></i> Calixto OmniSystem 
            <% if (usuario) { %> <span class="plan-badge"><%= usuario.plano %></span> <% } %>
        </div>
    
        <div style="display: flex; gap: 15px; align-items: center;">
            <a href="/dashboard/agenda" style="text-decoration: none; color: #ccc; font-size: 13px; display: flex; align-items: center; gap: 5px; transition: 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#ccc'">
                <i class="ri-calendar-todo-line"></i> Minha agenda
            </a>
    
            <a href="/dashboard/contratos" style="text-decoration: none; color: #ccc; font-size: 13px; display: flex; align-items: center; gap: 5px; transition: 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#ccc'">
                <i class="ri-file-text-line"></i> Meus Contratos
            </a>
    
            <span style="color: #333;">|</span>
            <a href="/logout" class="btn-logout">Sair</a>
            <button class="btn-new" onclick="novoBot()">+ Novo Cliente</button>
        </div>
    </div>

    <div class="grid">
        <% if (typeof clientes !== 'undefined' && clientes.length > 0) { %>
            <% clientes.forEach(c => { %>
                <div class="card">
                    <!-- Cabeçalho do Card -->
                    <div class="card-header">
                        <div class="bot-name">
                            <%= c.nome %> 
                            <i class="ri-pencil-fill edit-icon" onclick="editarBot('<%= c.id %>', '<%= c.nome %>', '<%= c.numero %>')"></i>
                        </div>
                        
                        <div class="header-controls">
                            <div class="help-btn" onclick="showHelp()" title="Ajuda de Conexão">
                                <i class="ri-question-line"></i>
                            </div>
                            
                            <!-- Switch Universal (Agora visível para Instagram e WhatsApp) -->
                            <label class="switch">
                                <input type="checkbox" id="check-<%= c.id %>" <%= c.status === 'ONLINE' ? 'checked' : '' %> onchange="toggleBot('<%= c.id %>', this)">
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
    
                    <!-- Conteúdo por Plataforma -->
                    <% if (c.plataforma === 'INSTAGRAM') { %>
                        <!-- Box Instagram -->
                        <div class="channel-box" style="margin-bottom: 5px; border: 1px solid var(--border-color); padding: 10px; border-radius: 6px; background: #0a0a0a; display: flex; justify-content: space-between; align-items: center;">
                            <div class="channel-info" style="display: flex; align-items: center; gap: 8px;">
                                <i class="ri-instagram-line" style="color: var(--primary-purple); font-size: 16px;"></i>
                                <span style="font-size: 12px; font-weight: 600; color: #fff;">Instagram</span>
                                <span style="font-size: 11px; color: #888; margin-left: 5px;"><%= c.numero || 'Aguardando...' %></span>
                            </div>
                            
                            <div>
                                <% if (c.status === 'ONLINE') { %>
                                    <span style="font-size: 10px; color: var(--success); border: 1px solid var(--success); padding: 2px 5px; border-radius: 3px; margin-right: 5px;">ATIVO</span>
                                    <button onclick="toggleBot('<%= c.id %>', 'OFFLINE')" style="background: transparent; border: 1px solid var(--danger); color: var(--danger); font-size: 10px; padding: 4px 8px; border-radius: 4px; cursor: pointer; transition: 0.2s;">
                                        SAIR
                                    </button>
                                <% } else { %>
                                    <span style="font-size: 10px; color: var(--warning); border: 1px solid var(--warning); padding: 2px 5px; border-radius: 3px; margin-right: 5px;">OFF</span>
                                    <button onclick="window.location.href='/instagram/setup?clienteId=<%= c.id %>'" style="background: var(--primary-purple); border: none; color: #fff; font-size: 10px; padding: 4px 8px; border-radius: 4px; cursor: pointer; transition: 0.2s;">
                                        CONECTAR
                                    </button>
                                <% } %>
                            </div>
                        </div>
                    <% } else { %>
                        <!-- Box WhatsApp -->
                        <div class="channel-box" style="margin-bottom: 5px; border: 1px solid #222; padding: 10px; border-radius: 6px; background: #000;">
                            <div class="channel-info" style="display: flex; align-items: center; gap: 8px;">
                                <i class="ri-whatsapp-line" style="color: #00e054; font-size: 16px;"></i>
                                <span style="font-size: 12px; font-weight: 600; color: #fff;">WhatsApp</span>
                                <span style="font-size: 11px; color: #888; margin-left: 5px;"><%= c.numero || 'Sem número' %></span>
                            </div>
                        </div>
                        <div id="pairing-box-<%= c.id %>" class="pairing-box"></div>
                        <div id="help-text-<%= c.id %>" class="help-text">WhatsApp > Aparelhos > Conectar</div>
                    <% } %>
    
                    <!-- Ações do Card -->
                    <div class="card-actions" style="margin-top: 15px;">
                        <button class="btn-disparo" onclick="window.location.href='/disparo/<%= c.id %>'">
                            <i class="ri-megaphone-line"></i> Disparo
                        </button>
                        <button class="btn-fluxo" onclick="window.location.href='/editor/<%= c.id %>'">
                            <i class="ri-settings-4-line"></i> Editar Fluxo
                        </button>
                        <button class="btn-lixo" onclick="excluirBot('<%= c.id %>')">
                            <i class="ri-delete-bin-line"></i>
                        </button>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <!-- Estado Vazio -->
            <div style="grid-column: 1/-1; text-align: center; color: #444; padding: 60px; border: 1px dashed #333; border-radius: 8px;">
                <i class="ri-robot-line" style="font-size: 40px; margin-bottom: 10px;"></i><br>
                Nenhum bot criado.
            </div>
        <% } %>
    </div>

    <% if (usuario && usuario.email === 'vitorpedrocalixto@gmail.com') { %> 
        <div class="admin-section">
            
            <div style="background: rgba(255, 153, 0, 0.05); border: 1px solid #333; border-left: 3px solid #ff9900; padding: 20px; border-radius: 8px; margin-bottom: 40px; display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; align-items: center; gap: 15px;">
                    <div style="background: #ff9900; color: #000; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                        <i class="ri-lock-2-line"></i>
                    </div>
                    <div>
                        <h4 style="color: #fff; margin: 0 0 5px 0; font-size: 14px;">MODO MANUTENÇÃO</h4>
                        <div style="font-size: 12px; color: #888;">
                            Status atual: 
                            <strong class="<%= (typeof systemMaintenance !== 'undefined' && systemMaintenance) ? 'txt-red' : 'txt-green' %>">
                                <%= (typeof systemMaintenance !== 'undefined' && systemMaintenance) ? 'ATIVADO (Site Bloqueado)' : 'DESATIVADO (Site Online)' %>
                            </strong>
                        </div>
                    </div>
                </div>
                <button onclick="toggleMaintenance()" id="btnMaintenance" 
                    class="<%= (typeof systemMaintenance !== 'undefined' && systemMaintenance) ? 'btn-manutencao-on' : 'btn-manutencao-off' %>"
                    style="padding: 10px 25px; border-radius: 6px; cursor: pointer; font-weight: 700; font-size: 11px; transition: 0.2s; text-transform: uppercase; border: 1px solid;">
                    <%= (typeof systemMaintenance !== 'undefined' && systemMaintenance) ? 'DESATIVAR BLOQUEIO' : 'ATIVAR MANUTENÇÃO' %>
                </button>
            </div>

            <div class="admin-header">
                <div><i class="ri-shield-user-line"></i> Gestão de Usuários</div>
                <button onclick="carregarUsuarios()" style="background:transparent; border:1px solid #333; color:#666; padding:5px 10px; border-radius:4px; cursor:pointer; font-size:11px;">ATUALIZAR</button>
            </div>
            <div id="tabela-admin"><p style="color:#444;">Carregando...</p></div>
        </div>

        <script>
            // --- SCRIPT DO ADMIN (MANTIDO INTACTO) ---
            async function toggleMaintenance() {
                const btn = document.getElementById('btnMaintenance');
                const isMaintenance = btn.innerText.includes('DESATIVAR');
                
                if(!isMaintenance && !confirm('⚠️ PERIGO: Ao ativar a manutenção, TODOS os clientes serão bloqueados de acessar o site (exceto você). Tem certeza?')) return;
                
                const originalText = btn.innerText;
                btn.innerText = 'Processando...';
                btn.disabled = true;
                
                try {
                    const res = await fetch('/api/admin/maintenance', { method: 'POST' });
                    const data = await res.json();
                    if(data.success) {
                        location.reload();
                    } else {
                        alert('Erro ao alterar status.');
                        btn.innerText = originalText;
                        btn.disabled = false;
                    }
                } catch(e) {
                    alert('Erro de conexão.');
                    btn.innerText = originalText;
                    btn.disabled = false;
                }
            }

            async function carregarUsuarios() {
                try {
                    const res = await fetch('/api/admin/usuarios');
                    if (res.headers.get("content-type").indexOf("json") === -1) { window.location.href = '/login'; return; }
                    const users = await res.json();
                    
                    let html = `<table><thead><tr>
                        <th>Usuário</th>
                        <th>Plano</th>
                        <th>Bots</th>
                        <th>Validade</th>
                        <th>Status</th>
                        <th>Jurídico (Termos)</th> 
                        <th>Ações</th>
                    </tr></thead><tbody>`;

                    users.forEach(u => {
                        if (u.email === 'vitorpedrocalixto@gmail.com') return;

                        let botsData = u.clientes || u.bots || [];
                        let botsHtml = `<span style="color:#444; font-size:11px;">Nenhum</span>`;
                        
                        if (botsData.length > 0) {
                            let tooltipContent = botsData.map(b => `
                                <div class="tooltip-row">
                                    <div class="status-dot" style="background:${b.status==='ONLINE'?'#00e054':'#444'}"></div>
                                    ${b.nome}
                                </div>
                            `).join('');

                            botsHtml = `
                                <div class="bot-badge-container">
                                    <span class="bot-badge">
                                        <i class="ri-robot-2-line"></i> ${botsData.length} Bots
                                    </span>
                                    <div class="bot-tooltip-content">
                                        ${tooltipContent}
                                    </div>
                                </div>
                            `;
                        }

                        let dataFormatada = "Indefinido";
                        let corData = "#666";
                        if (u.expiraEm) {
                            const data = new Date(u.expiraEm);
                            const hoje = new Date();
                            const dias = Math.ceil((data - hoje) / (1000 * 60 * 60 * 24));
                            dataFormatada = data.toLocaleDateString('pt-BR');
                            if (dias < 0) { dataFormatada += ` <br><span style="color:#ff3333; font-weight:bold; font-size:10px;">(VENCIDO)</span>`; corData = "#ff3333"; } 
                            else { dataFormatada += ` <br><span style="color:#00e054; font-size:10px;">(${dias} dias)</span>`; }
                        }

                        let juridicoHtml = '';
                        if (u.termsAccepted) {
                            const dataAceite = u.termsAcceptedAt ? new Date(u.termsAcceptedAt).toLocaleDateString('pt-BR') + ' ' + new Date(u.termsAcceptedAt).toLocaleTimeString('pt-BR', {hour:'2-digit', minute:'2-digit'}) : 'N/A';
                            juridicoHtml = `
                                <div style="line-height: 1.4;">
                                    <span style="color: #00ff88; font-weight: bold; font-size: 12px;">✅ ACEITO</span><br>
                                    <span style="color: #aaa; font-size: 11px; font-family:monospace;">
                                        📅 ${dataAceite}<br>
                                        🌐 IP: <span style="color: #fff;">${u.signupIp || '?'}</span>
                                    </span>
                                </div>
                            `;
                        } else {
                            juridicoHtml = `<span style="color: #ffaa00; font-size: 11px;">⚠️ Pendente (Antigo)</span>`;
                        }

                        let btnStatus = '';
                        if (!u.ativo) {
                            btnStatus = `<button class="btn-action-admin bg-green" onclick="aprovar('${u.id}')">APROVAR</button>`;
                        } else {
                            btnStatus = `<button class="btn-action-admin bg-orange" onclick="bloquear('${u.id}', ${!u.bloqueado})">
                                ${u.bloqueado ? 'LIBERAR' : 'BLOQUEAR'}
                            </button>`;
                        }

                        html += `<tr style="border-bottom:1px solid #1a1a1a;">
                            <td onclick="toggleDetalhes('${u.id}')" style="cursor:pointer;">
                                <div style="color:#fff; font-weight:600; display:flex; align-items:center; gap:5px;">
                                    <i id="icon-${u.id}" class="ri-arrow-right-s-line"></i> ${u.nome}
                                </div>
                                <div style="color:#666; font-size:11px; margin-left:18px;">${u.email}</div>
                            </td>
                            <td><span class="plan-badge" style="margin:0;">${u.plano}</span></td>
                            <td>${botsHtml}</td>
                            <td style="color:${corData}; font-size:12px;">${dataFormatada}</td>
                            <td><span class="status-badge ${u.ativo ? 'st-ativo' : 'st-pendente'}">${u.ativo ? 'ATIVO' : 'PENDENTE'}</span></td>
                            
                            <td>${juridicoHtml}</td>
                            
                            <td>
                                <div style="display:flex; gap:5px;">
                                    ${btnStatus}
                                    <button class="btn-action-admin bg-outline" onclick="excluirUser('${u.id}')" title="Excluir"><i class="ri-delete-bin-line"></i></button>
                                </div>
                            </td>
                        </tr>
                        <tr id="detalhe-${u.id}" style="display:none; background:#0a0a0a;">
                            <td colspan="7" style="padding:20px; border-left:2px solid var(--primary-blue);">
                                <h4 style="color:#fff; font-size:11px; margin-bottom:10px;">RENOVAR ACESSO RÁPIDO</h4>
                                <div style="display:flex; gap:5px; align-items:center;">
                                    <button class="btn-renova" onclick="renovarAcesso('${u.id}', 7)">+7d</button>
                                    <button class="btn-renova" onclick="renovarAcesso('${u.id}', 30)">+30d</button>
                                    <button class="btn-renova" onclick="renovarAcesso('${u.id}', 365)">+1 Ano</button>
                                    <button class="btn-renova" onclick="renovarAcesso('${u.id}', 9999)" style="border-color:#00e054; color:#00e054;">Vitalício</button>
                                    <span style="margin:0 10px; color:#444;">|</span>
                                    <input type="date" id="date-${u.id}" style="background:#111; border:1px solid #333; color:#fff; padding:4px; border-radius:4px;">
                                    <button class="btn-renova" onclick="definirData('${u.id}')">OK</button>
                                </div>
                            </td>
                        </tr>`;
                    });
                    document.getElementById('tabela-admin').innerHTML = html + '</tbody></table>';
                } catch(e){}
            }

            function toggleDetalhes(id) {
                const row = document.getElementById(`detalhe-${id}`);
                const icon = document.getElementById(`icon-${id}`);
                if (row.style.display === 'none') {
                    row.style.display = 'table-row';
                    icon.className = 'ri-arrow-down-s-line';
                } else {
                    row.style.display = 'none';
                    icon.className = 'ri-arrow-right-s-line';
                }
            }

            async function renovarAcesso(id, dias) {
                const payload = dias === 9999 ? { idUsuario: id, vitalicio: true } : { idUsuario: id, diasAdicionais: dias };
                await fetch('/api/admin/usuarios/renovar', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload) });
                carregarUsuarios();
                Swal.fire({icon:'success', title:'Renovado!', toast:true, position:'top-end', showConfirmButton:false, timer:1500, background:'#111', color:'#fff'});
            }

            async function definirData(id) {
                const dateInput = document.getElementById(`date-${id}`).value;
                if (!dateInput) return;
                await fetch('/api/admin/usuarios/definir-data', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ idUsuario: id, novaData: dateInput }) });
                carregarUsuarios();
            }

            async function aprovar(id) { await fetch('/api/admin/aprovar', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({idUsuario:id})}); carregarUsuarios(); }
            
            async function bloquear(id, s) { 
                await fetch('/api/admin/usuarios/bloqueio', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({idUsuario:id, bloquear:s})}); 
                carregarUsuarios(); 
            }

            async function excluirUser(id) {
                if((await Swal.fire({ title:'Tem certeza?', text:'Apagará tudo deste usuário.', icon:'warning', showCancelButton:true, confirmButtonColor:'#d33', background:'#111', color:'#fff' })).isConfirmed) {
                    await fetch(`/api/admin/usuarios/${id}`, { method: 'DELETE' });
                    carregarUsuarios();
                }
            }
            
            document.addEventListener('DOMContentLoaded', carregarUsuarios);
        </script>
    <% } %>

    <script>
        const socket = io();
        const swalDark = Swal.mixin({ background: '#111', color: '#fff', confirmButtonColor: '#0066ff', cancelButtonColor: '#333' });

        socket.on('pairingCode', (data) => {
            const box = document.getElementById(`pairing-box-${data.clienteId}`);
            const help = document.getElementById(`help-text-${data.clienteId}`);
            if(box) { 
                box.style.display = 'block'; 
                box.innerText = data.code; 
                if(help) help.style.display = 'block'; 
            }
        });

        socket.on('status', (data) => { 
            if(data.status === 'ONLINE') {
                const check = document.getElementById(`check-${data.clienteId}`);
                if(check) check.checked = true;
            }
        });
        
        function showHelp() {
            swalDark.fire({
                title: 'CENTRAL DE AJUDA',
                width: 600,
                html: `
                    <div style="text-align:left; font-size:13px; color:#ccc; line-height:1.5;">
                        <h4 style="color:#0066ff; margin-bottom:10px; text-transform:uppercase;">📶 Problemas de Conexão</h4>
                        <ul style="margin-bottom:15px; padding-left:15px;">
                            <li><strong>Dica de Ouro:</strong> Desligue o Wi-Fi e use <strong>4G/5G</strong> para ler o QR Code (evita bloqueio de IP).</li>
                            <li>Verifique no WhatsApp em <em>"Aparelhos Conectados"</em> e desconecte sessões antigas.</li>
                        </ul>
                        <h4 style="color:#ffbb00; margin-bottom:10px; text-transform:uppercase;">🛡️ Evite Bloqueios</h4>
                        <ul style="margin-bottom:15px; padding-left:15px;">
                            <li>Use WhatsApp Business.</li>
                            <li>Se o chip for novo, use manualmente por 3 dias antes de botar no robô.</li>
                        </ul>
                    </div>
                `,
                confirmButtonText: 'Entendi!'
            });
        }

        async function novoBot() {
    const { value: form } = await swalDark.fire({
        title: 'Novo Cliente',
        width: 500, // Deixa o modal um pouco mais largo para acomodar os inputs
        html: `
            <style>
                .swal-custom-container { text-align: left; padding: 0 5px; margin-top: 15px; }
                
                /* Toggles de Seleção */
                .platform-selector { display: flex; gap: 10px; justify-content: center; margin-bottom: 25px; }
                .platform-btn { flex: 1; padding: 12px; border: 1px solid #333; background: #0a0a0a; color: #666; border-radius: 8px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: 0.3s; font-weight: 600; font-size: 14px; }
                .platform-btn:hover { background: #111; border-color: #555; }
                
                /* Cores Ativas */
                .platform-btn.active-wpp { background: rgba(0, 224, 84, 0.1); border-color: #00e054; color: #00e054; }
                .platform-btn.active-insta { background: rgba(189, 0, 255, 0.1); border-color: var(--primary-purple); color: var(--primary-purple); }
                
                /* Inputs com Ícone Embutido */
                .input-group { display: flex; align-items: stretch; background: #111; border: 1px solid #333; border-radius: 8px; overflow: hidden; margin-bottom: 15px; width: 100%; transition: 0.3s; }
                .input-group:focus-within { border-color: var(--primary-blue); }
                .input-icon { width: 50px; font-size: 20px; background: #0a0a0a; border-right: 1px solid #333; display: flex; align-items: center; justify-content: center; transition: 0.3s; }
                .custom-input { flex: 1; background: transparent; border: none; color: #fff; padding: 15px; outline: none; font-size: 14px; font-family: 'Inter', sans-serif; }
                .custom-input::placeholder { color: #555; }
            </style>
            
            <div class="swal-custom-container">
                <div class="platform-selector">
                    <div id="btn-wpp" class="platform-btn active-wpp"><i class="ri-whatsapp-line" style="font-size: 18px;"></i> WhatsApp</div>
                    <div id="btn-insta" class="platform-btn"><i class="ri-instagram-line" style="font-size: 18px;"></i> Instagram</div>
                </div>
                
                <input type="hidden" id="plataforma" value="WHATSAPP">
                
                <div class="input-group">
                    <div class="input-icon"><i class="ri-robot-2-line" style="color: #888;"></i></div>
                    <input id="nome" class="custom-input" placeholder="Nome do Bot (Ex: Suporte, Vendas...)">
                </div>

                <div class="input-group">
                    <div id="dynamic-icon" class="input-icon"><i class="ri-whatsapp-line" style="color: #00e054;"></i></div>
                    <input id="num" class="custom-input" type="text" placeholder="Número (Ex: 5511999999999)">
                </div>
            </div>
        `,
        didOpen: () => {
            // Lógica que roda assim que o modal abre (para fazer a troca dinâmica)
            const btnWpp = document.getElementById('btn-wpp');
            const btnInsta = document.getElementById('btn-insta');
            const inputPlataforma = document.getElementById('plataforma');
            const icon = document.getElementById('dynamic-icon');
            const inputNum = document.getElementById('num');

            btnWpp.addEventListener('click', () => {
                inputPlataforma.value = 'WHATSAPP';
                btnWpp.classList.add('active-wpp');
                btnInsta.classList.remove('active-insta');
                icon.innerHTML = '<i class="ri-whatsapp-line" style="color: #00e054;"></i>';
                inputNum.placeholder = 'Número (Ex: 5511999999999)';
            });

            btnInsta.addEventListener('click', () => {
                inputPlataforma.value = 'INSTAGRAM';
                btnInsta.classList.add('active-insta');
                btnWpp.classList.remove('active-wpp');
                icon.innerHTML = '<i class="ri-instagram-line" style="color: var(--primary-purple);"></i>';
                inputNum.placeholder = 'Username (Ex: @calixto.dev)';
            });
        },
        preConfirm: () => {
            const nome = document.getElementById('nome').value.trim();
            const num = document.getElementById('num').value.trim();
            const plat = document.getElementById('plataforma').value;
            
            // Validação para não criar bot vazio
            if (!nome || !num) {
                Swal.showValidationMessage('Por favor, preencha o nome e o contato!');
                return false;
            }
            return [nome, num, plat];
        }
    });

    if (form) {
        // Envia para o Backend
        const res = await fetch('/api/clientes', { 
            method: 'POST', 
            headers: {'Content-Type': 'application/json'}, 
            body: JSON.stringify({ nome: form[0], numero: form[1], plataforma: form[2] }) 
        });
        
        const data = await res.json();
        if (data.success) {
            swalDark.fire({ 
                title: 'Bot Criado!', 
                text: 'Deseja configurar o fluxo de automação agora?', 
                icon: 'success', 
                showCancelButton: true, 
                confirmButtonText: 'Editar Fluxo',
                cancelButtonText: 'Mais Tarde',
                confirmButtonColor: '#0066ff'
            }).then((r) => {
                if (r.isConfirmed) window.location.href = '/editor/' + data.id; 
                else window.location.reload();
            });
        } else {
            swalDark.fire('Erro', data.error || 'Erro ao criar o cliente.', 'error');
        }
    }
}



        async function editarBot(id, nome, num, igUser) {
    const { value: form } = await swalDark.fire({
        title: 'Editar Cliente',
        html: `
            <div style="text-align: left; font-size: 12px; color: #888; margin-bottom: 5px;">Nome do Projeto:</div>
            <input id="ed-nome" class="swal2-input" placeholder="Nome" value="${nome}" style="margin-top: 0;">
            
            <div style="text-align: left; font-size: 12px; color: #00e054; margin-top: 15px; margin-bottom: 5px;">WhatsApp:</div>
            <input id="ed-num" class="swal2-input" placeholder="5521999999999" value="${num}" type="number" style="margin-top: 0;">
            
            <div style="text-align: left; font-size: 12px; color: #E1306C; margin-top: 15px; margin-bottom: 5px;">@ do Instagram (Visual):</div>
            <input id="ed-ig" class="swal2-input" placeholder="usuario_do_insta" value="${igUser === 'null' || !igUser ? '' : igUser}" style="margin-top: 0;">
        `,
        preConfirm: () => [
            document.getElementById('ed-nome').value,
            document.getElementById('ed-num').value,
            document.getElementById('ed-ig').value
        ]
    });
    
    if(form) {
        await fetch(`/api/clientes/${id}`, { 
            method: 'PUT', 
            headers: {'Content-Type': 'application/json'}, 
            body: JSON.stringify({ 
                nome: form[0], 
                numero: form[1],
                instagramUser: form[2]
            }) 
        });
        location.reload();
    }
}


async function excluirBot(id) {
    // 1. O console do navegador vai avisar se o clique funcionou
    console.log("🗑️ Botão excluir clicado! ID do Bot:", id); 

    try {
        // 2. Chama a caixa de confirmação
        const confirmacao = await swalDark.fire({ 
            title: 'Excluir Cliente?', 
            text: 'Isso apagará o bot, os contratos e os lembretes atrelados a ele. Não tem volta.', 
            icon: 'warning', 
            showCancelButton: true, 
            confirmButtonColor: '#ff3333',
            cancelButtonColor: '#333',
            confirmButtonText: 'Sim, excluir!',
            cancelButtonText: 'Cancelar'
        });

        if (confirmacao.isConfirmed) {
            console.log("⏳ Enviando ordem de exclusão para o servidor...");
            
            // 3. Faz o pedido de exclusão para a rota que arrumamos
            const resposta = await fetch(`/api/clientes/${id}`, { method: 'DELETE' });
            const dados = await resposta.json();

            // 4. Analisa a resposta
            if (dados.success) {
                await swalDark.fire({
                    title: 'Excluído!', 
                    text: 'O bot foi apagado com sucesso.', 
                    icon: 'success',
                    timer: 1500,
                    showConfirmButton: false
                });
                window.location.reload();
            } else {
                console.error("❌ O servidor recusou a exclusão:", dados);
                swalDark.fire('Erro no Servidor', dados.error || 'Falha ao excluir o bot.', 'error');
            }
        }
    } catch (erro) {
        // Se o JavaScript do navegador quebrar, ele cai aqui
        console.error("❌ Erro no código do navegador:", erro);
        alert("Ocorreu um erro interno no seu navegador. Aperte F12 e olhe a aba Console.");
    }
}


async function toggleBot(id, elementoOuStatus) {
    // Se recebeu uma String ('ONLINE' ou 'OFFLINE'), é o Instagram. Se não, é o Checkbox do WhatsApp.
    const status = typeof elementoOuStatus === 'string' ? elementoOuStatus : (elementoOuStatus.checked ? 'ONLINE' : 'OFFLINE');
    
    // Se for o checkbox do Wpp, bloqueia ele temporariamente para evitar cliques duplos
    if (typeof elementoOuStatus !== 'string') {
        elementoOuStatus.disabled = true;
        const box = document.getElementById(`pairing-box-${id}`);
        if(box && status === 'ONLINE') { box.style.display = 'block'; box.innerText = "Conectando..."; }
    }

    try {
        const res = await fetch('/api/status', { 
            method: 'POST', 
            headers: {'Content-Type': 'application/json'}, 
            body: JSON.stringify({ clienteId: id, status }) 
        });
        
        const data = await res.json();
        
        if (data.success) {
            // Sucesso! Recarrega a tela suavemente para atualizar os botões e cores
            setTimeout(() => { window.location.reload(); }, 600);
        } else {
            throw new Error("Falha na resposta");
        }
    } catch (e) {
        if (typeof elementoOuStatus !== 'string') elementoOuStatus.checked = !elementoOuStatus.checked;
        swalDark.fire('Erro', 'Falha ao tentar mudar o status.', 'error');
    }

    if (typeof elementoOuStatus !== 'string') {
        setTimeout(() => { elementoOuStatus.disabled = false; }, 3000);
    }
}
