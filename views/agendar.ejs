<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <title><%= negocio ? 'Agendar com ' + negocio : 'Agendar horário' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <style>
        :root { --tinta: #16211c; --tinta-2: #4b5a53; --tinta-3: #7a8a82; --fundo: #f5f7f4; --papel: #fff; --linha: #dfe5e0; --floresta: #0e3b2e; --acao: #128c6b; --acao-hover: #0e7458; --menta: #dff3ea; --erro: #b42318; --erro-fundo: #fef3f2; }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { min-height: 100vh; background: var(--fundo); color: var(--tinta); font: 16px/1.5 'Instrument Sans', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
        button { font: inherit; color: inherit; }
        :focus-visible { outline: 3px solid var(--acao); outline-offset: 2px; border-radius: 6px; }
        .pagina { max-width: 920px; margin: 0 auto; padding: 28px 16px 300px; }
        .topo { display: flex; gap: 14px; align-items: center; margin-bottom: 22px; }
        .avatar { width: 52px; height: 52px; border-radius: 16px; background: var(--floresta); color: #fff; display: grid; place-items: center; font: 800 22px 'Bricolage Grotesque', sans-serif; flex: none; }
        h1 { font: 800 clamp(24px, 5vw, 32px)/1.1 'Bricolage Grotesque', sans-serif; letter-spacing: -.6px; }
        .meta { color: var(--tinta-2); font-size: 14.5px; margin-top: 4px; display: flex; flex-wrap: wrap; gap: 4px 14px; }
        .meta span { display: inline-flex; gap: 5px; align-items: center; }
        .painel { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); background: var(--papel); border: 1px solid var(--linha); border-radius: 20px; overflow: hidden; }
        .lado { padding: 22px; }
        .lado + .lado { border-left: 1px solid var(--linha); }
        h2 { font: 700 18px 'Bricolage Grotesque', sans-serif; letter-spacing: -.2px; }

        .mes-topo { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
        .mes-topo h2 { text-transform: capitalize; }
        .seta { width: 38px; height: 38px; border-radius: 50%; border: 0; background: transparent; cursor: pointer; font-size: 22px; color: var(--tinta-2); display: grid; place-items: center; }
        .seta:hover:not(:disabled) { background: var(--fundo); }
        .seta:disabled { opacity: .3; cursor: default; }
        .semana, .dias { display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; }
        .semana span { font-size: 12.5px; font-weight: 600; color: var(--tinta-3); padding: 6px 0; }
        .dia { aspect-ratio: 1; max-height: 52px; margin: 2px; border: 0; border-radius: 50%; background: transparent; font-weight: 500; color: var(--tinta-3); position: relative; cursor: default; }
        .dia.livre { color: var(--floresta); font-weight: 700; background: var(--menta); cursor: pointer; }
        .dia.livre:hover { background: #c9ebdc; }
        .dia.hoje::after { content: ''; position: absolute; left: 50%; bottom: 6px; width: 4px; height: 4px; margin-left: -2px; border-radius: 50%; background: currentColor; }
        .dia.escolhido, .dia.escolhido:hover { background: var(--acao); color: #fff; }

        .horas-topo { margin-bottom: 14px; }
        .horas-topo p { color: var(--tinta-3); font-size: 14px; }
        .periodo { font-size: 13px; font-weight: 600; color: var(--tinta-3); margin: 14px 0 8px; }
        .periodo:first-of-type { margin-top: 0; }
        .grade { display: grid; grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); gap: 8px; }
        .hora { padding: 11px 6px; border: 1.5px solid var(--linha); border-radius: 12px; background: #fff; font-weight: 600; cursor: pointer; font-variant-numeric: tabular-nums; }
        .hora:hover { border-color: var(--acao); color: var(--acao); }
        .hora[aria-pressed="true"] { background: var(--acao); border-color: var(--acao); color: #fff; }
        .vazio { color: var(--tinta-3); text-align: center; padding: 40px 10px; }
        .vazio i { font-size: 30px; display: block; margin-bottom: 6px; }
        .carregando { display: grid; gap: 8px; grid-template-columns: repeat(3, 1fr); }
        .carregando span { height: 44px; border-radius: 12px; background: linear-gradient(90deg, #eef1ee, #f7f9f7, #eef1ee); background-size: 200% 100%; animation: brilho 1.2s infinite; }
        @keyframes brilho { to { background-position: -200% 0; } }

        .confirmar { position: fixed; left: 0; right: 0; bottom: 0; background: var(--papel); border-top: 1px solid var(--linha); box-shadow: 0 -10px 30px rgba(14, 59, 46, .08); transform: translateY(110%); transition: transform .25s ease; z-index: 5; }
        .confirmar.aberto { transform: none; }
        .confirmar form { max-width: 920px; margin: 0 auto; padding: 16px; display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; }
        .escolha { flex: 1 1 220px; }
        .escolha small { color: var(--tinta-3); font-size: 13px; }
        .escolha b { display: block; font: 700 18px 'Bricolage Grotesque', sans-serif; }
        .campo { flex: 1 1 220px; }
        .campo label { display: block; font-size: 13.5px; font-weight: 600; margin-bottom: 4px; }
        .campo input { width: 100%; padding: 12px 14px; border: 1.5px solid var(--linha); border-radius: 12px; font: inherit; }
        .campo input:focus { outline: none; border-color: var(--acao); box-shadow: 0 0 0 3px rgba(18, 140, 107, .15); }
        .btn { padding: 13px 22px; border: 0; border-radius: 999px; background: var(--acao); color: #fff; font-weight: 600; cursor: pointer; display: inline-flex; gap: 8px; align-items: center; justify-content: center; text-decoration: none; }
        .btn:hover { background: var(--acao-hover); }
        .btn:disabled { opacity: .6; cursor: wait; }
        .erro { width: 100%; background: var(--erro-fundo); color: var(--erro); border-radius: 10px; padding: 10px 12px; font-size: 14px; }

        .final { max-width: 460px; margin: 8vh auto 0; background: var(--papel); border: 1px solid var(--linha); border-radius: 20px; padding: 34px 28px; text-align: center; }
        .final .icone { width: 64px; height: 64px; border-radius: 50%; margin: 0 auto 16px; display: grid; place-items: center; font-size: 34px; background: var(--menta); color: var(--acao); }
        .final.ruim .icone { background: var(--erro-fundo); color: var(--erro); }
        .final h1 { font-size: 26px; margin-bottom: 8px; }
        .final p { color: var(--tinta-2); margin-bottom: 20px; }
        .final .quando { font: 700 19px 'Bricolage Grotesque', sans-serif; color: var(--tinta); margin-bottom: 6px; }
        @media (max-width: 760px) {
            .painel { grid-template-columns: 1fr; }
            .lado + .lado { border-left: 0; border-top: 1px solid var(--linha); }
            .lado { padding: 18px 14px; }
        }
        @media (prefers-reduced-motion: reduce) { .confirmar { transition: none; } .carregando span { animation: none; } }
    </style>
</head>
<body>
<% if (estado !== 'ok') { %>
    <div class="pagina">
        <div class="final ruim">
            <div class="icone" aria-hidden="true"><i class="ri-time-line"></i></div>
            <h1><%= estado === 'expirado' ? 'Este link expirou' : 'Link inválido' %></h1>
            <p>Volte para a conversa e peça um novo link de agendamento. Ele vale por 48 horas.</p>
        </div>
    </div>
<% } else { %>
    <div class="pagina" id="tela-escolha">
        <header class="topo">
            <div class="avatar" aria-hidden="true"><%= (negocio || '?').trim().charAt(0).toUpperCase() %></div>
            <div>
                <h1><%= negocio %></h1>
                <div class="meta"><span><i class="ri-time-line" aria-hidden="true"></i> <span id="duracao">Atendimento</span></span><span><i class="ri-calendar-line" aria-hidden="true"></i> <%= resumo %></span></div>
            </div>
        </header>

        <section class="painel" aria-label="Escolha do horário">
            <div class="lado">
                <div class="mes-topo">
                    <button class="seta" id="mes-ant" type="button" aria-label="Mês anterior"><i class="ri-arrow-left-s-line"></i></button>
                    <h2 id="mes-titulo" aria-live="polite">&nbsp;</h2>
                    <button class="seta" id="mes-prox" type="button" aria-label="Próximo mês"><i class="ri-arrow-right-s-line"></i></button>
                </div>
                <div class="semana" aria-hidden="true"><span>D</span><span>S</span><span>T</span><span>Q</span><span>Q</span><span>S</span><span>S</span></div>
                <div class="dias" id="dias" role="grid"></div>
            </div>
            <div class="lado">
                <div class="horas-topo"><h2 id="dia-titulo">Escolha um dia</h2><p id="dia-sub">Os dias em verde têm horários livres.</p></div>
                <div class="erro" id="aviso-horas" role="alert" hidden style="margin-bottom:14px"></div>
                <div id="horas"><div class="carregando" aria-label="Carregando horários"><span></span><span></span><span></span><span></span><span></span><span></span></div></div>
            </div>
        </section>
    </div>

    <div class="confirmar" id="confirmar" aria-hidden="true">
        <form id="form-confirmar">
            <div class="escolha"><small>Seu horário</small><b id="escolha-texto">&nbsp;</b></div>
            <div class="campo"><label for="nome">Seu nome</label><input id="nome" name="nome" autocomplete="name" required minlength="2" maxlength="80" value="<%= nome %>"></div>
            <button class="btn" type="submit" id="btn-confirmar"><i class="ri-check-line"></i> Confirmar agendamento</button>
            <div class="erro" id="erro" role="alert" hidden></div>
        </form>
    </div>

    <div class="pagina" id="tela-pronto" hidden>
        <div class="final">
            <div class="icone" aria-hidden="true"><i class="ri-check-line"></i></div>
            <h1>Agendamento confirmado</h1>
            <p class="quando" id="pronto-quando"></p>
            <p>Mandamos a confirmação na sua conversa com <b><%= negocio %></b>. Você vai receber um lembrete antes do horário.</p>
            <% if (voltar) { %><a class="btn" href="<%= voltar %>"><i class="ri-chat-3-line"></i> Voltar para a conversa</a><% } %>
        </div>
    </div>

    <script>
        const TOKEN = <%- JSON.stringify(token) %>;
        const $ = (id) => document.getElementById(id);
        const MESES = ['janeiro', 'fevereiro', 'março', 'abril', 'maio', 'junho', 'julho', 'agosto', 'setembro', 'outubro', 'novembro', 'dezembro'];
        const SEMANA = ['domingo', 'segunda', 'terça', 'quarta', 'quinta', 'sexta', 'sábado'];
        let dados = null, porDia = {}, mesAtual = null, diaEscolhido = null, horaEscolhida = null;

        const partes = (chave) => chave.split('-').map(Number);
        const semanaDe = (chave) => { const [a, m, d] = partes(chave); return new Date(Date.UTC(a, m - 1, d)).getUTCDay(); };
        const tituloDia = (chave) => { const [, m, d] = partes(chave); return `${SEMANA[semanaDe(chave)]}, ${d} de ${MESES[m - 1]}`; };
        const doisDig = (n) => String(n).padStart(2, '0');

        function desenharMes() {
            const [a, m] = mesAtual;
            $('mes-titulo').textContent = `${MESES[m - 1]} ${a}`;
            const primeiro = new Date(Date.UTC(a, m - 1, 1)).getUTCDay();
            const total = new Date(Date.UTC(a, m, 0)).getUTCDate();
            const caixa = $('dias'); caixa.innerHTML = '';
            for (let i = 0; i < primeiro; i++) caixa.appendChild(document.createElement('span'));
            for (let d = 1; d <= total; d++) {
                const chave = `${a}-${doisDig(m)}-${doisDig(d)}`;
                const b = document.createElement('button');
                b.type = 'button'; b.className = 'dia'; b.textContent = d;
                const livres = porDia[chave];
                if (chave === dados.hoje) b.classList.add('hoje');
                if (livres) {
                    b.classList.add('livre');
                    b.setAttribute('aria-label', `${tituloDia(chave)}: ${livres.length} horários livres`);
                    b.onclick = () => escolherDia(chave);
                } else { b.disabled = true; b.setAttribute('aria-label', `${tituloDia(chave)}: sem horários`); }
                if (chave === diaEscolhido) { b.classList.add('escolhido'); b.setAttribute('aria-current', 'date'); }
                caixa.appendChild(b);
            }
            const [ha, hm] = partes(dados.hoje), [ua, um] = partes(dados.ultimo);
            $('mes-ant').disabled = a * 12 + m <= ha * 12 + hm;
            $('mes-prox').disabled = a * 12 + m >= ua * 12 + um;
        }
        function mudarMes(delta) {
            let [a, m] = mesAtual; m += delta;
            if (m < 1) { m = 12; a--; } if (m > 12) { m = 1; a++; }
            mesAtual = [a, m]; desenharMes();
        }

        function escolherDia(chave) {
            diaEscolhido = chave; horaEscolhida = null; fecharConfirmar(); $('aviso-horas').hidden = true;
            const [a, m] = partes(chave); mesAtual = [a, m]; desenharMes();
            $('dia-titulo').textContent = tituloDia(chave).replace(/^./, c => c.toUpperCase());
            const horas = porDia[chave] || [];
            $('dia-sub').textContent = horas.length === 1 ? '1 horário livre' : `${horas.length} horários livres`;
            const grupos = [['Manhã', []], ['Tarde', []], ['Noite', []]];
            horas.forEach(h => { const hh = +h.hora.slice(0, 2); grupos[hh < 12 ? 0 : hh < 18 ? 1 : 2][1].push(h); });
            const caixa = $('horas'); caixa.innerHTML = '';
            grupos.filter(g => g[1].length).forEach(([titulo, lista]) => {
                const t = document.createElement('p'); t.className = 'periodo'; t.textContent = titulo; caixa.appendChild(t);
                const grade = document.createElement('div'); grade.className = 'grade';
                lista.forEach(h => {
                    const b = document.createElement('button');
                    b.type = 'button'; b.className = 'hora'; b.textContent = h.hora; b.setAttribute('aria-pressed', 'false');
                    b.onclick = () => escolherHora(h, b);
                    grade.appendChild(b);
                });
                caixa.appendChild(grade);
            });
        }

        function escolherHora(h, botao) {
            horaEscolhida = h;
            document.querySelectorAll('.hora[aria-pressed="true"]').forEach(x => x.setAttribute('aria-pressed', 'false'));
            botao.setAttribute('aria-pressed', 'true');
            const [, m, d] = partes(diaEscolhido);
            $('escolha-texto').textContent = `${SEMANA[semanaDe(diaEscolhido)].replace(/^./, c => c.toUpperCase())}, ${doisDig(d)}/${doisDig(m)} às ${h.hora}`;
            $('erro').hidden = true;
            const painel = $('confirmar'); painel.classList.add('aberto'); painel.setAttribute('aria-hidden', 'false');
            if (!$('nome').value) $('nome').focus();
        }
        function fecharConfirmar() { const p = $('confirmar'); p.classList.remove('aberto'); p.setAttribute('aria-hidden', 'true'); }

        function mostrarVazio(texto) {
            $('horas').innerHTML = `<div class="vazio"><i class="ri-calendar-close-line" aria-hidden="true"></i>${texto}</div>`;
        }

        async function carregar(manterDia) {
            try {
                const r = await fetch(`/api/agendar/${TOKEN}/horarios`);
                const j = await r.json();
                if (!r.ok) return mostrarVazio(j.error || 'Não foi possível carregar a agenda.');
                dados = j; porDia = {};
                j.dias.forEach(d => { porDia[d.chave] = d.horas; });
                $('duracao').textContent = `${j.duracao} min`;
                const [a, m] = partes(j.hoje); if (!mesAtual) mesAtual = [a, m];
                if (!j.dias.length) { desenharMes(); $('dia-titulo').textContent = 'Agenda cheia'; $('dia-sub').textContent = ''; return mostrarVazio('Não há horários livres por enquanto. Volte para a conversa e fale com a gente.'); }
                escolherDia(manterDia && porDia[manterDia] ? manterDia : j.dias[0].chave);
            } catch (e) { mostrarVazio('Sem conexão. Confira sua internet e recarregue a página.'); }
        }

        $('mes-ant').onclick = () => mudarMes(-1);
        $('mes-prox').onclick = () => mudarMes(1);
        $('form-confirmar').addEventListener('submit', async (e) => {
            e.preventDefault();
            if (!horaEscolhida) return;
            const b = $('btn-confirmar'); b.disabled = true;
            try {
                const r = await fetch(`/api/agendar/${TOKEN}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ inicio: horaEscolhida.inicio, nome: $('nome').value.trim() }) });
                const j = await r.json();
                if (!r.ok) {
                    $('erro').textContent = j.error || 'Não foi possível confirmar.'; $('erro').hidden = false;
                    if (j.motivo === 'ocupado' || j.motivo === 'passado') {
                        fecharConfirmar(); await carregar(diaEscolhido);
                        $('aviso-horas').textContent = j.error; $('aviso-horas').hidden = false;
                    }
                    return;
                }
                $('pronto-quando').textContent = j.quando.replace(/^./, c => c.toUpperCase());
                $('tela-escolha').hidden = true; fecharConfirmar(); $('tela-pronto').hidden = false;
                window.scrollTo(0, 0);
            } catch (err) { $('erro').textContent = 'Sem conexão. Tente de novo.'; $('erro').hidden = false; }
            finally { b.disabled = false; }
        });
        carregar();
    </script>
<% } %>
</body>
</html>
