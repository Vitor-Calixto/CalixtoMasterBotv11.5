// ----------------------------------------------------------------------------
// ARQUIVO: prisma/schema.prisma (ATUALIZADO V12 OMNICHANNEL)
// ----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id              String    @id @default(uuid())
  email           String    @unique
  senha           String
  nome            String
  role            String    @default("CLIENTE") 
  ativo           Boolean   @default(false)
  bloqueado       Boolean   @default(false)
  expiraEm        DateTime?
  resetToken      String?   
  resetExpires    DateTime?
  termsAccepted   Boolean   @default(false)
  termsAcceptedAt DateTime?
  signupIp        String?
  plano           String    @default("ESSENTIAL") 
  clientes        Cliente[] 
  criadoEm        DateTime  @default(now())
}

model Cliente {
  id                String   @id @default(uuid())
  nome              String
  numeroNotificacao String?
  numero            String?  @unique
  ativo             Boolean  @default(false)
  plataforma String @default("WHATSAPP")
  fluxoJson         Json?
  contratos         ContratoTemplate[]
  status            String   @default("OFFLINE")
  criadoEm          DateTime @default(now())
  igAppId       String?
  igAppSecret   String?

  // 📸 --- NOVOS CAMPOS INSTAGRAM V12 ---
  instagramId    String?  @unique // ID único da Meta (ex: 264199...)
  instagramUser  String?          // @username (ex: calixto.dev)
  instagramToken String?          // Access Token de acesso ao Direct

  tempoLembrete1       Int      @default(24)
  tempoLembrete2       Int      @default(0)
  usarHorarioComercial Boolean  @default(true)

  donoId    String?  
  dono      Usuario? @relation(fields: [donoId], references: [id])

  contatos      Contato[]
  sessoesAtivas SessaoAtiva[]
  lembretes     Lembrete[]
}

model SessaoAtiva {
  id        String   @id @default(uuid())
  clienteId String
  chatId    String
  noAtual   String
  dados     Json?
  updatedAt DateTime @updatedAt
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  @@unique([clienteId, chatId])
}

model Contato {
  id        String   @id @default(uuid())
  remoteJid String
  nome      String?
  clienteId String
  criadoEm  DateTime @default(now())
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  mensagens Mensagem[]
}

model Mensagem {
  id        String   @id @default(uuid())
  texto     String
  tipo      String   @default("texto")
  fromMe    Boolean
  contatoId String
  criadoEm  DateTime @default(now())
  contato   Contato  @relation(fields: [contatoId], references: [id], onDelete: Cascade)
}

model ContratoTemplate {
  id        String   @id @default(uuid())
  nome      String   
  conteudo  String   @db.Text 
  arquivoUrl String?
  criadoEm  DateTime @default(now())
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  clienteId String
}

model Lembrete {
  id              String   @id @default(uuid())
  numero          String   
  mensagem        String   
  cpf             String?
  nome            String?
  dataAgendada    DateTime 
  status          String   @default("PENDENTE") 
  lembreteEnviado Boolean  @default(false)      
  clienteId       String
  cliente         Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}