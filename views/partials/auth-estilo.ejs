    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <style>
        :root { --tinta: #16211c; --tinta-2: #4b5a53; --tinta-3: #7a8a82; --fundo: #f5f7f4; --papel: #fff; --linha: #dfe5e0; --floresta: #0e3b2e; --acao: #128c6b; --acao-hover: #0e7458; --menta: #dff3ea; --erro: #b42318; --erro-fundo: #fef3f2; --info-fundo: #eef4ff; --info: #1d4ed8; }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { min-height: 100vh; background: var(--fundo); color: var(--tinta); font-family: 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.5; display: flex; flex-direction: column; -webkit-font-smoothing: antialiased; }
        a { color: var(--acao); }
        :focus-visible { outline: 3px solid var(--acao); outline-offset: 2px; border-radius: 4px; }
        .marca { display: inline-flex; align-items: center; gap: 10px; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 20px; letter-spacing: -.3px; color: var(--tinta); text-decoration: none; }
        .marca-icone { width: 32px; height: 32px; border-radius: 9px; background: var(--floresta); color: #fff; display: grid; place-items: center; font-size: 18px; }
        .topo { padding: 22px 24px; }
        main { flex: 1; display: flex; align-items: flex-start; justify-content: center; padding: 24px 20px 64px; }
        .caixa { width: 100%; max-width: 420px; background: var(--papel); border: 1px solid var(--linha); border-radius: 20px; padding: 36px 32px; margin-top: 4vh; }
        h1 { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 30px; letter-spacing: -.8px; line-height: 1.1; }
        .sub { color: var(--tinta-2); margin: 8px 0 26px; }
        label { display: block; font-weight: 600; font-size: 14.5px; margin: 16px 0 6px; }
        .campo { position: relative; }
        input[type=email], input[type=password], input[type=text] { width: 100%; padding: 13px 14px; border: 1.5px solid var(--linha); border-radius: 12px; font: inherit; color: var(--tinta); background: #fff; }
        input:focus { outline: none; border-color: var(--acao); box-shadow: 0 0 0 3px rgba(18, 140, 107, .15); }
        .ver-senha { position: absolute; right: 6px; top: 50%; transform: translateY(-50%); border: 0; background: transparent; color: var(--tinta-3); font-size: 19px; cursor: pointer; padding: 6px 8px; border-radius: 8px; }
        .ver-senha:hover { color: var(--tinta); }
        .dica { font-size: 13.5px; color: var(--tinta-3); margin-top: 6px; }
        .linha-acoes { display: flex; justify-content: flex-end; margin-top: 8px; font-size: 14.5px; }
        .check { display: flex; gap: 10px; align-items: flex-start; font-weight: 400; font-size: 14.5px; color: var(--tinta-2); margin-top: 18px; }
        .check input { margin-top: 3px; width: 17px; height: 17px; accent-color: var(--acao); flex: none; }
        .btn { width: 100%; margin-top: 24px; padding: 14px; border: 0; border-radius: 999px; background: var(--acao); color: #fff; font: 600 16px 'Instrument Sans', sans-serif; cursor: pointer; display: inline-flex; justify-content: center; align-items: center; gap: 8px; text-decoration: none; }
        .btn:hover { background: var(--acao-hover); }
        .btn:disabled { opacity: .6; cursor: wait; }
        .rodape { text-align: center; margin-top: 22px; font-size: 14.5px; color: var(--tinta-2); }
        .msg { border-radius: 12px; padding: 12px 14px; font-size: 14.5px; margin-bottom: 18px; display: flex; gap: 10px; align-items: flex-start; }
        .msg i { font-size: 18px; line-height: 1.3; }
        .msg.erro { background: var(--erro-fundo); color: var(--erro); }
        .msg.ok { background: var(--menta); color: var(--floresta); }
        .msg.info { background: var(--info-fundo); color: var(--info); }
        @media (max-width: 480px) { .caixa { padding: 28px 20px; border-radius: 16px; margin-top: 0; } h1 { font-size: 26px; } }
    </style>
    <script>
        // Mostrar/ocultar senha
        document.addEventListener('click', function (e) {
            var b = e.target.closest('.ver-senha'); if (!b) return;
            var i = b.parentElement.querySelector('input');
            var mostrar = i.type === 'password';
            i.type = mostrar ? 'text' : 'password';
            b.setAttribute('aria-label', mostrar ? 'Ocultar senha' : 'Mostrar senha');
            b.querySelector('i').className = mostrar ? 'ri-eye-off-line' : 'ri-eye-line';
        });
        // Evita envio duplo
        document.addEventListener('submit', function (e) {
            var b = e.target.querySelector('button[type=submit]'); if (b) setTimeout(function () { b.disabled = true; }, 0);
        });
    </script>
