// ARQUIVO: prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- MODELO USUÁRIO (ATUALIZADO PARA SAAS + JURÍDICO) ---
model Usuario {
  id           String    @id @default(uuid())
  email        String    @unique
  senha        String
  nome         String
  role         String    @default("CLIENTE") // "ADMIN" ou "CLIENTE"
  ativo        Boolean   @default(false)
  
  // --- NOVOS CAMPOS DE CONTROLE ---
  bloqueado    Boolean   @default(false)       // Se true, o usuário não entra no sistema
  expiraEm     DateTime?                       // Data limite de uso (Trial ou Plano)
  
  // Campos de recuperação de senha
  resetToken   String?   
  resetExpires DateTime?

  // --- DADOS JURÍDICOS (LGPD & TERMOS DE USO) ---
  termsAccepted   Boolean   @default(false)    // Checkbox de aceite
  termsAcceptedAt DateTime?                    // Data e Hora exata do aceite (Prova)
  signupIp        String?                      // IP da máquina no momento do cadastro

  // --- PLANOS ---
  plano         String    @default("ESSENTIAL") // ESSENTIAL, ADVANCED, SIGNATURE
  
  // Relacionamentos
  clientes      Cliente[] 
  criadoEm      DateTime  @default(now())
}

// --- MODELO CLIENTE (O ROBÔ) ---
model Cliente {
  id                String   @id @default(uuid())
  nome              String
  numeroNotificacao String?
  numero            String?  @unique
  ativo             Boolean  @default(false)
  fluxoJson         Json?
  contratos         ContratoTemplate[]
  status            String   @default("OFFLINE")
  criadoEm          DateTime @default(now())


  tempoLembrete1       Int      @default(24)   // Padrão: 24 horas antes
  tempoLembrete2       Int      @default(0)    // Padrão: 0 (desativado)
  usarHorarioComercial Boolean  @default(true) // Padrão: bloqueia agendamentos de madrugada

  // Vínculo com o Dono
  donoId    String?  
  dono      Usuario? @relation(fields: [donoId], references: [id])

  contatos      Contato[]
  sessoesAtivas SessaoAtiva[]

  // Vínculos de Dados
  lembretes     Lembrete[]
}

model SessaoAtiva {
  id        String   @id @default(uuid())
  clienteId String
  chatId    String
  noAtual   String
  dados     Json?
  updatedAt DateTime @updatedAt
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  @@unique([clienteId, chatId])
}

model Contato {
  id        String   @id @default(uuid())
  remoteJid String
  nome      String?
  clienteId String
  criadoEm  DateTime @default(now())
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  mensagens Mensagem[]
}

model Mensagem {
  id        String   @id @default(uuid())
  texto     String
  tipo      String   @default("texto")
  fromMe    Boolean
  contatoId String
  criadoEm  DateTime @default(now())
  contato   Contato  @relation(fields: [contatoId], references: [id], onDelete: Cascade)
}

model ContratoTemplate {
  id        String   @id @default(uuid())
  nome      String   // Nome do modelo (ex: Contrato de Aluguel)
  conteudo  String   @db.Text // O texto HTML com as {{variaveis}}
  criadoEm  DateTime @default(now())
  
  // Relacionamento com o seu cliente (dono do bot)
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  clienteId String
}

model Lembrete {
  id              String   @id @default(uuid())
  numero          String   // WhatsApp do paciente/cliente (Ex: 5521...)
  mensagem        String   // Texto do lembrete (Ex: "Confirmado: Vitor")
  cpf             String?
  nome            String?
  dataAgendada    DateTime // Data e hora exata do compromisso
  
  status          String   @default("PENDENTE") // PENDENTE, ENVIADO, BLOQUEADO
  lembreteEnviado Boolean  @default(false)      // Trava de segurança extra
  
  // Relação com o Bot (Cliente)
  clienteId       String
  cliente         Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
}