    <script>
        window.addEventListener('load', () => {
            const loader = document.getElementById('jarvis-loader');
            const flash = document.getElementById('crt-flash');
            const consoleLog = document.getElementById('console-log');
            
            // Simula logs de terminal de boot
            const logs = [
                "LOADING KERNEL...", 
                "CONNECTING NEURAL NET...", 
                "CHECKING PROTOCOLS...", 
                "ACCESS GRANTED"
            ];
            let i = 0;
            
            // Intervalo para trocar o texto do log
            setInterval(() => { 
                if(i < logs.length) consoleLog.innerText = logs[i++] 
            }, 800);

            // Tempo total do loader antes de abrir o site
            setTimeout(() => {
                // Efeito de TV antiga ligando
                flash.style.animation = "crtTurnOn 0.4s linear forwards";
                
                // Some com o loader
                loader.style.opacity = '0';
                setTimeout(() => { loader.style.display = 'none'; }, 500);
            }, 4000); // 4 segundos de loading
        });
    </script>

