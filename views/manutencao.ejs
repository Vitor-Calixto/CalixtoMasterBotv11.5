<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema em Manutenção | Calixto AI</title>
    <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        body {
            background-color: #050505;
            color: #ff4444; /* Vermelho Alerta */
            font-family: 'Share Tech Mono', monospace;
            height: 100vh;
            margin: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background-image: radial-gradient(circle at center, #1a0505 0%, #000000 90%);
        }
        .container { text-align: center; position: relative; z-index: 10; }
        h1 {
            font-family: 'Orbitron', sans-serif;
            font-size: 3rem;
            margin-bottom: 10px;
            text-shadow: 0 0 20px #ff0000;
            letter-spacing: 5px;
        }
        p { font-size: 1.2rem; color: #ffaaaa; letter-spacing: 2px; }
        
        /* Animação do Icone */
        .gear-system {
            position: relative;
            width: 200px; height: 200px;
            margin: 0 auto 40px;
        }
        .gear {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            border: 4px dashed #ff4444;
            border-radius: 50%;
            animation: spin 10s linear infinite;
            box-shadow: 0 0 30px rgba(255, 0, 0, 0.2);
        }
        .gear-inner {
            position: absolute; top: 20%; left: 20%; width: 60%; height: 60%;
            border: 4px dotted #ff8800; /* Laranja */
            border-radius: 50%;
            animation: spin-rev 5s linear infinite;
        }
        .icon-lock {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            font-size: 3rem; color: #fff;
        }

        @keyframes spin { 100% { transform: rotate(360deg); } }
        @keyframes spin-rev { 100% { transform: rotate(-360deg); } }

        .btn-admin {
            margin-top: 40px;
            text-decoration: none;
            border: 1px solid #ff4444;
            padding: 10px 30px;
            color: #ff4444;
            transition: 0.3s;
            display: inline-block;
        }
        .btn-admin:hover { background: #ff4444; color: #000; }
    </style>
</head>
<body>
    <div class="container">
        <div class="gear-system">
            <div class="gear"></div>
            <div class="gear-inner"></div>
            <div class="icon-lock">⚠️</div>
        </div>
        <h1>MANUTENÇÃO</h1>
        <p>ATUALIZANDO PROTOCOLOS DE SEGURANÇA</p>
        <p style="font-size: 0.9rem; opacity: 0.7;">RETORNAREMOS EM BREVE</p>
        
        <br>
        <a href="/login" class="btn-admin">ACESSO ADMINISTRATIVO</a>
    </div>
</body>
</html>