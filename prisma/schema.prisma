// ARQUIVO: prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- MODELO USUÁRIO (ATUALIZADO PARA SAAS + JURÍDICO) ---
model Usuario {
  id           String    @id @default(uuid())
  email        String    @unique
  senha        String
  nome         String
  role         String    @default("CLIENTE") // "ADMIN" ou "CLIENTE"
  ativo        Boolean   @default(false)
  
  // --- NOVOS CAMPOS DE CONTROLE ---
  bloqueado    Boolean   @default(false)       // Se true, o usuário não entra no sistema
  expiraEm     DateTime?                       // Data limite de uso (Trial ou Plano)
  
  // Campos de recuperação de senha
  resetToken   String?   
  resetExpires DateTime?

  // --- DADOS JURÍDICOS (LGPD & TERMOS DE USO) ---
  termsAccepted   Boolean   @default(false)    // Checkbox de aceite
  termsAcceptedAt DateTime?                    // Data e Hora exata do aceite (Prova)
  signupIp        String?                      // IP da máquina no momento do cadastro

  // --- PLANOS ---
  plano         String    @default("ESSENTIAL") // ESSENTIAL, ADVANCED, SIGNATURE
  
  // Relacionamentos
  clientes      Cliente[] 
  criadoEm      DateTime  @default(now())
}

// --- MODELO CLIENTE ---
model Cliente {
  id        String   @id @default(uuid())
  nome      String
  numero    String?  @unique
  ativo     Boolean  @default(false)
  fluxoJson Json?
  status    String   @default("OFFLINE")
  criadoEm  DateTime @default(now())

  // Vínculo com o Dono
  donoId    String?  
  dono      Usuario? @relation(fields: [donoId], references: [id])

  contatos      Contato[]
  sessoesAtivas SessaoAtiva[]
}

model SessaoAtiva {
  id        String   @id @default(uuid())
  clienteId String
  chatId    String
  noAtual   String
  dados     Json?
  updatedAt DateTime @updatedAt
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  @@unique([clienteId, chatId])
}

model Contato {
  id        String   @id @default(uuid())
  remoteJid String
  nome      String?
  clienteId String
  criadoEm  DateTime @default(now())
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  mensagens Mensagem[]
}

model Mensagem {
  id        String   @id @default(uuid())
  texto     String
  tipo      String   @default("texto")
  fromMe    Boolean
  contatoId String
  criadoEm  DateTime @default(now())
  contato   Contato  @relation(fields: [contatoId], references: [id], onDelete: Cascade)
}