sessions/
auth_info_baileys/

# --- Banco de Dados (SQLite e Logs) ---
*.db
*.db-journal
prisma/*.db
prisma/*.db-journal

# --- Logs do Sistema ---
logs/
*.log
pids/
*.pid
*.seed
*.pid.lock

# --- Sistema Operacional ---
.DS_Store
Thumbs.db

# --- Uploads (Opcional) ---
# Geralmente não queremos subir as fotos de teste para o Git,
# mas queremos manter a pasta vazia criada.
public/uploads/*
!public/uploads/.gitkeep