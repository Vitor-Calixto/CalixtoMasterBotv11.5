        // =========================================================
        // 14. SANITIZAÇÃO E COMPATIBILIDADE DE DADOS
        // Garante que o JSON do banco use os templates HTML atuais
        // =========================================================
        function escHtml(valor) {
            return String(valor ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }

        function sanitizarJson(json) {
            if (!json || !json.drawflow || !json.drawflow.Home || !json.drawflow.Home.data) {
                return json;
            }

            const nodes = json.drawflow.Home.data;

            for (const key in nodes) {
                const node = nodes[key];
                
                // Remove travas de tipo antigas
                node.typenode = false; 

                // Se o nome do nó existe nos nossos templates, atualiza o HTML
                if (templates[node.name]) {
                    node.html = templates[node.name];
                }
            }

            return json;
        }

        // =========================================================
        // 15. SISTEMA DE CACHE E CARREGAMENTO DE CONTRATOS
        // Busca os modelos do banco e injeta nos selects dos nós
        // =========================================================
        let cacheContratos = [];

        async function carregarMeusModelos() {
            if (MODO_MODELO) return; // contratos pertencem ao bot, não ao modelo
            try {
                const res = await fetch(`/api/clientes/${idCliente}/contratos`);
                
                if (res.ok) {
                    cacheContratos = await res.json();
                    atualizarTodosSelects();
                }
            } catch (e) { 
                console.error("Erro ao buscar contratos no servidor:", e); 
            }
        }

        function preencherSelect(selectElement) {
            const valorAtual = selectElement.value;
            
            // Reseta o select com a opção padrão
            selectElement.innerHTML = '<option value="" disabled selected>Selecione um modelo...</option>';
            
            // Se não houver contratos no banco
            if (cacheContratos.length === 0) {
                selectElement.innerHTML += '<option value="" disabled>Nenhum modelo encontrado</option>';
                return;
            }

            // Injeta cada contrato do cache como uma <option>
            cacheContratos.forEach(modelo => {
                const opt = document.createElement('option');
                opt.value = modelo.id;
                opt.innerText = modelo.nome;
                selectElement.appendChild(opt);
            });

            // Se o nó já tinha um valor selecionado antes, restaura ele
            if (valorAtual) {
                selectElement.value = valorAtual;
            }
        }

        function atualizarTodosSelects() {
            const selects = document.querySelectorAll('.contract-selector');
            selects.forEach(sel => {
                preencherSelect(sel);
            });
        }

       // =========================================================
        // 16. INICIALIZAÇÃO BLINDADA (AUTO-CORREÇÃO PARA NOVOS BOTS)
        // =========================================================
        window.addEventListener('load', async () => {
            console.log("[SISTEMA] 🚀 Iniciando boot do Editor V12...");

            // 1. Carrega os modelos primeiro
            await carregarMeusModelos(); 

            try {
                const base64Input = document.getElementById('fluxo-base64');
                const base64Data = base64Input ? base64Input.value : "";
                
                // Só tenta processar se o Base64 não for vazio e não for um objeto vazio "{}"
                if (base64Data && base64Data.trim() !== "" && base64Data !== "e30=") {
                    
                    const jsonString = decodeURIComponent(escape(window.atob(base64Data)));
                    
                    // Validação extra: Se o banco retornou a string "null" ou "undefined"
                    if (jsonString && jsonString !== "null" && jsonString !== "undefined") {
                        let json = JSON.parse(jsonString);
                        json = sanitizarJson(json);
                        
                        editor.import(json); 
                        setTimeout(restoreData, 300);
                        console.log("[SISTEMA] ✅ Fluxo existente carregado.");
                        return; // Sucesso: Finaliza o load aqui
                    }
                }

                // 2. Se o fluxo for novo ou vazio, inicia o Canvas com o nó padrão
                console.log("[SISTEMA] 🆕 Bot novo detectado. Gerando nó de início...");
                editor.addNode('inicio', 0, 1, 50, 200, 'inicio', {}, templates.inicio);

            } catch (e) { 
                console.error("[SISTEMA] Falha ao parsear JSON:", e);
                // Fallback: Em caso de erro, não trava a tela, apenas inicia um fluxo novo
                editor.clear();
                editor.addNode('inicio', 0, 1, 50, 200, 'inicio', {}, templates.inicio);
            }
        });

         // ====================================
         // 17. MONITORAMENTO DE CRIAÇÃO DE NÓS
         // ====================================
        editor.on('nodeCreated', function(id) {
            const node = editor.getNodeFromId(id);
            
            // Se for um nó de contrato, preenche o select imediatamente
            if (node.name === 'gerar_documento') {
                const el = document.getElementById('node-' + id);
                const select = el.querySelector('.contract-selector');
                
                if (select) {
                    preencherSelect(select);
                }
            }
        });

        // =========================================================
        // 18. FUNÇÕES DE DRAG & DROP (ARRASTAR E SOLTAR)
        // Controla a movimentação da barra lateral para o canvas
        // =========================================================
        function drag(ev) { 
            ev.dataTransfer.setData("node", ev.target.getAttribute('data-node')); 
        }

        function allowDrop(ev) { 
            ev.preventDefault(); 
        }

        function drop(ev) { 
            ev.preventDefault(); 
            const nodeName = ev.dataTransfer.getData("node"); 
            addNodeToDrawFlow(nodeName, ev.clientX, ev.clientY); 
        }

        function addNodeToDrawFlow(name, pos_x, pos_y) {
            if (editor.editor_mode === 'fixed') {
                return;
            }

            // Cálculo matemático para posicionar o nó exatamente onde o mouse soltou
            pos_x = pos_x * (editor.precanvas.clientWidth / (editor.precanvas.clientWidth * editor.zoom)) - (editor.precanvas.getBoundingClientRect().x * (editor.precanvas.clientWidth / (editor.precanvas.clientWidth * editor.zoom)));
            pos_y = pos_y * (editor.precanvas.clientHeight / (editor.precanvas.clientHeight * editor.zoom)) - (editor.precanvas.getBoundingClientRect().y * (editor.precanvas.clientHeight / (editor.precanvas.clientHeight * editor.zoom)));

            let inputs = 1;
            let outputs = 1;

            // Configuração específica de conexões por tipo de nó
            if (name === 'inicio') { inputs = 0; outputs = 1; } 
            if (name === 'acesso_secreto') { inputs = 0; outputs = 1; } 
            if (name === 'finalizar') { inputs = 1; outputs = 0; } 
            if (name === 'menu') { inputs = 1; outputs = 2; } 
            if (name === 'horario') { inputs = 1; outputs = 2; } 
            if (name === 'transferir') { inputs = 1; outputs = 0; }
            if (name === 'espera') { inputs = 1; outputs = 1; }
            if (name === 'pergunta') { inputs = 1; outputs = 1; }
            if (name === 'gerar_documento') { inputs = 1; outputs = 1; }

            editor.addNode(name, inputs, outputs, pos_x, pos_y, name, {}, templates[name]);
        }

        // =========================================================
        // 19. RESTAURAÇÃO DE DADOS VISUAIS (BOOT)
        // Redesenha fotos, players de áudio e menus complexos
        // =========================================================
        function restoreData() {
            const data = editor.drawflow.drawflow.Home.data;

            for (const [id, node] of Object.entries(data)) {
                const el = document.getElementById('node-' + id);
                if (!el) continue;

                // Restauração específica para o Nó de Menu
                if (node.name === 'menu') {
                    const list = el.querySelector('.menu-list');
                    if (list) {
                        list.innerHTML = ''; 
                        let maxOpt = 0;

                        // Descobre quantas opções existiam no JSON
                        Object.keys(node.data).forEach(k => { 
                            if (k.startsWith('opcao')) {
                                maxOpt = Math.max(maxOpt, parseInt(k.replace('opcao', ''))); 
                            }
                        });

                        if (maxOpt < 2) maxOpt = 2;

                        // Recria as linhas de input do menu
                        for (let i = 1; i <= maxOpt; i++) {
                            const div = document.createElement('div');
                            div.className = 'menu-item';
                            div.id = 'opt-' + i;
                            div.innerHTML = `
                                <input type="text" df-opcao${i} placeholder="Opção ${i}" value="${escHtml(node.data['opcao' + i] || '')}">
                                <div class="btn-del-opt" onclick="removeOption(this)">
                                    <i class="fas fa-trash"></i>
                                </div>`;
                            list.appendChild(div);
                        }

                        // Restaura os switches de Timeout e Erro
                        if (node.data['invalid-active']) el.querySelector('.error-row input').checked = true;
                        if (node.data['timeout-active']) el.querySelector('.timeout-row input').checked = true;

                        // Restaura o toggle de Emojis (fluxos antigos sem o campo => true)
                        // Chave minúscula: o navegador salva df-usarEmoji como df-usaremoji
                        const chkEmoji = el.querySelector('[df-usaremoji]');
                        if (chkEmoji) {
                            const v = node.data['usaremoji'] ?? node.data['usarEmoji'];
                            chkEmoji.checked = !(v === false || v === 'false' || v === '0' || v === 0 || v === 'off');
                        }

                        // Ativa o vigia de redimensionamento e as bolinhas
                        watchNode(id); 
                        setTimeout(() => updateMenuOutputs(id), 100);
                    }
                } 

                // Restauração visual de Mídias (Fotos/Áudios)
                else if (['midia', 'audio'].includes(node.name)) {
                    const url = node.data.url;
                    if (url) {
                        const inputUrl = el.querySelector('[df-url]');
                        if (inputUrl) inputUrl.value = url;

                        const area = el.querySelector('.upload-area span');

                        if (node.name === 'midia') { 
                            const img = el.querySelector('img'); 
                            const fileUrl = url.toLowerCase();
                            const fileName = url.split('/').pop(); // Pega só o nome do arquivo no final do link

                            if (fileUrl.endsWith('.pdf')) {
                                if (img) img.style.display = 'none';
                                area.innerHTML = `<div style="text-align: center; padding: 10px;">
                                                    <i class="fas fa-file-pdf" style="font-size: 24px; color: #ff4757; margin-bottom: 5px;"></i><br>
                                                    <span style="font-size: 10px;">${escHtml(fileName.substring(0, 15))}...</span>
                                                  </div>`;
                                area.style.display = 'block';
                            } 
                            else if (fileUrl.endsWith('.mp4')) {
                                if (img) img.style.display = 'none';
                                area.innerHTML = `<div style="text-align: center; padding: 10px;">
                                                    <i class="fas fa-file-video" style="font-size: 24px; color: #70a1ff; margin-bottom: 5px;"></i><br>
                                                    <span style="font-size: 10px;">${escHtml(fileName.substring(0, 15))}...</span>
                                                  </div>`;
                                area.style.display = 'block';
                            } 
                            else {
                                // É imagem (jpg, png, etc)
                                if (img) { 
                                    img.src = url; 
                                    img.style.display = 'block'; 
                                    area.style.display = 'none'; 
                                } 
                            }
                        } else if (node.name === 'audio') { 
                            area.innerHTML = '<i class="fas fa-check"></i> Áudio Salvo!'; 
                        }
                    }
                }
                
                // Sincronização forçada dos Contratos
                else if (node.name === 'gerar_documento') {
                    setTimeout(() => {
                        const sel = el.querySelector('.contract-selector');
                        if (sel && node.data.templateId) {
                            sel.value = node.data.templateId;
                        }
                    }, 500); 
                }

                // Preenchimento automático de campos df-* (Inputs de texto comuns)
                for (let key in node.data) {
                    const input = el.querySelector(`[df-${key}]`);
                    if (input) { 
                        if (input.type === 'checkbox') {
                            input.checked = node.data[key]; 
                        } else {
                            input.value = node.data[key]; 
                        }
                    }
                }
            }
            
            // Finaliza atualizando todos os selects de contratos na tela
            setTimeout(atualizarTodosSelects, 200);
        }

        // =========================================================
        // 20. MOTOR DE CONEXÕES DINÂMICAS (OUTPUTS)
        // Faz as bolinhas de conexão seguirem as linhas do menu
        // =========================================================
        function getRelativeTop(element, rootNode) {
            let y = 0; 
            let el = element;
            while (el && el !== rootNode) { 
                y += el.offsetTop; 
                el = el.offsetParent; 
            }
            return y;
        }

        function updateMenuOutputs(nodeId) {
            const nodeEl = document.getElementById('node-' + nodeId);
            if (!nodeEl) return;

            const outputContainer = nodeEl.querySelector('.outputs');
            const menuRows = Array.from(nodeEl.querySelectorAll('.menu-item'));
            const timeoutRow = nodeEl.querySelector('.timeout-row');
            const errorRow = nodeEl.querySelector('.error-row');

            const timeoutActive = timeoutRow && timeoutRow.querySelector('input').checked;
            const errorActive = errorRow && errorRow.querySelector('input').checked;

            let needed = menuRows.length;
            if (timeoutActive) needed++;
            if (errorActive) needed++;

            const currentOutputs = editor.getNodeFromId(nodeId).outputs;
            const currentCount = Object.keys(currentOutputs).length;

            // Ajusta a quantidade de bolinhas (Adiciona ou Remove)
            if (currentCount < needed) { 
                for (let i = 0; i < (needed - currentCount); i++) editor.addNodeOutput(nodeId); 
            } else if (currentCount > needed) { 
                for (let i = 0; i < (currentCount - needed); i++) editor.removeNodeOutput(nodeId, `output_${currentCount - i}`); 
            }

            // Posiciona cada bolinha milimetricamente ao lado da sua linha
            setTimeout(() => {
                const outputs = Array.from(outputContainer.children); 
                let outIdx = 0;

                const posicionar = (targetEl, color = null) => {
                    if (outputs[outIdx] && targetEl) {
                        const realTop = getRelativeTop(targetEl, nodeEl) + (targetEl.offsetHeight / 2);
                        outputs[outIdx].style.top = `${realTop}px`; 
                        outputs[outIdx].style.display = 'block';
                        
                        if (color) {
                            outputs[outIdx].style.borderColor = color; 
                        } else {
                            outputs[outIdx].style.borderColor = '#000';
                        }
                        outIdx++;
                    }
                };

                menuRows.forEach(row => posicionar(row));
                if (timeoutActive) posicionar(timeoutRow, '#fbbf24');
                if (errorActive) posicionar(errorRow, '#ef4444');

                editor.updateConnectionNodes(nodeId);
            }, 30);
        }

        // =========================================================
        // 21. GESTÃO DINÂMICA DE OPÇÕES (ADICIONAR/REMOVER)
        // =========================================================
        const observers = new Map();

        function watchNode(nodeId) {
            if (observers.has(nodeId)) return;
            const el = document.getElementById('node-' + nodeId);
            if (!el) return;

            const ro = new ResizeObserver(() => updateMenuOutputs(nodeId));
            ro.observe(el);
            observers.set(nodeId, ro);
        }

        window.addMenuOption = function(btn) {
            const nodeId = getNodeId(btn);
            const list = btn.previousElementSibling;
            const newIdx = list.children.length + 1;

            const div = document.createElement('div');
            div.className = 'menu-item';
            div.id = 'opt-' + newIdx;
            div.innerHTML = `
                <input type="text" df-opcao${newIdx} placeholder="Opção ${newIdx}">
                <div class="btn-del-opt" onclick="removeOption(this)">
                    <i class="fas fa-trash"></i>
                </div>`;
            
            list.appendChild(div);
            updateMenuOutputs(nodeId);
        }

        window.removeOption = function(btn) {
            const row = btn.closest('.menu-item');
            const nodeId = getNodeId(btn);
            const input = row.querySelector('input');
            const attr = Array.from(input.attributes).find(a => a.name.startsWith('df-'));

            if (attr) {
                const data = editor.getNodeFromId(nodeId).data;
                delete data[attr.name.replace('df-', '')];
                editor.updateNodeDataFromId(nodeId, data);
            }
            row.remove();
            updateMenuOutputs(nodeId);
        }

        window.toggleSpecialFlow = function(key, chk) {
            const nodeId = getNodeId(chk);
            const data = editor.getNodeFromId(nodeId).data;
            data[key + '-active'] = chk.checked;
            editor.updateNodeDataFromId(nodeId, data);
            updateMenuOutputs(nodeId);
        }

        // =========================================================
        // 22. CAPTURA DE INPUT EM TEMPO REAL
        // Salva cada letra digitada direto na memória do Drawflow
        // =========================================================
        function salvarCampoDrawflow(e) {
            if (!e.target.matches('input, textarea, select')) return;

            const nodeEl = e.target.closest('.drawflow-node');
            if (!nodeEl) return;

            const nodeId = nodeEl.id.replace('node-', '');
            const attr = Array.from(e.target.attributes).find(a => a.name.startsWith('df-'));

            if (attr) {
                const key = attr.name.replace('df-', '');
                const data = editor.getNodeFromId(nodeId).data;
                
                data[key] = e.target.type === 'checkbox' ? e.target.checked : e.target.value;
                editor.updateNodeDataFromId(nodeId, data);
            }
        }
        document.getElementById('drawflow').addEventListener('input', salvarCampoDrawflow);
        // Checkbox (ex: Usar emojis) dispara 'change' em alguns navegadores, não 'input'
        document.getElementById('drawflow').addEventListener('change', salvarCampoDrawflow);


    // =========================================================
        // 23. SISTEMA DE UPLOAD DE ARQUIVOS (MÍDIA/ÁUDIO/PDF)
        // Faz o upload, injeta a URL e avisa o Drawflow
        // =========================================================
        async function uploadFile(input, tipo = 'imagem') {
            const file = input.files[0]; 
            if (!file) return;
            
            const area = input.parentElement.querySelector('.upload-area'); 
            area.innerHTML = '<span>⏳ Enviando arquivo...</span>';
            
            const formData = new FormData(); 
            formData.append('file', file);
            
            try {
                const res = await fetch('/upload', { 
                    method: 'POST', 
                    body: formData 
                });

                if (!res.ok) {
                    throw new Error(`Erro HTTP: ${res.status}`);
                }

                const data = await res.json();
                
                if (data.url) {
                    // Seleciona o input df-* correto baseado no tipo
                    const selector = tipo === 'pdf' ? '[df-arquivo]' : '[df-url]';
                    const inputUrl = input.parentElement.querySelector(selector); 
                    
                    // O TRUQUE: Joga a URL no campo oculto e dispara o evento 'input'
                    // Isso faz o Drawflow perceber a mudança e salvar no JSON
                    if (inputUrl) {
                        inputUrl.value = data.url; 
                        inputUrl.dispatchEvent(new Event('input', { bubbles: true }));
                    }
                    
                    // Atualiza a Interface Visual
                    if (tipo === 'pdf') { 
                        area.innerHTML = `<span><i class="fas fa-check-circle" style="color:var(--success)"></i> Modelo Salvo!</span>`; 
                    } 
                    else if (tipo === 'audio') { 
                        area.innerHTML = `<span><i class="fas fa-check"></i> Áudio Salvo!</span>`; 
                    } 
                    else { 
                        // Lógica Dinâmica para o Nó de Mídia (Imagens, PDFs e Vídeos)
                        const fileUrl = data.url.toLowerCase();
                        const fileName = data.url.split('/').pop();

                        if (fileUrl.endsWith('.pdf')) {
                            area.innerHTML = `<div style="text-align: center; padding: 10px;">
                                                <i class="fas fa-file-pdf" style="font-size: 24px; color: #ff4757; margin-bottom: 5px;"></i><br>
                                                <span style="font-size: 10px;">${escHtml(fileName.substring(0, 15))}...</span>
                                              </div>`;
                        } 
                        else if (fileUrl.endsWith('.mp4')) {
                            area.innerHTML = `<div style="text-align: center; padding: 10px;">
                                                <i class="fas fa-file-video" style="font-size: 24px; color: #70a1ff; margin-bottom: 5px;"></i><br>
                                                <span style="font-size: 10px;">${escHtml(fileName.substring(0, 15))}...</span>
                                              </div>`;
                        } 
                        else {
                            // É imagem (.jpg, .png, etc) - Mantém o preview visual
                            area.innerHTML = `
                                <span>Substituir</span>
                                <img src="${data.url}" style="display:block; max-height: 100px; margin-top: 5px;">
                            `; 
                            area.querySelector('span').style.display = 'none'; 
                        }
                    }
                }
            } catch (e) { 
                area.innerHTML = '<span>❌ Falha no Upload</span>'; 
                console.error("[SISTEMA] Erro no upload:", e);
                Swal.fire('Upload Falhou', 'Não foi possível enviar o arquivo para o servidor.', 'error');
            }
        }


        // =========================================================
        // 24. SALVAMENTO DO FLUXO NO BANCO DE DADOS
        // Exporta o JSON do canvas e envia para a API
        // =========================================================
        function sincronizarCamposDoDOM() {
            // Sincroniza o estado real da TELA (DOM) para os dados do Drawflow antes de exportar.
            // Garante que checkboxes (ex: Usar emojis) e textos sejam salvos mesmo se algum
            // evento de digitação/clique foi perdido no caminho.
            try {
                document.querySelectorAll('#drawflow .drawflow-node').forEach(nodeEl => {
                    const nodeId = nodeEl.id.replace('node-', '');
                    let nodeData = null;
                    try { nodeData = editor.getNodeFromId(nodeId).data; } catch (e) { return; }
                    if (!nodeData) return;
                    nodeEl.querySelectorAll('input, textarea, select').forEach(inp => {
                        const attr = Array.from(inp.attributes).find(a => a.name.startsWith('df-'));
                        if (!attr) return;
                        const key = attr.name.replace('df-', '');
                        if (inp.type === 'checkbox') {
                            nodeData[key] = inp.checked;
                        } else if (key.startsWith('opcao') && String(inp.value || '').trim() === '') {
                            delete nodeData[key]; // Opção vazia não vira linha em branco no WhatsApp
                        } else {
                            nodeData[key] = inp.value;
                        }
                    });
                    editor.updateNodeDataFromId(nodeId, nodeData);
                });
            } catch (e) { console.warn('[SISTEMA] Sync pré-save falhou:', e); }
        }

        // Fluxo exatamente como está na tela agora (usado por salvar, copiar, exportar e enviar)
        function obterFluxoAtual() {
            sincronizarCamposDoDOM();
            return editor.export();
        }

        async function salvarFluxo() {
            const exportData = obterFluxoAtual();
            const btn = document.querySelector('.btn-save');
            const originalTxt = btn.innerHTML;
            
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Gravando...';
            
            try {
                const res = await fetch(MODO_MODELO ? `/api/fluxos/${idCliente}/fluxo` : `/api/clientes/${idCliente}/fluxo`, { 
                    method: 'POST', 
                    headers: { 'Content-Type': 'application/json' }, 
                    body: JSON.stringify({ fluxo: exportData }) 
                });

                if (res.ok) { 
                    Swal.fire({ 
                        title: 'Fluxo Gravado!', 
                        text: MODO_MODELO ? 'Modelo salvo na biblioteca.' : 'As alterações já estão ativas no robô.',
                        icon: 'success', 
                        timer: 1500, 
                        showConfirmButton: false 
                    }); 
                } else { 
                    throw new Error('Erro na resposta da API'); 
                }
            } catch (e) { 
                console.error("[SISTEMA] Erro ao salvar fluxo:", e);
                Swal.fire('Erro ao Salvar', 'Não foi possível persistir os dados no banco.', 'error'); 
            } finally { 
                btn.innerHTML = originalTxt; 
            }
        }

        // =========================================================
        // 25. GESTÃO DE IMPORTAÇÃO (ARQUIVO OU TEXTO)
        // =========================================================
        async function escolherModoImportacao() {
            const { isConfirmed, isDenied } = await Swal.fire({
                title: 'Importar Fluxo', 
                text: 'Atenção: Isso substituirá o desenho atual da tela.', 
                showCancelButton: true, 
                showDenyButton: true, 
                confirmButtonText: '📂 Arquivo JSON', 
                denyButtonText: '📝 Colar Código', 
                confirmButtonColor: '#00d2ff', 
                denyButtonColor: '#2d2d2d'
            });

            if (isConfirmed) { 
                document.getElementById('fileImport').click(); 
            } else if (isDenied) {
                const { value: text } = await Swal.fire({ 
                    input: 'textarea', 
                    inputLabel: 'Cole o código JSON do fluxo abaixo:', 
                    inputPlaceholder: '{"drawflow": ...}',
                    showCancelButton: true 
                });
                
                if (text) {
                    try { 
                        processarImportacao(JSON.parse(text)); 
                    } catch (e) { 
                        Swal.fire('Erro', 'O código colado não é um JSON válido!', 'error'); 
                    }
                }
            }
        }

        function lerArquivo(input) {
            const file = input.files[0]; 
            if (!file) return;

            const reader = new FileReader(); 
            reader.onload = (e) => { 
                try { 
                    processarImportacao(JSON.parse(e.target.result)); 
                } catch (err) { 
                    Swal.fire('Erro', 'O arquivo selecionado está corrompido ou é inválido.', 'error'); 
                } 
            }; 
            reader.readAsText(file); 
            input.value = ''; // Limpa o input para permitir re-importação do mesmo arquivo
        }

        function processarImportacao(json) {
            // 1. Limpa o canvas atual
            editor.clear(); 
            
            // 2. Ajusta os templates para a versão atual do sistema
            json = sanitizarJson(json); 

            // 3. Importa com um pequeno delay para garantir o reset do canvas
            setTimeout(() => { 
                try { 
                    editor.import(json); 
                    
                    // 4. Aguarda o desenho e restaura os previews visuais
                    setTimeout(restoreData, 100); 
                    
                    Swal.fire({ 
                        icon: 'success', 
                        title: 'Importado com Sucesso!', 
                        timer: 1000, 
                        showConfirmButton: false 
                    }); 
                } catch (e) { 
                    console.error("[SISTEMA] Falha na importação:", e); 
                    Swal.fire('Erro Crítico', 'Falha ao processar o desenho do fluxo.', 'error'); 
                } 
            }, 50);
        }

        // =========================================================
        // 27. MODAL INFORMATIVO: ENGENHARIA DE VARIÁVEIS
        // Explica ao usuário como usar os gatilhos e os campos v1-v10
        // =========================================================
        function mostrarVariaveis() {
            Swal.fire({
                title: `
                    <span style="color: #fff; font-size: 18px;">
                        🧠 Engenharia de Variáveis V12
                    </span>
                `,
                html: `
                    <div style="text-align: left; color: #aaa; font-size: 13px; line-height: 1.6;">
                        <p>As variáveis capturam as respostas no nó de <b>Pergunta</b>. O sistema divide essas chaves em duas categorias:</p>
                        
                        <div style="margin-top: 10px; padding: 10px; background: rgba(255, 255, 255, 0.05); border-radius: 6px; border-left: 3px solid #888;">
                            <b style="color: #fff;">1️⃣ Campos Personalizados (v1 a v10)</b><br>
                            Use os slots de <code>v1</code> até <code>v10</code> para memorizar qualquer resposta e repeti-la no meio de uma mensagem ou contrato. <br>
                            <i>Ex: "Entendi, a cor escolhida foi {{v1}}."</i>
                        </div>

                        <div style="margin-top: 10px; padding: 10px; background: rgba(168, 85, 247, 0.1); border: 1px solid var(--accent); border-radius: 6px; border-left: 3px solid var(--accent);">
                            <b style="color: var(--accent);">2️⃣ Variáveis Reservadas (Gatilhos)</b><br>
                            Nomes obrigatórios que ativam os motores automáticos do servidor:
                            <ul style="margin: 5px 0 0 20px; padding: 0;">
                                <li><code>telefone</code> ➔ Link Wa.me no Transbordo Humano.</li>
                                <li><code>cpf_usuario</code> ➔ Exigido para Gerar Contratos (PDF).</li>
                                <li><code>data_agendamento</code> ➔ Mostra os dias e horários livres da agenda. O cliente escolhe pelo número, digita a data (ex: 25/11 14:30) ou abre o calendário pelo link. Já confirma e agenda o lembrete.</li>
                            </ul>
                        </div>

                        <hr style="border: 0; border-top: 1px solid #333; margin: 15px 0;">

                        <b style="color: #fff;">🏆 A Sequência de Ouro (Funil de Vendas):</b><br>
                        Para máxima eficiência até a geração do documento, use esta ordem:
                        <div style="background: #222; padding: 12px; border-radius: 8px; margin-top: 8px; font-family: monospace; color: #ddd; border-left: 3px solid #10b981;">
                            1. Nome? ➔ <code>nome_cliente</code><br>
                            2. CPF? ➔ <code>cpf_usuario</code><br>
                            3. WhatsApp? ➔ <code>telefone_lembrete</code><br>
                            4. Data? ➔ <code>data_agendamento</code>
                        </div>

                        <div style="margin-top: 15px; font-size: 12px; color: #fbbf24;">
                            <b>⚡ Dica de Menu:</b> Se usar menus, você pode citar a opção escolhida usando <code>{{opcao_1}}</code>, <code>{{opcao_2}}</code>, etc.
                        </div>
                    </div>
                `,
                background: '#18181b',
                confirmButtonColor: 'var(--accent)',
                confirmButtonText: 'Dominado! 🚀',
                width: '650px',
                customClass: { 
                    popup: 'border-node' 
                }
            });
        }
    </script>
    <script>
    // =========================================================
    // 30. BIBLIOTECA DE FLUXOS: importar, copiar, exportar e enviar
    // O menu "Fluxos" do topo chama as funções expostas em window.
    // =========================================================
    (function () {
        const NOME_FLUXO = (document.getElementById('nome-fluxo') || {}).value || 'fluxo';
        const menu = document.getElementById('fluxos-menu');
        const TEMA = { background: '#18181b', color: '#e0e0e0', confirmButtonColor: '#00d2ff', customClass: { popup: 'fx-popup' } };

        const esc = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        const slug = (t) => String(t || 'fluxo').normalize('NFD').replace(/[̀-ͯ]/g, '')
            .replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-+|-+$/g, '').toLowerCase().substring(0, 50) || 'fluxo';
        const dataDe = (fluxo) => (fluxo && fluxo.drawflow && fluxo.drawflow.Home && fluxo.drawflow.Home.data) || {};
        const temNos = (fluxo) => Object.keys(dataDe(fluxo)).length > 0;

        // ---------- Menu ----------
        window.toggleMenuFluxos = (ev) => { ev.stopPropagation(); menu.classList.toggle('aberto'); };
        document.addEventListener('click', () => menu.classList.remove('aberto'));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') menu.classList.remove('aberto'); });

        // ---------- Utilitários ----------
        async function chamar(url, metodo = 'GET', corpo) {
            try {
                const res = await fetch(url, {
                    method: metodo,
                    headers: corpo ? { 'Content-Type': 'application/json' } : undefined,
                    body: corpo ? JSON.stringify(corpo) : undefined
                });
                const dados = await res.json().catch(() => ({ success: false, error: 'Sessão expirada. Entre novamente em outra aba e tente de novo.' }));
                return { ok: res.ok && dados.success !== false, dados };
            } catch (e) {
                return { ok: false, dados: { error: 'Sem conexão com o servidor.' } };
            }
        }
        const erro = (msg) => Swal.fire({ ...TEMA, icon: 'error', title: 'Não foi possível', text: msg || 'Tente novamente.' });
        const aviso = (titulo, texto) => Swal.fire({ ...TEMA, icon: 'info', title: titulo, text: texto });

        async function copiarTexto(texto) {
            try { await navigator.clipboard.writeText(texto); return true; }
            catch (e) {
                const t = document.createElement('textarea');
                t.value = texto; t.style.position = 'fixed'; t.style.opacity = '0';
                document.body.appendChild(t); t.select();
                let ok = false;
                try { ok = document.execCommand('copy'); } catch (_) {}
                t.remove();
                return ok;
            }
        }

        // ---------- Copiar ----------
        window.copiarFluxo = async () => {
            const fluxo = obterFluxoAtual();
            if (!temNos(fluxo)) return aviso('Fluxo vazio', 'Monte ao menos um bloco antes de copiar.');
            const texto = JSON.stringify(fluxo);
            if (await copiarTexto(texto)) {
                Swal.fire({ ...TEMA, icon: 'success', title: 'Fluxo copiado', text: 'Cole em "Importar arquivo ou código" no editor de qualquer bot.', timer: 2600, showConfirmButton: false });
            } else {
                Swal.fire({ ...TEMA, title: 'Copie o código abaixo', html: `<textarea class="swal2-textarea" readonly style="height:180px;font-size:11px">${esc(texto)}</textarea>`,
                    didOpen: (el) => el.querySelector('textarea').select() });
            }
        };

        // ---------- Exportar ----------
        window.exportarFluxo = () => {
            const fluxo = obterFluxoAtual();
            if (!temNos(fluxo)) return aviso('Fluxo vazio', 'Monte ao menos um bloco antes de exportar.');
            const blob = new Blob([JSON.stringify(fluxo, null, 2)], { type: 'application/json' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = slug(NOME_FLUXO) + '.json';
            document.body.appendChild(a); a.click(); a.remove();
            setTimeout(() => URL.revokeObjectURL(a.href), 1000);
        };

        // ---------- Importar da biblioteca ----------
        window.importarDaBiblioteca = async () => {
            const r = await chamar('/api/fluxos');
            if (!r.ok) return erro(r.dados.error);
            const lista = r.dados.modelos.filter(m => !(MODO_MODELO && m.id === idCliente));

            Swal.fire({
                ...TEMA, title: 'Importar da biblioteca', width: 560, showConfirmButton: false, showCloseButton: true,
                html: '<input type="search" class="lib-busca" placeholder="Buscar fluxo" aria-label="Buscar fluxo"><div class="lib-lista"></div>',
                didOpen: (el) => {
                    const caixa = el.querySelector('.lib-lista');
                    const busca = el.querySelector('.lib-busca');
                    const desenhar = () => {
                        const termo = busca.value.trim().toLowerCase();
                        caixa.replaceChildren();
                        const filtrados = lista.filter(m => !termo || m.nome.toLowerCase().includes(termo));
                        if (!filtrados.length) {
                            const vazio = document.createElement('div');
                            vazio.className = 'lib-vazio';
                            vazio.textContent = lista.length ? 'Nenhum fluxo com esse nome.' : 'Sua biblioteca está vazia. Crie fluxos em Meus Fluxos, no dashboard.';
                            caixa.appendChild(vazio);
                            return;
                        }
                        filtrados.forEach(m => {
                            const b = document.createElement('button');
                            b.type = 'button'; b.className = 'lib-item'; b.disabled = m.totalNos === 0;
                            const nome = document.createElement('strong'); nome.textContent = m.nome;
                            const info = document.createElement('small');
                            info.textContent = (m.totalNos === 0 ? 'Vazio' : `${m.totalNos} blocos`) + (m.descricao ? ` - ${m.descricao}` : '');
                            b.append(nome, info);
                            b.onclick = () => { Swal.close(); escolherComoImportar(m); };
                            caixa.appendChild(b);
                        });
                    };
                    busca.oninput = desenhar;
                    desenhar();
                    busca.focus();
                }
            });
        };

        async function escolherComoImportar(m) {
            const tela = obterFluxoAtual();
            let modo = 'substituir';
            if (temNos(tela)) {
                const r = await Swal.fire({
                    ...TEMA, title: 'Importar fluxo',
                    html: `O que fazer com o desenho que está na tela?<br><small style="color:#a1a1aa">Fluxo escolhido: ${esc(m.nome)}</small>`,
                    showDenyButton: true, showCancelButton: true,
                    confirmButtonText: 'Substituir tudo', denyButtonText: 'Acrescentar', cancelButtonText: 'Cancelar',
                    denyButtonColor: '#a855f7'
                });
                if (r.isDismissed) return;
                modo = r.isDenied ? 'acrescentar' : 'substituir';
            }
            const resp = await chamar(`/api/fluxos/${m.id}`);
            if (!resp.ok) return erro(resp.dados.error);
            if (modo === 'substituir') processarImportacao(resp.dados.fluxo);
            else acrescentarFluxo(resp.dados.fluxo);
        }

        // Junta o fluxo escolhido ao desenho atual: renumera os blocos novos, ajusta as
        // conexões e coloca tudo abaixo do que já está na tela. O bloco "Início" do fluxo
        // importado é omitido quando a tela já tem um (o motor usa um único início).
        function acrescentarFluxo(entrada) {
            const antes = JSON.parse(JSON.stringify(obterFluxoAtual()));
            const atual = JSON.parse(JSON.stringify(antes));
            const dataAtual = dataDe(atual);
            const novo = JSON.parse(JSON.stringify(entrada));
            const dataNovo = dataDe(novo);

            const temInicio = Object.values(dataAtual).some(n => n.name === 'inicio');
            const descartados = Object.keys(dataNovo).filter(id => temInicio && dataNovo[id].name === 'inicio');
            const restantes = Object.keys(dataNovo).filter(id => !descartados.includes(id));
            if (!restantes.length) return aviso('Nada para acrescentar', 'Esse fluxo só tem o bloco de início.');

            const maxId = Math.max(0, ...Object.keys(dataAtual).map(Number).filter(Number.isFinite));
            const ys = Object.values(dataAtual).map(n => Number(n.pos_y) || 0);
            const baseY = (ys.length ? Math.max(...ys) : 0) + 260;
            const minY = Math.min(...restantes.map(id => Number(dataNovo[id].pos_y) || 0));
            const dy = baseY - minY;

            const mapa = {};
            let prox = maxId;
            restantes.forEach(id => { mapa[id] = String(++prox); });

            const remapear = (portas) => Object.values(portas || {}).forEach(p => {
                p.connections = (p.connections || [])
                    .filter(c => mapa[c.node] !== undefined)
                    .map(c => ({ ...c, node: mapa[c.node] }));
            });
            restantes.forEach(id => {
                const n = dataNovo[id];
                n.id = Number(mapa[id]);
                n.pos_y = (Number(n.pos_y) || 0) + dy;
                remapear(n.inputs); remapear(n.outputs);
                dataAtual[mapa[id]] = n;
            });

            editor.clear();
            setTimeout(() => {
                try {
                    editor.import(sanitizarJson(atual));
                    setTimeout(restoreData, 100);
                    Swal.fire({
                        ...TEMA, icon: 'success', title: 'Fluxo acrescentado',
                        text: descartados.length
                            ? 'Os blocos entraram abaixo do desenho atual. O início do fluxo importado foi omitido: ligue o seu início ao primeiro bloco novo.'
                            : 'Os blocos entraram abaixo do desenho atual.'
                    });
                } catch (e) {
                    console.error('[SISTEMA] Falha ao acrescentar fluxo:', e);
                    try { editor.clear(); editor.import(sanitizarJson(antes)); setTimeout(restoreData, 100); } catch (_) {}
                    erro('Não consegui acrescentar esse fluxo. Seu desenho foi mantido.');
                }
            }, 50);
        }

        // ---------- Enviar ----------
        window.enviarFluxo = () => {
            const fluxo = obterFluxoAtual();
            if (!temNos(fluxo)) return aviso('Fluxo vazio', 'Monte ao menos um bloco antes de enviar.');
            const destinos = {
                biblioteca: () => salvarNaBiblioteca(fluxo),
                bot: () => aplicarEmBot(fluxo),
                usuario: () => enviarParaUsuario(fluxo),
                link: () => gerarLink(fluxo)
            };
            Swal.fire({
                ...TEMA, title: 'Enviar fluxo', showConfirmButton: false, showCloseButton: true,
                html: `<div class="opcoes-envio">
                         <button type="button" class="opcao-envio" data-destino="biblioteca"><i class="fas fa-book-open"></i><div><b>${MODO_MODELO ? 'Salvar como novo modelo' : 'Salvar na biblioteca'}</b><span>Guarda uma cópia do que está na tela em Meus Fluxos.</span></div></button>
                         <button type="button" class="opcao-envio" data-destino="bot"><i class="fas fa-robot"></i><div><b>Aplicar em outro bot</b><span>O bot escolhido passa a usar este fluxo agora.</span></div></button>
                         <button type="button" class="opcao-envio" data-destino="usuario"><i class="fas fa-user-plus"></i><div><b>Enviar para outro usuário</b><span>Ele recebe uma cópia e escolhe se aceita.</span></div></button>
                         <button type="button" class="opcao-envio" data-destino="link"><i class="fas fa-link"></i><div><b>Gerar link</b><span>Quem tiver o link e uma conta adiciona uma cópia.</span></div></button>
                       </div>`,
                didOpen: (el) => el.querySelectorAll('[data-destino]').forEach(b => {
                    b.onclick = () => { Swal.close(); destinos[b.dataset.destino](); };
                })
            });
        };

        async function pedirNome(titulo, botao, aviso) {
            const padrao = MODO_MODELO ? `Cópia de ${NOME_FLUXO}` : NOME_FLUXO;
            const r = await Swal.fire({
                ...TEMA, title: titulo,
                html: `<label class="fx-rotulo" for="fx-nome">Nome do fluxo</label>
                       <input id="fx-nome" class="swal2-input" maxlength="100" value="${esc(padrao)}">
                       <label class="fx-rotulo" for="fx-desc">Descrição (opcional)</label>
                       <textarea id="fx-desc" class="swal2-textarea" maxlength="300"></textarea>
                       ${aviso ? `<p class="fx-aviso">${esc(aviso)}</p>` : ''}`,
                showCancelButton: true, confirmButtonText: botao, cancelButtonText: 'Cancelar', focusConfirm: false,
                preConfirm: () => {
                    const nome = document.getElementById('fx-nome').value.trim();
                    if (!nome) { Swal.showValidationMessage('Dê um nome ao fluxo.'); return false; }
                    return { nome, descricao: document.getElementById('fx-desc').value.trim() };
                }
            });
            return r.isConfirmed ? r.value : null;
        }

        async function salvarNaBiblioteca(fluxo) {
            const info = await pedirNome('Salvar na biblioteca', 'Salvar');
            if (!info) return;
            const r = await chamar('/api/fluxos', 'POST', { ...info, fluxo });
            if (!r.ok) return erro(r.dados.error);
            Swal.fire({ ...TEMA, icon: 'success', title: 'Salvo na biblioteca', text: 'Ele já aparece em Meus Fluxos.', timer: 2000, showConfirmButton: false });
        }

        async function aplicarEmBot(fluxo) {
            const r = await chamar('/api/fluxos/clientes');
            if (!r.ok) return erro(r.dados.error);
            const bots = r.dados.clientes.filter(c => MODO_MODELO || c.id !== idCliente);
            if (!bots.length) return aviso('Nenhum outro bot', 'Você não tem outros bots para receber este fluxo.');

            const resp = await Swal.fire({
                ...TEMA, title: 'Aplicar em outro bot',
                html: `<label class="fx-rotulo" for="fx-bot">Bot</label>
                       <select id="fx-bot" class="swal2-select">${bots.map(c => `<option value="${esc(c.id)}">${esc(c.nome)}</option>`).join('')}</select>
                       <label class="fx-check"><input type="checkbox" id="fx-backup" checked> Guardar o fluxo atual desse bot na biblioteca (backup)</label>
                       <p class="fx-aviso">O fluxo que está no bot escolhido será substituído pelo que está na tela.</p>`,
                showCancelButton: true, confirmButtonText: 'Aplicar', cancelButtonText: 'Cancelar',
                preConfirm: () => ({ clienteId: document.getElementById('fx-bot').value, backup: document.getElementById('fx-backup').checked })
            });
            if (!resp.isConfirmed) return;
            const env = await chamar('/api/fluxos/enviar/cliente', 'POST', { fluxo, ...resp.value });
            if (!env.ok) return erro(env.dados.error);
            Swal.fire({
                ...TEMA, icon: 'success', title: 'Fluxo aplicado',
                text: `${env.dados.cliente} já está usando este fluxo.` + (env.dados.backupFeito ? ' O fluxo anterior foi guardado na biblioteca.' : '')
            });
        }

        async function enviarParaUsuario(fluxo) {
            const resp = await Swal.fire({
                ...TEMA, title: 'Enviar para outro usuário',
                html: `<label class="fx-rotulo" for="fx-email">E-mail da conta</label>
                       <input id="fx-email" type="email" class="swal2-input" placeholder="nome@exemplo.com">
                       <label class="fx-rotulo" for="fx-nome">Nome do fluxo</label>
                       <input id="fx-nome" class="swal2-input" maxlength="100" value="${esc(NOME_FLUXO)}">`,
                showCancelButton: true, confirmButtonText: 'Enviar', cancelButtonText: 'Cancelar', focusConfirm: false,
                preConfirm: () => {
                    const email = document.getElementById('fx-email').value.trim();
                    const nome = document.getElementById('fx-nome').value.trim();
                    if (!email) { Swal.showValidationMessage('Informe o e-mail.'); return false; }
                    if (!nome) { Swal.showValidationMessage('Dê um nome ao fluxo.'); return false; }
                    return { email, nome };
                }
            });
            if (!resp.isConfirmed) return;
            const env = await chamar('/api/fluxos/enviar/usuario', 'POST', { fluxo, ...resp.value });
            if (!env.ok) return erro(env.dados.error);
            Swal.fire({ ...TEMA, icon: 'success', title: 'Fluxo enviado', text: `${env.dados.destinatario} vai ver o fluxo na caixa "Recebidos" da biblioteca.` });
        }

        async function gerarLink(fluxo) {
            let corpo;
            if (MODO_MODELO) {
                // O link entrega o modelo salvo: grava o que está na tela antes.
                const s = await chamar(`/api/fluxos/${idCliente}/fluxo`, 'POST', { fluxo });
                if (!s.ok) return erro(s.dados.error);
                corpo = { modeloId: idCliente };
            } else {
                const info = await pedirNome('Gerar link', 'Gerar link', 'Uma cópia fica guardada na sua biblioteca para manter o link ativo.');
                if (!info) return;
                corpo = { ...info, fluxo };
            }
            const r = await chamar('/api/fluxos/enviar/link', 'POST', corpo);
            if (!r.ok) return erro(r.dados.error);

            const resp = await Swal.fire({
                ...TEMA, title: 'Link de compartilhamento',
                html: `<input id="fx-link" class="swal2-input" readonly value="${esc(r.dados.url)}">
                       <p class="fx-aviso" style="color:#a1a1aa">O link sempre entrega a versão mais recente do fluxo. Para desativar, use Meus Fluxos.</p>`,
                showCancelButton: true, confirmButtonText: 'Copiar link', cancelButtonText: 'Fechar',
                didOpen: () => document.getElementById('fx-link').select()
            });
            if (resp.isConfirmed) {
                const ok = await copiarTexto(r.dados.url);
                Swal.fire({ ...TEMA, icon: ok ? 'success' : 'info', title: ok ? 'Link copiado' : 'Copie o link manualmente', text: ok ? '' : r.dados.url, timer: ok ? 1400 : undefined, showConfirmButton: !ok });
            }
        }
    })();
    </script>
</body>
</html>