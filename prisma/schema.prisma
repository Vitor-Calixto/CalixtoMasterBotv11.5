// ARQUIVO: prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Use "sqlite" se preferir, mas mantenha consistente
  url      = env("DATABASE_URL")
}

model Cliente {
  id        String   @id @default(uuid())
  nome      String
  numero    String?  @unique // Isso impede números repetidos!
  ativo     Boolean  @default(true)
  fluxoJson Json?
  status    String   @default("OFFLINE")
  criadoEm  DateTime @default(now())

  // O SEGREDO ESTÁ AQUI: onDelete: Cascade
  contatos      Contato[]
  sessoesAtivas SessaoAtiva[]
}

model SessaoAtiva {
  id        String   @id @default(uuid())
  clienteId String
  chatId    String
  noAtual   String
  dados     Json?
  updatedAt DateTime @updatedAt

  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, chatId])
}

model Contato {
  id        String   @id @default(uuid())
  remoteJid String
  nome      String?
  clienteId String
  criadoEm  DateTime @default(now())

  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  mensagens Mensagem[]
}

model Mensagem {
  id        String   @id @default(uuid())
  texto     String
  tipo      String   @default("texto")
  fromMe    Boolean
  contatoId String
  criadoEm  DateTime @default(now())

  contato   Contato  @relation(fields: [contatoId], references: [id], onDelete: Cascade)
}