<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calixto OmniSystem</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body { background-color: #0f0f12; color: #e0e0e0; font-family: 'Inter', sans-serif; }
        .card-client { background: #18181b; border: 1px solid #27272a; border-radius: 12px; padding: 20px; margin-bottom: 20px; }
        .status-online { color: #22c55e; }
        .status-offline { color: #ef4444; }
        .form-control-dark { background: #27272a; border: 1px solid #3f3f46; color: #fff; }
        .form-control-dark:focus { background: #27272a; color: #fff; border-color: #00d2ff; }
        .modal-content { background: #18181b; border: 1px solid #333; color: #fff; }
    </style>
</head>
<body>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-rocket"></i> Calixto OmniSystem</h2>

        <form action="/api/clientes" method="POST">
            <button class="btn btn-primary">
                <i class="fas fa-plus"></i> Novo Cliente
            </button>
        </form>
    </div>

    <div class="row">
        <% clientes.forEach(cliente => { %>
        <div class="col-md-4">
            <div class="card-client">

                <div class="d-flex justify-content-between mb-3">
                    <h5><%= cliente.nome %></h5>

                    <div class="form-check form-switch">
                        <input
                            class="form-check-input"
                            type="checkbox"
                            onchange="toggleBot('<%= cliente.id %>')"
                            <%= cliente.status === 'online' ? 'checked' : '' %>
                        >
                    </div>
                </div>

                <p>
                    Status:
                    <span class="<%= cliente.status === 'online' ? 'status-online' : 'status-offline' %>">
                        ● <%= cliente.status %>
                    </span>
                </p>

                <!-- WHATSAPP / NÚMERO -->
                <div class="mb-3">
                    <label class="small text-muted">WhatsApp</label>

                    <div class="input-group">
                        <input
                            type="text"
                            class="form-control form-control-dark"
                            value="<%= cliente.numero || 'Sem número' %>"
                            disabled
                        >
                        <button
                            class="btn btn-outline-secondary"
                            data-bs-toggle="modal"
                            data-bs-target="#editModal<%= cliente.id %>"
                        >
                            <i class="fas fa-pen"></i>
                        </button>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <a
                        href="/clientes/<%= cliente.id %>/editor"
                        class="btn btn-outline-primary"
                    >
                        <i class="fas fa-project-diagram"></i> Editar Fluxo
                    </a>

                    <form
                        action="/api/clientes/<%= cliente.id %>/delete"
                        method="POST"
                        onsubmit="return confirm('Deletar?')"
                        class="d-grid"
                    >
                        <button class="btn btn-outline-danger">
                            <i class="fas fa-trash"></i> Deletar
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- MODAL DE EDIÇÃO -->
        <div class="modal fade" id="editModal<%= cliente.id %>" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">

                    <form action="/api/clientes/<%= cliente.id %>" method="POST">
                        <div class="modal-header">
                            <h5 class="modal-title">Editar <%= cliente.nome %></h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>

                        <div class="modal-body">
                            <div class="mb-3">
                                <label>Nome</label>
                                <input
                                    type="text"
                                    name="nome"
                                    class="form-control form-control-dark"
                                    value="<%= cliente.nome %>"
                                    required
                                >
                            </div>

                            <div class="mb-3">
                                <label>WhatsApp (Ex: 552199999999)</label>
                                <input
                                    type="text"
                                    name="whatsapp"
                                    class="form-control form-control-dark"
                                    value="<%= cliente.numero || '' %>"
                                    required
                                >
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">
                                Salvar
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
        <% }) %>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
async function toggleBot(id) {
    await fetch(`/api/clientes/${id}/toggle`, { method: 'POST' });
    window.location.reload();
}
</script>

</body>
</html>
