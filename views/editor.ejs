<!DOCTYPE html>
<html lang="pt-br">
    <!DOCTYPE html>
    <html lang="pt-br">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>Editor High-Ticket - Calixto OmniSystem</title>
        
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/jerosoler/Drawflow/dist/drawflow.min.css">
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
            <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
        
            <style>
        
                /* ========================================================= */
                /* 2. VARIÁVEIS DE COR E RESET GLOBAL                        */
                /* ========================================================= */
                :root { 
                    --bg-canvas: #121212; 
                    --bg-node: #1e1e1e; 
                    --border-node: #333; 
                    --accent: #00d2ff; 
                    --input: #a855f7; 
                    --doc: #f59e0b; 
                    --text-main: #e0e0e0; 
                    --danger: #ff4444; 
                    --success: #00c851; 
                }
        
                body { 
                    margin: 0; 
                    font-family: 'Inter', sans-serif; 
                    background: var(--bg-canvas); 
                    color: var(--text-main); 
                    overflow: hidden; 
                }
        
                /* ========================================================= */
                /* 3. LAYOUT DA TELA (SIDEBAR E BARRA SUPERIOR)              */
                /* ========================================================= */
                .sidebar { 
                    position: fixed; 
                    top: 0; 
                    left: 0; 
                    width: 260px; 
                    height: 100vh; 
                    background: #18181b; 
                    border-right: 1px solid #27272a; 
                    z-index: 5000; 
                    padding: 20px; 
                    overflow-y: auto; 
                }
        
                .top-bar { 
                    position: fixed; 
                    top: 20px; 
                    right: 20px; 
                    z-index: 5000; 
                    display: flex; 
                    gap: 10px; 
                }
        
                /* Botões do Topo */
                .btn-base { 
                    padding: 10px 20px; 
                    border-radius: 8px; 
                    font-weight: 600; 
                    cursor: pointer; 
                    display: flex; 
                    align-items: center; 
                    gap: 8px; 
                    border: none; 
                    font-size: 13px; 
                    transition: 0.2s; 
                }
        
                .btn-back { 
                    background: #333; 
                    color: #fff; 
                    border: 1px solid #444; 
                    text-decoration: none;
                } 
        
                .btn-import { 
                    background: #2a2a2a; 
                    color: #fff; 
                    border: 1px solid #404040; 
                }
        
                .btn-save { 
                    background: var(--accent); 
                    color: #000; 
                    box-shadow: 0 4px 12px rgba(0, 210, 255, 0.2); 
                }
        
                .btn-save:hover { 
                    filter: brightness(1.1); 
                    transform: translateY(-1px); 
                }
        
                /* ========================================================= */
                /* 4. ITENS DA SIDEBAR (BLOCOS PARA ARRASTAR)                */
                /* ========================================================= */
                .node-item { 
                    display: flex; 
                    align-items: center; 
                    background: #27272a; 
                    padding: 12px; 
                    margin-bottom: 8px; 
                    border-radius: 8px; 
                    cursor: grab; 
                    border: 1px solid transparent; 
                    transition: all 0.2s; 
                    font-size: 13px; 
                    font-weight: 500; 
                    user-select: none; 
                }
        
                .node-item:hover { 
                    border-color: var(--accent); 
                    background: #3f3f46; 
                    transform: translateX(4px); 
                }
        
                .node-item i { 
                    margin-right: 12px; 
                    width: 20px; 
                    text-align: center; 
                    color: #aaa; 
                }
        
                /* Destaques visuais para os nós avançados na sidebar */
                .node-item[data-node="pergunta"] { 
                    border-left: 3px solid var(--input); 
                }
        
                .node-item[data-node="gerar_documento"] { 
                    border-left: 3px solid var(--doc); 
                }
        
                /* ========================================================= */
                /* 5. CANVAS PRINCIPAL E NÓS DO DRAWFLOW                     */
                /* ========================================================= */
                #drawflow { 
                    position: absolute; 
                    top: 0; 
                    left: 0; 
                    width: 100vw; 
                    height: 100vh; 
                    background: var(--bg-canvas); 
                    background-image: radial-gradient(#333 1px, transparent 1px); 
                    background-size: 20px 20px; 
                    z-index: 0; 
                }
        
                .drawflow .drawflow-node { 
                    background: var(--bg-node); 
                    border: 1px solid var(--border-node); 
                    width: 320px; 
                    border-radius: 12px; 
                    padding: 0; 
                    box-shadow: 0 10px 20px rgba(0,0,0,0.4); 
                    display: flex; 
                    flex-direction: column; 
                    z-index: 2; 
                }
        
                .drawflow-node.selected { 
                    border-color: var(--accent); 
                    box-shadow: 0 0 0 2px rgba(0, 210, 255, 0.3); 
                }
        
                .drawflow-node .title { 
                    padding: 12px 16px; 
                    border-bottom: 1px solid #333; 
                    font-weight: 600; 
                    font-size: 14px; 
                    border-radius: 12px 12px 0 0; 
                    display: flex; 
                    align-items: center; 
                    gap: 10px; 
                    background: #27272a; 
                    height: 46px; 
                    box-sizing: border-box; 
                }
        
                .drawflow-node .drawflow_content_node { 
                    padding: 16px; 
                    flex-grow: 1; 
                    position: relative; 
                }
        
                /* Bolinhas de Conexão (Inputs e Outputs) */
                .drawflow-node .inputs { 
                    position: absolute !important; 
                    left: -14px !important; 
                    top: 18px !important; 
                    z-index: 100; 
                }
        
                .drawflow-node .outputs { 
                    position: absolute !important; 
                    top: 0 !important; 
                    right: -14px !important; 
                    bottom: 0 !important; 
                    height: 100% !important; 
                    width: 0px !important; 
                    display: block !important; 
                    z-index: 100; 
                }
        
                .drawflow-node .output { 
                    position: absolute !important; 
                    right: 0 !important; 
                    width: 14px; 
                    height: 14px; 
                    background: #fff; 
                    border: 2px solid #000; 
                    border-radius: 50%; 
                    cursor: crosshair; 
                    margin: 0 !important; 
                    transform: translateY(-50%); 
                }
        
                .drawflow-node .input:hover, 
                .drawflow-node .output:hover { 
                    transform: translateY(-50%) scale(1.3); 
                    border-color: var(--accent); 
                }
        
                .drawflow-node .input:hover { 
                    transform: scale(1.3); 
                }
        
                /* ========================================================= */
                /* 6. COMPONENTES INTERNOS DOS NÓS (FORMULÁRIOS E UI)        */
                /* ========================================================= */
                label { 
                    display: block; 
                    font-size: 11px; 
                    font-weight: 600; 
                    color: #888; 
                    margin-bottom: 6px; 
                    text-transform: uppercase; 
                }
        
                input[type="text"], 
                input[type="number"], 
                input[type="time"], 
                textarea, 
                select { 
                    width: 100%; 
                    background: #2d2d2d; 
                    border: 1px solid #404040; 
                    color: white; 
                    padding: 10px; 
                    border-radius: 6px; 
                    box-sizing: border-box; 
                    font-family: inherit; 
                    font-size: 13px; 
                    outline: none; 
                }
        
                input:focus, 
                textarea:focus, 
                select:focus { 
                    border-color: var(--accent); 
                    background: #333; 
                }
        
                textarea { 
                    resize: vertical; 
                    min-height: 80px; 
                    line-height: 1.5; 
                }
        
                .var-tag { 
                    background: rgba(168, 85, 247, 0.2); 
                    color: var(--input); 
                    padding: 2px 6px; 
                    border-radius: 4px; 
                    font-size: 10px; 
                    font-family: monospace; 
                    border: 1px solid rgba(168, 85, 247, 0.4); 
                }
        
                /* UI do Nó de Menu (Opções Dinâmicas) */
                .menu-list { 
                    display: flex; 
                    flex-direction: column; 
                    gap: 8px; 
                    margin-bottom: 12px; 
                }
        
                .menu-item { 
                    display: flex; 
                    align-items: center; 
                    gap: 8px; 
                    position: relative; 
                    background: #27272a; 
                    border-radius: 6px; 
                    padding: 4px; 
                    border: 1px solid #3f3f46; 
                }
        
                .menu-handle { 
                    color: #555; 
                    cursor: grab; 
                    padding: 0 4px; 
                }
        
                .menu-item input { 
                    border: none; 
                    background: transparent; 
                    padding: 6px; 
                    margin: 0; 
                }
        
                .btn-del-opt { 
                    color: var(--danger); 
                    cursor: pointer; 
                    padding: 6px; 
                    opacity: 0.6; 
                    font-size: 12px; 
                }
        
                .btn-add-option { 
                    font-size: 13px; 
                    color: var(--accent); 
                    cursor: pointer; 
                    font-weight: 600; 
                    display: inline-flex; 
                    align-items: center; 
                    gap: 5px; 
                    margin: 10px 0; 
                    width: fit-content; 
                }
        
                .settings-group { 
                    border-top: 1px solid #333; 
                    padding-top: 15px; 
                    margin-top: 10px; 
                    display: flex; 
                    flex-direction: column; 
                    gap: 12px; 
                }
        
                /* Botões de Switch (Ligar/Desligar) */
                .toggle-row { 
                    display: flex; 
                    align-items: center; 
                    gap: 12px; 
                    font-size: 13px; 
                    cursor: pointer; 
                }
        
                .switch { 
                    position: relative; 
                    width: 36px; 
                    height: 20px; 
                }
        
                .switch input { 
                    opacity: 0; 
                    width: 0; 
                    height: 0; 
                }
        
                .slider { 
                    position: absolute; 
                    cursor: pointer; 
                    top: 0; 
                    left: 0; 
                    right: 0; 
                    bottom: 0; 
                    background-color: #404040; 
                    transition: .4s; 
                    border-radius: 34px; 
                }
        
                .slider:before { 
                    position: absolute; 
                    content: ""; 
                    height: 16px; 
                    width: 16px; 
                    left: 2px; 
                    bottom: 2px; 
                    background-color: white; 
                    transition: .4s; 
                    border-radius: 50%; 
                }
        
                input:checked + .slider { 
                    background-color: var(--accent); 
                }
        
                input:checked + .slider:before { 
                    transform: translateX(16px); 
                }
        
                /* Área de Upload (Mídia/Áudio) */
                .upload-area { 
                    border: 2px dashed #444; 
                    background: #222; 
                    padding: 20px; 
                    text-align: center; 
                    border-radius: 8px; 
                    cursor: pointer; 
                    transition: 0.2s;
                }
        
                .upload-area:hover { 
                    border-color: #666; 
                    background: #2a2a2a; 
                }
        
                .upload-area img { 
                    max-width: 100%; 
                    border-radius: 4px; 
                    display: block; 
                    margin: 10px auto 0; 
                }
                /* ========================================================= */
                /* BIBLIOTECA DE FLUXOS: menu "Fluxos" e janelas             */
                /* ========================================================= */
                .menu-wrap { position: relative; }
                .fluxos-menu {
                    display: none; position: absolute; top: calc(100% + 8px); right: 0;
                    min-width: 250px; background: #18181b; border: 1px solid #333;
                    border-radius: 10px; padding: 6px; box-shadow: 0 12px 30px rgba(0,0,0,0.5); z-index: 6000;
                }
                .fluxos-menu.aberto { display: block; }
                .fluxos-menu button {
                    display: flex; width: 100%; align-items: center; gap: 10px; background: transparent;
                    border: 0; color: var(--text-main); padding: 10px 12px; border-radius: 6px;
                    font: inherit; font-size: 13px; cursor: pointer; text-align: left;
                }
                .fluxos-menu button:hover { background: #27272a; }
                .fluxos-menu button i { width: 16px; text-align: center; color: var(--accent); }
                .fluxos-menu hr { border: 0; border-top: 1px solid #2a2a2e; margin: 6px 0; }

                .fx-popup .swal2-title { color: #fff; font-size: 20px; }
                .fx-popup .swal2-input, .fx-popup .swal2-textarea, .fx-popup .swal2-select {
                    background: #0f0f10; color: #e0e0e0; border: 1px solid #333; font-size: 14px; margin: 0; width: 100%;
                }
                .fx-popup .fx-rotulo { display: block; text-align: left; font-size: 12px; color: #a1a1aa; margin: 12px 0 4px; }
                .fx-popup .fx-check { display: flex; gap: 8px; align-items: center; text-align: left; font-size: 13px; margin-top: 14px; }
                .fx-popup .fx-aviso { font-size: 12px; color: #f59e0b; text-align: left; margin: 14px 0 0; }
                .fx-popup .lib-busca { width: 100%; background: #0f0f10; color: #e0e0e0; border: 1px solid #333; border-radius: 8px; padding: 10px 12px; font: inherit; font-size: 13px; margin-bottom: 10px; }
                .fx-popup .lib-lista { max-height: 340px; overflow-y: auto; display: grid; gap: 8px; text-align: left; }
                .fx-popup .lib-item { background: #0a0a0b; border: 1px solid #2a2a2e; color: #fff; border-radius: 8px; padding: 12px 14px; cursor: pointer; text-align: left; font: inherit; display: block; width: 100%; }
                .fx-popup .lib-item:hover:not(:disabled) { border-color: var(--accent); }
                .fx-popup .lib-item:disabled { opacity: 0.45; cursor: not-allowed; }
                .fx-popup .lib-item strong { display: block; font-size: 14px; }
                .fx-popup .lib-item small { color: #a1a1aa; font-size: 12px; }
                .fx-popup .lib-vazio { color: #a1a1aa; font-size: 13px; padding: 14px 0; }
                .fx-popup .opcoes-envio { display: grid; gap: 10px; margin-top: 5px; }
                .fx-popup .opcao-envio { background: #0a0a0b; border: 1px solid #2a2a2e; color: #fff; border-radius: 8px; padding: 14px 16px; text-align: left; cursor: pointer; display: flex; gap: 12px; align-items: flex-start; font: inherit; }
                .fx-popup .opcao-envio:hover { border-color: var(--accent); }
                .fx-popup .opcao-envio i { font-size: 18px; color: var(--accent); margin-top: 2px; width: 20px; text-align: center; }
                .fx-popup .opcao-envio b { display: block; font-size: 14px; margin-bottom: 3px; }
                .fx-popup .opcao-envio span { font-size: 12px; color: #a1a1aa; line-height: 1.4; }

            </style>
        </head>
        <body>
            <% const isModelo = (typeof modoModelo !== 'undefined' && modoModelo); %>
            <input type="hidden" id="server-client-id" value="<%= cliente.id %>">
            <input type="hidden" id="modo-modelo" value="<%= isModelo ? '1' : '' %>">
            <input type="hidden" id="nome-fluxo" value="<%= cliente.nome %>">
            
            <% 
                let fluxoBase64 = ""; 
                try { 
                    const fluxoStr = JSON.stringify(fluxo || {}); 
                    fluxoBase64 = Buffer.from(fluxoStr).toString('base64'); 
                } catch(e) { 
                    fluxoBase64 = ""; 
                } 
            %>
            <input type="hidden" id="fluxo-base64" value="<%= fluxoBase64 %>">

            <div class="var-float-btn" onclick="toggleVarWindow()" title="Ver Variáveis">
                <i class="fas fa-brackets-curly"></i> { }
            </div>
        
            <div class="var-window" id="varWindow">
                <div class="var-window-header">
                    <span><i class="fas fa-terminal"></i> Variáveis Disponíveis</span>
                    <i class="fas fa-times" style="cursor:pointer" onclick="toggleVarWindow()"></i>
                </div>
                <div class="var-list">
                    <div class="var-card" onclick="copyVar('{{nome}}')">
                        <code>{{nome}}</code>
                        <small>Nome salvo na Pergunta</small>
                    </div>
                    <div class="var-card" onclick="copyVar('{{telefone}}')">
                        <code>{{telefone}}</code>
                        <small>WhatsApp do Cliente</small>
                    </div>
                    <div class="var-card" onclick="copyVar('{{data}}')">
                        <code>{{data}}</code>
                        <small>Data Atual</small>
                    </div>
                    <div class="var-card" onclick="copyVar('{{protocolo}}')">
                        <code>{{protocolo}}</code>
                        <small>Número do Atendimento</small>
                    </div>
                    <p style="font-size: 9px; color: #555; text-align: center; margin-top: 10px;">Clique na variável para copiar</p>
                </div>
            </div>
            
            <div class="sidebar">
                <h2 style="font-size: 12px; text-transform: uppercase; color: #666; margin-bottom: 10px;">Básico</h2>
                
                <div class="node-item" draggable="true" ondragstart="drag(event)" data-node="inicio">
                    <i class="fas fa-play"></i> Início
                </div>
                <div class="node-item" draggable="true" ondragstart="drag(event)" data-node="menu">
                    <i class="fas fa-list-ul"></i> Menu Opções
                </div>
                <div class="node-item" draggable="true" ondragstart="drag(event)" data-node="mensagem">
                    <i class="fas fa-comment-alt"></i> Mensagem
                </div>
                <div class="node-item" draggable="true" ondragstart="drag(event)" data-node="midia">
                    <i class="fas fa-image"></i> Foto/Vídeo
                </div>
                <div class="node-item" draggable="true" ondragstart="drag(event)" data-node="audio">
                    <i class="fas fa-microphone"></i> Áudio
                </div>
                
                <h2 style="font-size: 12px; text-transform: uppercase; color: var(--input); margin: 20px 0 10px;">Inteligente</h2>
                
                <div class="node-item" draggable="true" ondragstart="drag(event)" data-node="pergunta">
                    <i class="fas fa-question-circle" style="color:var(--input)"></i> Pergunta (Input)
                </div>
                <div class="node-item" draggable="true" ondragstart="drag(event)" data-node="gerar_documento">
                    <i class="fas fa-file-pdf" style="color:var(--doc)"></i> Gerar Contrato
                </div>
                
                <h2 style="font-size: 12px; text-transform: uppercase; color: #666; margin: 20px 0 10px;">Controle</h2>
                
                <div class="node-item" draggable="true" ondragstart="drag(event)" data-node="horario">
                    <i class="fas fa-clock"></i> Horário
                </div>
                <div class="node-item" draggable="true" ondragstart="drag(event)" data-node="espera">
                    <i class="fas fa-hourglass-half"></i> Espera/Delay
                </div>
                <div class="node-item" draggable="true" ondragstart="drag(event)" data-node="transferir">
                    <i class="fas fa-headset"></i> Transferir
                </div>
                <div class="node-item" draggable="true" ondragstart="drag(event)" data-node="finalizar">
                    <i class="fas fa-stop-circle"></i> Finalizar
                </div>
                <div class="node-item" draggable="true" ondragstart="drag(event)" data-node="acesso_secreto">
                    <i class="fas fa-lock"></i> Acesso Secreto
                </div>
            </div>
        
            <div class="top-bar">

                <a href="<%= isModelo ? '/dashboard/fluxos' : '/dashboard' %>"
                   class="btn-base btn-back">
                    <i class="fas fa-arrow-left"></i> 
                    <%= isModelo ? 'Biblioteca' : 'Voltar' %>
                </a>
                
                <input type="file" 
                       id="fileImport" 
                       accept=".json" 
                       style="display: none;" 
                       onchange="lerArquivo(this)">
                
                <div class="menu-wrap">
                    <button class="btn-base btn-import"
                            onclick="toggleMenuFluxos(event)"
                            aria-haspopup="true">
                        <i class="fas fa-layer-group"></i>
                        Fluxos
                        <i class="fas fa-chevron-down" style="font-size:10px"></i>
                    </button>
                    <div class="fluxos-menu" id="fluxos-menu" role="menu">
                        <button onclick="importarDaBiblioteca()"><i class="fas fa-book-open"></i> Importar da biblioteca</button>
                        <button onclick="escolherModoImportacao()"><i class="fas fa-file-import"></i> Importar arquivo ou código</button>
                        <hr>
                        <button onclick="copiarFluxo()"><i class="fas fa-copy"></i> Copiar fluxo</button>
                        <button onclick="exportarFluxo()"><i class="fas fa-file-export"></i> Exportar arquivo (.json)</button>
                        <button onclick="enviarFluxo()"><i class="fas fa-paper-plane"></i> Enviar...</button>
                    </div>
                </div>
    
                <button class="btn-base" 
                        style="background: #27272a; color: var(--accent); border: 1px solid var(--accent);" 
                        onclick="mostrarVariaveis()">
                    <i class="fas fa-code"></i> 
                    Variáveis
                </button>
                
                <button class="btn-base btn-save" 
                        onclick="salvarFluxo()">
                    <i class="fas fa-save"></i> 
                    <%= isModelo ? 'Salvar modelo' : 'Salvar Fluxo' %>
                </button>
        
            </div>
        
            <div id="drawflow" ondrop="drop(event)" ondragover="allowDrop(event)"></div>
        
            <script src="https://cdn.jsdelivr.net/gh/jerosoler/Drawflow/dist/drawflow.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        
            <script>
                const idCliente = document.getElementById('server-client-id').value;
                const MODO_MODELO = document.getElementById('modo-modelo').value === '1'; // editando um modelo da biblioteca (não um bot)
                const editor = new Drawflow(document.getElementById("drawflow"));
                
                editor.reroute = true;
                editor.editor_mode = 'edit';
                editor.start();
        
                // Escuta qualquer mudança nos selects de contrato e salva na memória
                document.addEventListener('change', function(e) {
                    if (e.target && e.target.classList.contains('contract-selector')) {
                        const nodeId = getNodeId(e.target);
                        const valorSelecionado = e.target.value;
                        const nodeData = editor.getNodeFromId(nodeId).data;
                        nodeData.templateId = valorSelecionado;
                        editor.updateNodeDataFromId(nodeId, nodeData);
                    }
                });
        
                const getNodeId = (elem) => elem.closest('.drawflow-node').id.replace('node-', '');
                
                // =========================================================
                // 13. TEMPLATES HTML DOS NÓS (DESENHO DOS BLOCOS)
                // =========================================================
                const templates = {
                    
                    inicio: `
                        <div class="title">
                            <i class="fas fa-play"></i> Início
                        </div>
                        <div style="padding:16px; font-size:13px; color:#aaa">
                            Gatilho inicial da conversa.
                        </div>
                    `,
                    
                    finalizar: `
                        <div class="title">
                            <i class="fas fa-stop-circle"></i> Finalizar
                        </div>
                        <div style="padding:16px; font-size:13px; color:#aaa">
                            Encerra o protocolo.
                        </div>
                    `,
                    
                    mensagem: `
                        <div class="title">
                            <i class="fas fa-comment-alt"></i> Mensagem
                        </div>
                        <div style="padding:16px">
                            <label>Texto:</label>
                            <textarea df-message placeholder="Digite a mensagem..."></textarea>
                        </div>
                    `,
                    
                    pergunta: `
                        <div class="title" style="border-bottom-color:var(--input)">
                            <i class="fas fa-question-circle" style="color:var(--input)"></i> Pergunta
                        </div>
                        <div style="padding:16px">
                            <label>Pergunta ao Cliente:</label>
                            <textarea df-message placeholder="Ex: Qual seu nome completo?"></textarea>
                            
                            <div style="margin-top:15px; background:#222; padding:10px; border-radius:6px; border:1px dashed var(--input)">
                                <label style="color:var(--input)">Nome da Variável:</label>
                                <input type="text" df-variable placeholder="Ex: nome_cliente" style="border-color:var(--input)">
                                <p style="font-size:10px; color:#888; margin-top:5px">Esta resposta será salva para usar no contrato.</p>
                            </div>
                        </div>
                    `,
                    
                    gerar_documento: `
                        <div class="title" style="border-bottom-color:var(--doc)">
                            <i class="fas fa-file-pdf" style="color:var(--doc)"></i> Gerar Contrato
                        </div>
                        <div style="padding:16px">
                            <label>Selecione o Modelo:</label>
