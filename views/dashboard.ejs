<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calixto OmniSystem - Dashboard</title>
    
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="/socket.io/socket.io.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <style>
        :root {
            --bg-color: #000000;
            --card-bg: #0a0a0a;
            --border-color: #222;
            --primary-blue: #0066ff;
            --primary-hover: #0052cc;
            --danger-bg: #1a1a1a;
            --danger-text: #666;
            --text-main: #ffffff;
            --switch-on: #00e054;
            --accent: #00d2ff;
        }

        body { background-color: var(--bg-color); color: var(--text-main); font-family: 'Inter', sans-serif; margin: 0; padding: 40px; }

        /* HEADER */
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; }
        .logo { font-size: 20px; font-weight: 700; display: flex; align-items: center; gap: 10px; color: #fff; }
        .plan-badge { font-size: 10px; background: #1a1a1a; border: 1px solid #333; padding: 4px 10px; border-radius: 20px; color: #666; font-weight: 600; margin-left: 10px; }
        
        .btn-new-client { background-color: var(--primary-blue); color: #fff; border: none; padding: 10px 20px; border-radius: 6px; font-weight: 600; cursor: pointer; font-size: 13px; transition: 0.2s; }
        .btn-new-client:hover { background-color: var(--primary-hover); }
        .btn-logout { color: #666; text-decoration: none; font-size: 13px; font-weight: 500; margin-right: 20px; }
        .btn-logout:hover { color: #fff; }

        /* GRID */
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; }

        /* CARD */
        .card { 
            background-color: var(--card-bg); border: 1px solid var(--border-color); 
            border-radius: 12px; padding: 20px; position: relative; transition: transform 0.2s; 
        }
        .card:hover { border-color: #333; }

        .card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px; }
        .bot-name { font-size: 15px; font-weight: 600; color: #fff; margin-bottom: 2px; }
        .edit-icon { font-size: 12px; color: #444; cursor: pointer; }
        .edit-icon:hover { color: #fff; }

        /* INPUT NÚMERO */
        .number-display { 
            background-color: #111; border: 1px solid #222; border-radius: 6px; 
            padding: 10px 12px; display: flex; align-items: center; gap: 10px; 
            color: #666; font-size: 13px; font-family: monospace; margin-bottom: 15px;
        }
        .number-display i { color: #00c853; font-size: 16px; }

        /* BOTÕES */
        .card-actions { display: flex; gap: 8px; }
        .btn-flow { flex: 1; background-color: var(--primary-blue); color: #fff; border: none; padding: 10px; border-radius: 6px; font-weight: 600; cursor: pointer; font-size: 13px; display: flex; justify-content: center; align-items: center; gap: 6px; }
        .btn-flow:hover { background-color: var(--primary-hover); }
        .btn-delete { width: 40px; background-color: var(--danger-bg); border: 1px solid #2a2a2a; border-radius: 6px; color: var(--danger-text); cursor: pointer; display: flex; justify-content: center; align-items: center; font-size: 16px; }
        .btn-delete:hover { background-color: #2a1111; color: #ff4444; border-color: #441111; }

        /* SWITCH */
        .switch { position: relative; display: inline-block; width: 40px; height: 22px; }
        .switch input { opacity: 0; width: 0; height: 0; }
        .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #222; transition: .4s; border-radius: 34px; }
        .slider:before { position: absolute; content: ""; height: 16px; width: 16px; left: 3px; bottom: 3px; background-color: #666; transition: .4s; border-radius: 50%; }
        input:checked + .slider { background-color: var(--switch-on); }
        input:checked + .slider:before { transform: translateX(18px); background-color: #fff; }

        /* --- DISPLAY DO CÓDIGO (PAIRING CODE) --- */
        .pairing-container {
            display: none; /* Invisível por padrão */
            background: #000;
            border: 1px dashed var(--accent);
            border-radius: 8px;
            padding: 15px;
            margin-top: 15px;
            text-align: center;
            animation: slideDown 0.3s ease-out;
        }
        .pairing-label { font-size: 10px; color: #666; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; }
        .pairing-code {
            font-family: 'Courier New', monospace;
            font-size: 22px; font-weight: 800; color: var(--accent);
            letter-spacing: 3px; display: block; margin: 5px 0; user-select: all;
        }
        .pairing-steps { font-size: 10px; color: #444; margin-top: 5px; }
        @keyframes slideDown { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }

        /* --- ÁREA ADMIN (ESTILO DARK) --- */
        .admin-section { 
            margin-top: 80px; padding: 30px; 
            border: 1px solid #222; border-radius: 12px; 
            background-color: #050505; 
        }
        .admin-header { display: flex; justify-content: space-between; margin-bottom: 20px; align-items: center; }
        .admin-title { color: #bd00ff; font-weight: 700; font-size: 12px; letter-spacing: 1px; text-transform: uppercase; display: flex; align-items: center; gap: 8px; }
        
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th { text-align: left; padding: 15px 10px; color: #555; border-bottom: 1px solid #222; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px; }
        td { padding: 15px 10px; border-bottom: 1px solid #111; color: #ccc; vertical-align: middle; }
        
        .status-active { color: var(--switch-on); font-weight: bold; font-size: 11px; }
        .status-pending { color: #ff4444; font-weight: bold; font-size: 11px; }
        
        .plano-select { 
            background: #000; color: #fff; border: 1px solid #333; 
            padding: 5px 10px; border-radius: 4px; font-size: 12px; outline: none; cursor: pointer;
        }
        .btn-approve { 
            background: var(--switch-on); color: #000; border: none; 
            padding: 5px 12px; border-radius: 4px; font-weight: 700; 
            cursor: pointer; font-size: 11px; text-transform: uppercase;
        }
        .btn-refresh {
            background: transparent; border: 1px solid #333; color: #666;
            padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 11px;
        }
        .btn-refresh:hover { color: #fff; border-color: #555; }
    </style>
</head>
<body>

    <div class="header">
        <div class="logo">
            <i class="ri-rocket-2-fill"></i> Calixto OmniSystem
            <% if (usuario) { %> <span class="plan-badge"><%= usuario.plano %></span> <% } %>
        </div>
        <div>
            <a href="/logout" class="btn-logout">Sair</a>
            <button class="btn-new-client" onclick="novoBot()">+ Novo Cliente</button>
        </div>
    </div>

    <div class="grid">
        <% if (clientes && clientes.length > 0) { %>
            <% clientes.forEach(c => { %>
                <div class="card" id="card-<%= c.id %>">
                    
                    <div class="card-header">
                        <div>
                            <div class="bot-name"><%= c.nome %> <i class="ri-pencil-fill edit-icon" onclick="editarBot('<%= c.id %>', '<%= c.nome %>', '<%= c.numero %>')"></i></div>
                        </div>
                        <label class="switch">
                            <input type="checkbox" <%= c.status === 'ONLINE' ? 'checked' : '' %> onchange="toggleBot('<%= c.id %>', this)">
                            <span class="slider"></span>
                        </label>
                    </div>

                    <div class="number-display">
                        <i class="ri-whatsapp-line"></i> <%= c.numero || 'Sem número' %>
                    </div>

                    <div class="card-actions">
                        <button class="btn-flow" onclick="window.location.href='/editor/<%= c.id %>'">
                            <i class="ri-node-tree"></i> Editar Fluxo
                        </button>
                        <button class="btn-delete" onclick="excluirBot('<%= c.id %>')">
                            <i class="ri-delete-bin-line"></i>
                        </button>
                    </div>

                    <div class="pairing-container" id="pairing-<%= c.id %>">
                        <div class="pairing-label">Código de Pareamento</div>
                        <span class="pairing-code" id="code-<%= c.id %>">...</span>
                        <div class="pairing-steps">No WhatsApp: Configurações > Aparelhos > Conectar</div>
                    </div>

                </div>
            <% }) %>
        <% } else { %>
            <div style="grid-column: 1/-1; text-align: center; color: #333; padding: 50px;">
                Nenhum bot encontrado.
            </div>
        <% } %>
    </div>

    <% if (usuario && usuario.email === 'vitorpedrocalixto@gmail.com') { %> 
        <div class="admin-section">
            <div class="admin-header">
                <div class="admin-title"><i class="ri-shield-star-line"></i> GESTÃO DE USUÁRIOS & PLANOS</div>
                <button class="btn-refresh" onclick="carregarUsuarios()"><i class="ri-refresh-line"></i> Atualizar Lista</button>
            </div>
            <div id="tabela-admin" style="color:#444; font-size:12px;">Carregando dados...</div>
        </div>

        <script>
            // LÓGICA EXCLUSIVA DO ADMIN
            async function carregarUsuarios() {
                try {
                    const res = await fetch('/api/admin/usuarios');
                    if (!res.ok) throw new Error("Falha ao buscar usuários");
                    const users = await res.json();

                    let html = '<table><thead><tr><th>Usuário / Email</th><th>Bots</th><th>Plano Atual</th><th>Status</th><th>Ação</th></tr></thead><tbody>';
                    
                    users.forEach(u => {
                        if (u.email === 'vitorpedrocalixto@gmail.com') return; // Esconde o próprio admin
                        
                        let botsCount = u.clientes ? u.clientes.length : 0;
                        
                        html += `<tr>
                            <td>
                                <div style="color:#fff; font-weight:600;">${u.nome}</div>
                                <div style="color:#555; font-size:11px;">${u.email}</div>
                            </td>
                            <td><span style="color:#fff; font-weight:bold;">${botsCount}</span></td>
                            <td>
                                <select class="plano-select" onchange="mudarPlano('${u.id}', this.value)" style="border-color:${u.plano === 'SIGNATURE' ? '#bd00ff' : '#333'}">
                                    <option value="ESSENTIAL" ${u.plano==='ESSENTIAL'?'selected':''}>ESSENTIAL</option>
                                    <option value="ADVANCED" ${u.plano==='ADVANCED'?'selected':''}>ADVANCED</option>
                                    <option value="SIGNATURE" ${u.plano==='SIGNATURE'?'selected':''}>SIGNATURE</option>
                                </select>
                            </td>
                            <td class="${u.ativo ? 'status-active' : 'status-pending'}">${u.ativo ? 'ATIVO' : 'PENDENTE'}</td>
                            <td>
                                ${!u.ativo ? `<button class="btn-approve" onclick="aprovar('${u.id}')">Liberar</button>` : '<span style="color:#333">-</span>'}
                            </td>
                        </tr>`;
                    });
                    
                    document.getElementById('tabela-admin').innerHTML = html + '</tbody></table>';
                } catch (e) {
                    document.getElementById('tabela-admin').innerText = "Erro ao carregar lista.";
                }
            }

            async function mudarPlano(id, plano) { 
                await fetch('/api/admin/mudar-plano', {method:'PUT', headers:{'Content-Type':'application/json'}, body:JSON.stringify({idUsuario:id, novoPlano:plano})});
                const toast = Swal.mixin({toast: true, position: 'top-end', showConfirmButton: false, timer: 1500, background: '#111', color: '#fff'});
                toast.fire({icon: 'success', title: 'Plano atualizado'});
            }

            async function aprovar(id) { 
                await fetch('/api/admin/aprovar', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({idUsuario:id})}); 
                carregarUsuarios(); 
            }

            // Carrega ao iniciar
            document.addEventListener('DOMContentLoaded', carregarUsuarios);
        </script>
    <% } %>

    <script>
        const socket = io();

        // 1. RECEBER CÓDIGO VIA SOCKET
        socket.on('pairingCode', (data) => {
            const box = document.getElementById(`pairing-${data.clienteId}`);
            const display = document.getElementById(`code-${data.clienteId}`);
            
            if (box && display) {
                box.style.display = 'block'; // Mostra a caixa
                display.innerText = data.code; // Insere o código
            }
        });

        // 2. STATUS MUDOU (CONECTOU)
        socket.on('status', (data) => {
            if (data.status === 'ONLINE') {
                const box = document.getElementById(`pairing-${data.clienteId}`);
                if (box) box.style.display = 'none'; // Esconde o código
                
                // Recarrega para garantir status verde
                // (Timeout pequeno para dar tempo do visual processar)
                setTimeout(() => location.reload(), 1500); 
            }
        });

        async function toggleBot(id, checkbox) {
            const status = checkbox.checked ? 'ONLINE' : 'OFFLINE';
            
            // UX: Se ligou, já mostra que está carregando
            if (status === 'ONLINE') {
                const box = document.getElementById(`pairing-${id}`);
                const display = document.getElementById(`code-${id}`);
                if(box) {
                    box.style.display = 'block';
                    display.innerText = "GERANDO...";
                }
            } else {
                const box = document.getElementById(`pairing-${id}`);
                if(box) box.style.display = 'none';
            }

            try {
                await fetch('/api/status', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ clienteId: id, status }) });
            } catch (e) {
                checkbox.checked = !checkbox.checked;
                Swal.fire('Erro', 'Falha de conexão', 'error');
            }
        }

        async function novoBot() {
            const { value: form } = await Swal.fire({
                title: 'Novo Cliente', background: '#111', color: '#fff',
                html: '<input id="nome" class="swal2-input" placeholder="Nome"><input id="num" class="swal2-input" placeholder="55..." type="number">',
                focusConfirm: false, confirmButtonColor: '#0066ff', confirmButtonText: 'Criar',
                preConfirm: () => [document.getElementById('nome').value, document.getElementById('num').value]
            });
            if (form) {
                await fetch('/api/clientes', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ nome: form[0], numero: form[1] }) });
                location.reload();
            }
        }

        async function editarBot(id, nome, num) {
            const { value: form } = await Swal.fire({
                title: 'Editar', background: '#111', color: '#fff',
                html: `<input id="ed-nome" class="swal2-input" value="${nome}"><input id="ed-num" class="swal2-input" value="${num}">`,
                focusConfirm: false, confirmButtonColor: '#0066ff',
                preConfirm: () => [document.getElementById('ed-nome').value, document.getElementById('ed-num').value]
            });
            if(form) {
                await fetch(`/api/clientes/${id}`, { method: 'PUT', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ nome: form[0], numero: form[1] }) });
                location.reload();
            }
        }

        async function excluirBot(id) {
            if((await Swal.fire({ title: 'Tem certeza?', background: '#111', color: '#fff', showCancelButton: true, confirmButtonColor: '#d33' })).isConfirmed) {
                await fetch(`/api/clientes/${id}`, { method: 'DELETE' });
                location.reload();
            }
        }
    </script>
</body>
</html>