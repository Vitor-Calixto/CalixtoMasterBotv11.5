<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Calixto OmniSystem</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #000000;
            --card-bg: #0a0a0a;
            --border-color: #222;
            --blue-accent: #0066cc; /* Azul do seu botão */
            --blue-hover: #0052a3;
            --text-color: #fff;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 20px 40px;
        }

        /* HEADER IGUAL À FOTO */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
            padding-bottom: 20px;
            border-bottom: 1px solid #111;
        }

        .brand-area {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .logo {
            font-size: 20px;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* O botão Voltar que você pediu */
        .btn-back {
            text-decoration: none;
            color: #666;
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 5px;
            transition: 0.3s;
            padding: 5px 10px;
            border-radius: 5px;
            border: 1px solid transparent;
        }
        .btn-back:hover {
            color: #fff;
            border-color: #333;
            background: #111;
        }

        .btn-new {
            background-color: var(--blue-accent);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: 0.2s;
        }
        .btn-new:hover { background-color: var(--blue-hover); }

        /* GRID DE CARDS (IGUAL FOTO) */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 25px;
        }

        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 25px;
            position: relative;
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 15px;
        }

        .bot-name { font-size: 16px; font-weight: 600; color: #fff; margin-bottom: 5px; }
        .bot-id { font-size: 12px; color: #444; font-family: monospace; }
        
        .status-badge {
            font-size: 12px;
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .status-badge.online { color: #00ff88; }
        .status-badge.offline { color: #ff4444; }
        .dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; }

        /* Toggle Switch (Igual foto) */
        .switch {
            position: relative;
            display: inline-block;
            width: 40px;
            height: 20px;
        }
        .switch input { opacity: 0; width: 0; height: 0; }
        .slider {
            position: absolute; cursor: pointer;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: #333;
            transition: .4s;
            border-radius: 34px;
        }
        .slider:before {
            position: absolute; content: "";
            height: 14px; width: 14px;
            left: 3px; bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }
        input:checked + .slider { background-color: #00d2ff; }
        input:checked + .slider:before { transform: translateX(20px); }

        /* Input do WhatsApp */
        .input-group { margin-top: 15px; }
        .input-label { font-size: 12px; color: #666; margin-bottom: 5px; display: block; }
        .whatsapp-input {
            width: 100%;
            background: #111;
            border: 1px solid #333;
            padding: 10px;
            color: #ccc;
            border-radius: 5px;
            box-sizing: border-box;
        }

        /* Botões de Ação do Card */
        .card-actions {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .btn-edit {
            flex: 1;
            background-color: #0055aa; /* Azul mais escuro do card */
            color: white;
            border: none;
            padding: 10px;
            border-radius: 5px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            text-align: center;
            font-size: 14px;
        }
        .btn-edit:hover { background-color: #004499; }

        .btn-trash {
            background: #222;
            color: #666;
            border: none;
            width: 40px;
            border-radius: 5px;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
        }
        .btn-trash:hover { background: #331111; color: #ff4444; }

    </style>
</head>
<body>

    <div class="header">
        <div class="brand-area">
            <a href="/logout" class="btn-back">← Sair</a>
            
            <div class="logo">
                🚀 Calixto OmniSystem
            </div>
        </div>

        <button class="btn-new" onclick="novoBot()">
            + Novo Cliente
        </button>
    </div>

    <% if (clientes.length === 0) { %>
        <div style="text-align: center; color: #444; margin-top: 100px;">
            <h2>Nenhum bot encontrado.</h2>
            <p>Clique em "+ Novo Cliente" para começar.</p>
        </div>
    <% } %>

    <div class="grid">
        <% clientes.forEach(c => { %>
            <div class="card">
                <div class="card-header">
                    <div>
                        <div class="bot-name"><%= c.nome %></div>
                        <div class="bot-id">ID: <%= c.id.substring(0,8) %>...</div>
                        
                        <div class="status-badge <%= c.status === 'ONLINE' ? 'online' : 'offline' %>" style="margin-top:5px;">
                            <div class="dot"></div>
                            <%= c.status %>
                        </div>
                    </div>
                    
                    <label class="switch">
                        <input type="checkbox" <%= c.status === 'ONLINE' ? 'checked' : '' %> onchange="toggleBot('<%= c.id %>', '<%= c.status %>')">
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="input-group">
                    <span class="input-label">WhatsApp Conectado</span>
                    <input type="text" class="whatsapp-input" value="<%= c.numero || 'Não conectado' %>" readonly>
                </div>

                <div class="card-actions">
                    <a href="/editor/<%= c.id %>" class="btn-edit">
                        ⚙️ Editar Fluxo
                    </a>
                    <button class="btn-trash" onclick="excluirBot('<%= c.id %>')">
                        🗑
                    </button>
                </div>
            </div>
        <% }) %>
    </div>

    <script>
        async function novoBot() {
            const nome = prompt("Nome do Cliente/Empresa:");
            if (!nome) return;
            const numero = prompt("Número do WhatsApp (apenas números, com DDD):");
            
            if(nome && numero) {
                const res = await fetch('/api/clientes', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ nome, numero })
                });
                if(res.ok) window.location.reload();
                else alert("Erro ao criar.");
            }
        }

        async function toggleBot(id, statusAtual) {
            // Inverte o status para enviar a requisição
            const novoStatus = statusAtual === 'ONLINE' ? 'OFFLINE' : 'ONLINE';
            
            const res = await fetch('/api/status', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ clienteId: id, status: novoStatus })
            });

            // Recarrega para atualizar visualmente se deu certo
            if(res.ok) {
                setTimeout(() => window.location.reload(), 500);
            } else {
                alert("Erro ao mudar status.");
            }
        }

        async function excluirBot(id) {
            if(confirm("Tem certeza que deseja excluir este bot? Esta ação não pode ser desfeita.")) {
                await fetch(`/api/clientes/${id}`, { method: 'DELETE' });
                window.location.reload();
            }
        }
    </script>
</body>
</html>