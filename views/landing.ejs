    <script>
        // LOADER (Tempo de 4 segundos para exibir a animação)
        window.addEventListener('load', () => setTimeout(() => document.getElementById('jarvis-loader').classList.add('loaded'), 4000));

        // FAQ
        document.querySelectorAll('.faq-question').forEach(button => {
            button.addEventListener('click', () => {
                const item = button.parentElement;
                item.classList.toggle('active');
            });
        });

        // EASTER EGGS
        let clicks = 0;
        const logo = document.getElementById('secret-trigger');
        const consoleDiv = document.getElementById('god-console');
        const consoleInput = document.getElementById('console-input');
        const consoleOutput = document.getElementById('console-output');

        if(logo) {
            logo.addEventListener('click', () => {
                clicks++;
                if(clicks === 5) {
                    consoleDiv.classList.add('active');
                    consoleInput.focus();
                    clicks = 0;
                }
                setTimeout(() => clicks = 0, 2000);
            });
        }

        consoleInput.addEventListener('keypress', (e) => {
            if(e.key === 'Enter') {
                const cmd = consoleInput.value.trim().toLowerCase();
                consoleInput.value = '';
                consoleOutput.innerHTML += `> ${cmd}<br>`;
                
                if(cmd === 'matrix') { 
                    document.body.classList.add('matrix-mode'); 
                    document.body.classList.remove('red-alert-mode'); 
                    consoleOutput.innerHTML += '> Matrix carregada.<br>'; 
                }
                else if(cmd === 'red_alert') { 
                    document.body.classList.add('red-alert-mode'); 
                    document.body.classList.remove('matrix-mode'); 
                    consoleOutput.innerHTML += '> ALERTA VERMELHO!<br>'; 
                }
                else if(cmd === 'nuke') {
                    consoleOutput.innerHTML += '> INICIANDO SEQUÊNCIA DE AUTODESTRUIÇÃO...<br>';
                    let count = 5;
                    const timer = setInterval(() => {
                        consoleOutput.innerHTML += `> ${count}...<br>`;
                        consoleOutput.scrollTop = consoleOutput.scrollHeight;
                        count--;
                        if(count < 0) {
                            clearInterval(timer);
                            document.body.classList.add('nuke-mode');
                            setTimeout(() => { document.body.classList.remove('nuke-mode'); consoleOutput.innerHTML += '> ERRO: SISTEMA REINICIADO.<br>'; document.body.classList.remove('matrix-mode', 'red-alert-mode'); }, 2000);
                        }
                    }, 1000);
                }
                else if(cmd === 'normal' || cmd === 'reset') { 
                    document.body.classList.remove('matrix-mode', 'red-alert-mode', 'nuke-mode'); 
                    consoleOutput.innerHTML += '> Sistema normalizado.<br>'; 
                }
                else if(cmd === 'clear') { consoleOutput.innerHTML = ''; }
                else if(cmd === 'exit') { consoleDiv.classList.remove('active'); }
                else { consoleOutput.innerHTML += '> Comando desconhecido.<br>'; }
                
                consoleOutput.scrollTop = consoleOutput.scrollHeight;
            }
        });

        // SECRET O
        const secretO = document.getElementById('secret-o');
        let oClicks = 0;
        if(secretO) {
            secretO.addEventListener('click', () => {
                oClicks++;
                if (oClicks === 3) {
                    secretO.classList.add('activated');
                    setTimeout(() => window.location.href = "/registro", 500);
                }
                setTimeout(() => oClicks = 0, 800);
            });
        }
    </script>
