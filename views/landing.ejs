    <script>
        // Abertura: some quando a página carrega, com no mínimo ~2,7s de animação
        (function () {
            const inicio = Date.now();
            const sai = () => { const l = document.getElementById('jarvis-loader'); if (l) l.classList.add('loaded'); };
            const agenda = () => setTimeout(sai, Math.max(0, 2700 - (Date.now() - inicio)));
            if (document.readyState === 'complete') agenda(); else window.addEventListener('load', agenda);
        })();

        // Proteção básica: bloqueia o menu do botão direito e os atalhos que abrem o console
        // do navegador (F12, Ctrl/Cmd+Shift+I/J/C, Ctrl+U). Isso impede o uso casual,
        // não é uma barreira técnica: quem for avançado ainda consegue pelo menu do navegador.
        document.addEventListener('contextmenu', (e) => e.preventDefault());
        document.addEventListener('keydown', (e) => {
            const tecla = (e.key || '').toLowerCase();
            const cmdOuCtrl = e.ctrlKey || e.metaKey;
            const abreConsole = e.key === 'F12'
                || (cmdOuCtrl && e.shiftKey && ['i', 'j', 'c'].includes(tecla))
                || (cmdOuCtrl && e.altKey && ['i', 'j', 'c'].includes(tecla))
                || (cmdOuCtrl && tecla === 'u');
            if (abreConsole) { e.preventDefault(); e.stopPropagation(); }
        }, true);

        // Borda no topo ao rolar
        const topo = document.getElementById('topo');
        const aoRolar = () => topo.classList.toggle('rolou', window.scrollY > 8);
        window.addEventListener('scroll', aoRolar, { passive: true }); aoRolar();

        // Conversa de demonstração: as mensagens aparecem uma de cada vez (uma única vez)
        document.querySelectorAll('.demo-corpo > *').forEach((m, i) => { m.style.animationDelay = (0.35 + i * 0.55) + 's'; });

        // Abas dos planos (setas do teclado também funcionam)
        const abas = [...document.querySelectorAll('.aba')];
        function selecionar(aba) {
            abas.forEach(a => {
                const ativa = a === aba;
                a.setAttribute('aria-selected', String(ativa));
                a.tabIndex = ativa ? 0 : -1;
                document.getElementById(a.getAttribute('aria-controls')).hidden = !ativa;
            });
        }
        abas.forEach((a, i) => {
            a.addEventListener('click', () => selecionar(a));
            a.addEventListener('keydown', (e) => {
                if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
                const prox = abas[(i + (e.key === 'ArrowRight' ? 1 : abas.length - 1)) % abas.length];
                selecionar(prox); prox.focus();
            });
        });

        // Acesso discreto ao cadastro (mantido da versão anterior): 3 cliques rápidos na marca
        let cliques = 0, timer;
        document.getElementById('marca').addEventListener('click', () => {
            cliques++; clearTimeout(timer);
            if (cliques >= 3) { window.location.href = '/registro'; return; }
            timer = setTimeout(() => { cliques = 0; }, 800);
        });
    </script>
