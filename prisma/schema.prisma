// ----------------------------------------------------------------------------
// ARQUIVO: prisma/schema.prisma (ATUALIZADO V12 OMNICHANNEL)
// ----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id              String    @id @default(uuid())
  email           String    @unique
  senha           String
  nome            String
  role            String    @default("CLIENTE") 
  ativo           Boolean   @default(false)
  bloqueado       Boolean   @default(false)
  expiraEm        DateTime?
  resetToken      String?   
  resetExpires    DateTime?
  termsAccepted   Boolean   @default(false)
  termsAcceptedAt DateTime?
  signupIp        String?
  plano           String    @default("ESSENTIAL") 

  // 🔐 Contas e assinatura (painel do administrador)
  trocarSenha     Boolean   @default(false) // true = no próximo login cria a própria senha
  versaoSessao    Int       @default(0)     // muda quando a senha/acesso muda: derruba sessões antigas
  ultimoLogin     DateTime?
  periodo         String?                   // último período dado: 30, 60, 90, 120, 365 ou vitalicio
  permissoes      Json?                     // exceções ao plano definidas pelo admin (ex.: { "contratos": true, "maxBots": 5 })

  clientes        Cliente[] 
  fluxosModelo    FluxoModelo[]
  criadoEm        DateTime  @default(now())
}

model Cliente {
  id                String   @id @default(uuid())
  nome              String
  numeroNotificacao String?
  numero            String?  @unique
  ativo             Boolean  @default(false)
  plataforma String @default("WHATSAPP")
  fluxoJson         Json?
  contratos         ContratoTemplate[]
  status            String   @default("OFFLINE")
  criadoEm          DateTime @default(now())
  igAppId       String?
  igAppSecret   String?

  // 📸 --- NOVOS CAMPOS INSTAGRAM V12 ---
  instagramId    String?  @unique // ID único da Meta (ex: 264199...)
  instagramUser  String?          // @username (ex: calixto.dev)
  instagramToken String?          // Access Token de acesso ao Direct
  instagramModo  String?          // "INSTAGRAM" = Login do Instagram (token renovado a cada 60 dias); vazio = via Página do Facebook
  instagramTokenExpira DateTime?  // quando o token do Login do Instagram vence (o sistema renova antes)

  tempoLembrete1       Int      @default(24)
  tempoLembrete2       Int      @default(0)
  usarHorarioComercial Boolean  @default(true)
  horarioAtendimento   Json?    // dias/horas de atendimento, duração e intervalo (modulos/agenda.js)

  donoId    String?  
  dono      Usuario? @relation(fields: [donoId], references: [id])

  contatos      Contato[]
  sessoesAtivas SessaoAtiva[]
  lembretes     Lembrete[]
}

model SessaoAtiva {
  id        String   @id @default(uuid())
  clienteId String
  chatId    String
  noAtual   String
  dados     Json?
  updatedAt DateTime @updatedAt
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  @@unique([clienteId, chatId])
}

model Contato {
  id        String   @id @default(uuid())
  remoteJid String
  nome      String?
  clienteId String
  criadoEm  DateTime @default(now())

  // 💬 Conversas ao vivo (dashboard)
  ultimaEm       DateTime @default(now())  // hora da última mensagem (ordena a lista)
  ultimaMensagem String?                   // prévia mostrada na lista

  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  mensagens Mensagem[]

  @@unique([clienteId, remoteJid])
  @@index([clienteId, ultimaEm])
}

model Mensagem {
  id        String   @id @default(uuid())
  texto     String
  tipo      String   @default("texto")   // texto | imagem | video | audio | documento | sistema ...
  fromMe    Boolean
  origem    String?                       // CLIENTE | BOT | HUMANO (dashboard) | CELULAR | SISTEMA
  waId      String?                       // id da mensagem no WhatsApp (evita gravar duas vezes)
  contatoId String
  criadoEm  DateTime @default(now())
  contato   Contato  @relation(fields: [contatoId], references: [id], onDelete: Cascade)

  @@unique([contatoId, waId])
  @@index([contatoId, criadoEm])
}

model ContratoTemplate {
  id        String   @id @default(uuid())
  nome      String   
  conteudo  String   @db.Text 
  arquivoUrl String?
  criadoEm  DateTime @default(now())
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  clienteId String
}

model Lembrete {
  id              String   @id @default(uuid())
  numero          String   
  mensagem        String   
  cpf             String?
  nome            String?
  dataAgendada    DateTime 
  fim             DateTime?   // só para bloqueios de um período (ex.: tarde inteira)
  status          String   @default("PENDENTE") 
  lembreteEnviado Boolean  @default(false)      
  clienteId       String
  cliente         Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}

// 📚 --- BIBLIOTECA DE FLUXOS (modelos pré-montados, independentes de qualquer bot) ---
model FluxoModelo {
  id           String   @id @default(uuid())
  nome         String
  descricao    String?
  fluxoJson    Json                      // mesmo formato do Cliente.fluxoJson (export do Drawflow)
  totalNos     Int      @default(0)
  recebidoDe   String?                   // nome de quem enviou (envio direto ou link)
  pendente     Boolean  @default(false)  // true = recebido de outro usuário, aguardando aceite
  shareToken   String?  @unique          // preenchido = link de compartilhamento ativo
  donoId       String
  dono         Usuario  @relation(fields: [donoId], references: [id], onDelete: Cascade)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([donoId])
}
