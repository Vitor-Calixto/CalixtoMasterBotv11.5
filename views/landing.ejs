<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calixto OmniSystem | Atendimento automático no WhatsApp</title>
    <meta name="description" content="Robô de atendimento para WhatsApp e Instagram: responde na hora, agenda, lembra o cliente e passa para sua equipe quem está pronto para fechar.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Instrument+Sans:wght@400;500;600&family=Orbitron:wght@700;900&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">

    <style>
        :root {
            --tinta: #16211c;
            --tinta-2: #4b5a53;
            --tinta-3: #7a8a82;
            --fundo: #f5f7f4;
            --papel: #ffffff;
            --linha: #dfe5e0;
            --floresta: #0e3b2e;
            --floresta-2: #15513f;
            --acao: #128c6b;
            --acao-hover: #0e7458;
            --menta: #dff3ea;
            --sol: #f2c14e;
            --balao-out: #dcf8c6;
            --raio: 14px;
            --largura: 1120px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        body { background: var(--fundo); color: var(--tinta); font-family: 'Instrument Sans', system-ui, sans-serif; font-size: 17px; line-height: 1.6; -webkit-font-smoothing: antialiased; }
        h1, h2, h3, .marca { font-family: 'Bricolage Grotesque', system-ui, sans-serif; font-optical-sizing: auto; }
        a { color: inherit; }
        img { max-width: 100%; display: block; }
        :focus-visible { outline: 3px solid var(--acao); outline-offset: 3px; border-radius: 4px; }
        .container { width: min(var(--largura), 100% - 40px); margin-inline: auto; }

        /* ---------- botões ---------- */
        .btn { display: inline-flex; align-items: center; justify-content: center; gap: 9px; padding: 14px 22px; border-radius: 999px; font: 600 16px/1 'Instrument Sans', sans-serif; text-decoration: none; border: 1.5px solid transparent; cursor: pointer; transition: background .2s, border-color .2s, color .2s; white-space: nowrap; }
        .btn-primario { background: var(--acao); color: #fff; }
        .btn-primario:hover { background: var(--acao-hover); }
        .btn-contorno { border-color: var(--linha); background: var(--papel); color: var(--tinta); }
        .btn-contorno:hover { border-color: var(--tinta-3); }
        .btn i { font-size: 19px; }

        /* ---------- topo ---------- */
        .topo { position: sticky; top: 0; z-index: 20; background: rgba(245, 247, 244, .88); backdrop-filter: saturate(160%) blur(10px); border-bottom: 1px solid transparent; transition: border-color .2s; }
        .topo.rolou { border-color: var(--linha); }
        .topo .container { display: flex; align-items: center; justify-content: space-between; height: 68px; gap: 16px; }
        .marca { display: flex; align-items: center; gap: 10px; font-size: 20px; font-weight: 800; letter-spacing: -.3px; text-decoration: none; user-select: none; }
        .marca-icone { width: 32px; height: 32px; border-radius: 9px; background: var(--floresta); color: #fff; display: grid; place-items: center; font-size: 18px; }
        .topo nav { display: flex; align-items: center; gap: 26px; }
        .topo nav a.link { text-decoration: none; color: var(--tinta-2); font-weight: 500; font-size: 15.5px; }
        .topo nav a.link:hover { color: var(--tinta); }
        .topo .btn { padding: 11px 18px; font-size: 15px; }

        /* ---------- hero ---------- */
        .hero { padding: 72px 0 88px; }
        .hero .container { display: grid; grid-template-columns: 1.05fr .95fr; gap: 64px; align-items: center; }
        .hero h1 { font-size: clamp(40px, 5.6vw, 66px); line-height: 1.02; letter-spacing: -1.6px; font-weight: 800; max-width: 13ch; }
        .hero p.sub { font-size: 19px; color: var(--tinta-2); margin: 24px 0 34px; max-width: 46ch; }
        .hero-acoes { display: flex; gap: 12px; flex-wrap: wrap; }
        .hero-nota { margin-top: 22px; font-size: 14.5px; color: var(--tinta-3); display: flex; align-items: center; gap: 8px; }
        .hero-nota i { color: var(--acao); font-size: 17px; }

        /* demonstração: uma conversa real do robô */
        .demo { background: #efeae2; border-radius: 22px; overflow: hidden; box-shadow: 0 30px 60px -28px rgba(14, 59, 46, .45), 0 0 0 1px rgba(14, 59, 46, .08); max-width: 460px; justify-self: end; width: 100%; }
        .demo-topo { background: var(--floresta); color: #fff; display: flex; align-items: center; gap: 12px; padding: 14px 18px; }
        .demo-topo .av { width: 38px; height: 38px; border-radius: 50%; background: var(--sol); color: var(--floresta); display: grid; place-items: center; font-weight: 700; font-family: 'Bricolage Grotesque'; }
        .demo-topo b { display: block; font-weight: 600; font-size: 15.5px; }
        .demo-topo small { font-size: 12.5px; opacity: .75; }
        .demo-corpo { padding: 18px 16px 20px; display: flex; flex-direction: column; gap: 6px; min-height: 420px; font-size: 14.5px; line-height: 1.42; }
        .msg { align-self: flex-start; max-width: 82%; padding: 7px 10px 6px; border-radius: 9px; box-shadow: 0 1px .5px rgba(11, 20, 26, .13); background: #fff; position: relative; }
        .msg.out { align-self: flex-end; background: var(--balao-out); }
        .msg small { display: block; text-align: right; font-size: 11px; color: #667781; margin-top: 2px; }
        .msg .quem { display: block; font-size: 12.5px; font-weight: 600; margin-bottom: 1px; }
        .msg .quem.bot { color: #06a07a; }
        .msg .quem.humano { color: #027eb5; }
        .aviso-demo { align-self: center; background: #fff3c4; color: #54656f; font-size: 12.5px; padding: 5px 11px; border-radius: 7px; margin: 6px 0; }
        .demo-corpo > * { opacity: 0; transform: translateY(6px); animation: entra .35s ease forwards; }
        @keyframes entra { to { opacity: 1; transform: none; } }

        /* ---------- seções ---------- */
        section.bloco { padding: 96px 0; }
        .titulo-secao { font-size: clamp(30px, 3.6vw, 44px); line-height: 1.08; letter-spacing: -1px; font-weight: 800; max-width: 22ch; }
        .intro-secao { color: var(--tinta-2); margin-top: 14px; max-width: 56ch; font-size: 18px; }

        /* o que faz */
        .recursos { margin-top: 52px; display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--linha); }
        .recurso { padding: 34px 40px 34px 0; display: grid; grid-template-columns: 48px 1fr; gap: 18px; border-bottom: 1px solid var(--linha); }
        .recurso:nth-child(odd) { border-right: 1px solid var(--linha); }
        .recurso:nth-child(even) { padding-left: 40px; }
        .recurso .ic { width: 48px; height: 48px; border-radius: 12px; background: var(--menta); color: var(--floresta); display: grid; place-items: center; font-size: 23px; }
        .recurso h3 { font-size: 21px; font-weight: 700; letter-spacing: -.3px; margin-bottom: 6px; }
        .recurso p { color: var(--tinta-2); font-size: 16px; }

        /* como funciona (é uma sequência de verdade) */
        .passos-wrap { background: var(--floresta); color: #e7f1ec; border-radius: 28px; padding: 64px 56px; }
        .passos-wrap .titulo-secao { color: #fff; }
        .passos-wrap .intro-secao { color: #a9c4b8; }
        .passos { list-style: none; margin-top: 48px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px; counter-reset: passo; }
        .passos li { counter-increment: passo; border-top: 1px solid rgba(255,255,255,.18); padding-top: 22px; }
        .passos li::before { content: counter(passo); font-family: 'Bricolage Grotesque'; font-weight: 800; font-size: 46px; line-height: 1; color: var(--sol); display: block; margin-bottom: 18px; }
        .passos h3 { font-size: 21px; color: #fff; margin-bottom: 8px; letter-spacing: -.3px; }
        .passos p { font-size: 16px; color: #b9d0c5; }

        /* planos */
        .planos-topo { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
        .abas { display: inline-flex; flex-wrap: wrap; justify-content: center; max-width: 100%; background: var(--papel); border: 1px solid var(--linha); border-radius: 26px; padding: 4px; gap: 2px; }
        .aba { border: 0; background: transparent; padding: 10px 18px; border-radius: 999px; font: 600 15px 'Instrument Sans', sans-serif; color: var(--tinta-2); cursor: pointer; }
        .aba[aria-selected="true"] { background: var(--tinta); color: #fff; }
        .grade-planos { margin-top: 40px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: stretch; }
        .grade-planos[hidden] { display: none; }
        .grade-planos.duas { grid-template-columns: repeat(2, minmax(0, 360px)); }
        .plano { background: var(--papel); border: 1px solid var(--linha); border-radius: 20px; padding: 30px 28px; display: flex; flex-direction: column; position: relative; }
        .plano.destaque { border: 2px solid var(--floresta); }
        .plano .selo { position: absolute; top: -13px; left: 26px; background: var(--sol); color: var(--floresta); font-size: 13px; font-weight: 600; padding: 4px 12px; border-radius: 999px; }
        .plano h3 { font-size: 18px; font-weight: 700; color: var(--tinta-2); }
        .preco { margin: 14px 0 4px; display: flex; align-items: baseline; gap: 6px; }
        .preco b { font-family: 'Bricolage Grotesque'; font-size: 46px; font-weight: 800; letter-spacing: -1.4px; line-height: 1; }
        .preco span { color: var(--tinta-3); font-size: 15px; }
        .plano .obs { color: var(--tinta-3); font-size: 14px; min-height: 22px; }
        .plano ul { list-style: none; margin: 22px 0 28px; display: grid; gap: 11px; font-size: 15.5px; }
        .plano li { display: flex; gap: 10px; align-items: flex-start; }
        .plano li i { color: var(--acao); font-size: 19px; line-height: 1.3; }
        .plano .btn { margin-top: auto; width: 100%; }
        .garantia { margin-top: 28px; display: flex; gap: 14px; align-items: flex-start; color: var(--tinta-2); font-size: 15.5px; max-width: 70ch; }
        .garantia i { font-size: 24px; color: var(--acao); }

        /* dúvidas */
        .duvidas { margin-top: 40px; border-top: 1px solid var(--linha); max-width: 820px; }
        .duvidas details { border-bottom: 1px solid var(--linha); }
        .duvidas summary { list-style: none; cursor: pointer; padding: 24px 0; font-weight: 600; font-size: 19px; display: flex; justify-content: space-between; gap: 20px; }
        .duvidas summary::-webkit-details-marker { display: none; }
        .duvidas summary i { color: var(--tinta-3); transition: transform .2s; font-size: 22px; }
        .duvidas details[open] summary i { transform: rotate(45deg); }
        .duvidas details p { color: var(--tinta-2); padding: 0 40px 26px 0; max-width: 68ch; }

        /* chamada final */
        .final { background: var(--papel); border: 1px solid var(--linha); border-radius: 28px; padding: 56px; display: flex; justify-content: space-between; align-items: center; gap: 32px; flex-wrap: wrap; }
        .final h2 { font-size: clamp(28px, 3.2vw, 40px); letter-spacing: -.9px; line-height: 1.1; max-width: 20ch; }
        .final p { color: var(--tinta-2); margin-top: 10px; }

        /* rodapé */
        footer { padding: 56px 0 40px; color: var(--tinta-2); font-size: 15px; }
        .rodape-grade { display: flex; justify-content: space-between; gap: 32px; flex-wrap: wrap; padding-bottom: 32px; border-bottom: 1px solid var(--linha); }
        .rodape-links { display: flex; gap: 48px; flex-wrap: wrap; }
        .rodape-links div { display: grid; gap: 10px; align-content: start; }
        .rodape-links b { color: var(--tinta); font-size: 14px; font-weight: 600; }
        .rodape-links a { text-decoration: none; display: inline-flex; align-items: center; gap: 7px; }
        .rodape-links a:hover { color: var(--tinta); }
        .legal { padding-top: 24px; font-size: 13px; color: var(--tinta-3); display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
        .legal p { max-width: 72ch; }

        /* ---------- responsivo ---------- */
        @media (max-width: 960px) {
            .hero .container { grid-template-columns: 1fr; gap: 48px; }
            .demo { justify-self: center; width: 100%; max-width: 560px; }
            .recursos { grid-template-columns: 1fr; }
            .recurso, .recurso:nth-child(even) { padding: 28px 0; border-right: 0 !important; }
            .passos { grid-template-columns: 1fr; gap: 28px; }
            .passos-wrap { padding: 44px 26px; border-radius: 22px; }
            .grade-planos, .grade-planos.duas { grid-template-columns: 1fr; max-width: 440px; }
            .final { padding: 36px 26px; }
        }
        @media (max-width: 640px) {
            body { font-size: 16px; }
            .topo nav a.link { display: none; }
            .hero { padding: 40px 0 64px; }
            section.bloco { padding: 68px 0; }
            .hero-acoes .btn { width: 100%; }
            .demo-corpo { min-height: 0; }
        }
        /* celulares muito estreitos (dobráveis fechados, 280–360px) */
        @media (max-width: 360px) {
            .btn { white-space: normal; text-align: center; padding: 13px 16px; font-size: 15px; }
            .container { padding: 0 16px; }
            .hero-acoes { width: 100%; }
        }
        @media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            .demo-corpo > * { animation: none; opacity: 1; transform: none; }
        }

        /* ==================== ABERTURA HUD "CALIXTO" ==================== */
        #jarvis-loader {
            position: fixed; inset: 0; z-index: 99999; overflow: hidden;
            background: radial-gradient(circle at 50% 45%, #0d2c3d 0%, #04121b 48%, #010508 100%);
            display: flex; align-items: center; justify-content: center;
            perspective: 1000px;
            transition: opacity .7s ease;
            animation: jv-fim .7s ease 3.4s forwards; /* saída de segurança se o JavaScript falhar */
        }
        #jarvis-loader.loaded { opacity: 0; visibility: hidden; pointer-events: none; }
        @keyframes jv-fim { to { opacity: 0; visibility: hidden; pointer-events: none; } }

        /* grade de fundo, em perspectiva */
        .jv-grade {
            position: absolute; left: -30%; right: -30%; top: 30%; bottom: -30%;
            background-image: linear-gradient(rgba(90,220,255,.09) 1px, transparent 1px), linear-gradient(90deg, rgba(90,220,255,.09) 1px, transparent 1px);
            background-size: 48px 48px; transform: rotateX(62deg); transform-origin: 50% 0;
            -webkit-mask-image: radial-gradient(ellipse at 50% 0%, #000 10%, transparent 70%);
            mask-image: radial-gradient(ellipse at 50% 0%, #000 10%, transparent 70%);
            animation: jv-grade-anda 1.6s linear infinite;
        }
        @keyframes jv-grade-anda { from { background-position: 0 0; } to { background-position: 0 48px; } }

        /* o HUD: entra inclinado e se endireita; no fim cresce e some */
        .jv-hud {
            position: relative; width: min(80vw, 64vh, 460px); aspect-ratio: 1;
            transform-style: preserve-3d;
            transform: rotateX(62deg) scale(.6); opacity: 0;
            animation: jv-entra 1.1s cubic-bezier(.2,.8,.2,1) .1s forwards;
            transition: scale .6s ease-in, opacity .6s ease-in;
        }
        #jarvis-loader.loaded .jv-hud { scale: 1.45; opacity: 0; }
        @keyframes jv-entra { to { transform: rotateX(12deg) scale(1); opacity: 1; } }

        .jv-anel { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; overflow: visible;
            filter: drop-shadow(0 0 6px rgba(90,225,255,.75)); transform-origin: 50% 50%; }
        /* em SVG a rotação parte do canto: fixa o centro (200,200) do desenho */
        .jv-tiques, .jv-banda, .jv-amarelo, .jv-fino { transform-box: view-box; transform-origin: 200px 200px; }
        .jv-tiques { stroke: #7fe9ff; opacity: .8; animation: jv-gira 60s linear infinite; }
        .jv-banda { stroke: #7fe9ff; animation: jv-gira-inv 16s linear infinite; }
        .jv-amarelo { stroke: #f7c948; stroke-linecap: round; animation: jv-gira 5s linear infinite; }
        .jv-fino { stroke: rgba(200,245,255,.7); animation: jv-gira-inv 24s linear infinite; }
        .jv-tiques line { stroke: #7fe9ff; }
        @keyframes jv-gira { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        @keyframes jv-gira-inv { from { transform: rotate(0deg); } to { transform: rotate(-360deg); } }

        .jv-nome {
            position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
            pointer-events: none;
        }
        .jv-nome h1 {
            margin: 0 -.34em 0 0; /* compensa o espaço depois da última letra */
            font-family: 'Orbitron', sans-serif; font-weight: 700;
            font-size: clamp(18px, 5.4vw, 32px); color: #f2fdff; white-space: nowrap;
            text-shadow: 0 0 10px rgba(90,225,255,.95), 0 0 26px rgba(90,225,255,.55);
            letter-spacing: .34em;
            animation: jv-nome 1s cubic-bezier(.2,.8,.2,1) 1s both;
        }
        @keyframes jv-nome {
            from { opacity: 0; letter-spacing: .75em; filter: blur(6px); }
            to { opacity: 1; letter-spacing: .34em; filter: blur(0); }
        }
        @media (prefers-reduced-motion: reduce) { #jarvis-loader { display: none; } }
    </style>
</head>
<body>
<%- include('partials/abertura') %>

