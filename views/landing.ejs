<!DOCTYPE html>
<html lang="pt-br" style="scroll-behavior: smooth;">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calixto OmniSystem | V10.0</title>
    
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;500;700&display=swap" rel="stylesheet">

    <style>
        /* ============================
           VARIÁVEIS
           ============================ */
        :root {
            --neon-pink: #ff0055;
            --neon-cyan: #00f3ff;
            --neon-purple: #bd00ff;
            --glass-dark: rgba(0, 0, 0, 0.75);
            --glass-border: rgba(255, 255, 255, 0.1);
            --text-white: #ffffff;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: #050505;
            color: var(--text-white);
            font-family: 'Rajdhani', sans-serif;
            overflow-x: hidden;
            
            /* IMAGEM DE FUNDO FIXA */
            background-image: url('/uploads/illustration-rain-futuristic-city_23-2151406573.avif');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            min-height: 100vh;
        }

        body::after {
            content: '';
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(5, 5, 10, 0.7); /* Máscara escura */
            z-index: -1;
        }

        /* =========================================
           ABERTURA JARVIS (LOADER) - VOLTOU!
           ========================================= */
        #jarvis-loader {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: #000; z-index: 99999;
            display: flex; align-items: center; justify-content: center;
            font-family: 'Share Tech Mono', monospace; overflow: hidden;
            transition: opacity 0.5s ease-out;
        }
        .holo-floor {
            position: absolute; bottom: -20%; left: -50%; width: 200%; height: 100%;
            background-image: 
                linear-gradient(rgba(0, 247, 255, 0.3) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 247, 255, 0.3) 1px, transparent 1px);
            background-size: 60px 60px;
            transform: perspective(600px) rotateX(60deg);
            animation: holoMove 15s linear infinite; opacity: 0.4;
            mask-image: linear-gradient(to top, rgba(0,0,0,1) 0%, transparent 80%);
        }
        .jarvis-core { position: relative; width: 400px; height: 400px; display: flex; align-items: center; justify-content: center; }
        .ring { position: absolute; border-radius: 50%; border: 2px solid transparent; box-shadow: 0 0 15px rgba(0, 247, 255, 0.2); }
        .ring-1 { width: 360px; height: 360px; border-top: 4px solid var(--neon-cyan); border-bottom: 2px solid var(--neon-purple); animation: spin-right 2s linear infinite; }
        .ring-2 { width: 320px; height: 320px; border-left: 4px solid var(--neon-cyan); border-right: 2px solid transparent; animation: spin-left 4s linear infinite; }
        .core-content { text-align: center; z-index: 10; text-shadow: 0 0 10px var(--neon-cyan); }
        .loading-bar { width: 200px; height: 4px; background: #111; margin: 10px auto; position: relative; overflow: hidden; }
        .bar-fill { height: 100%; background: var(--neon-cyan); width: 0%; box-shadow: 0 0 10px var(--neon-cyan); animation: loadBar 5s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
        .data-stream { position: absolute; right: 20px; bottom: 50px; color: rgba(0, 247, 255, 0.6); font-size: 11px; text-align: right; border-right: 2px solid var(--neon-cyan); padding-right: 15px; }
        .crt-flash { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #fff; opacity: 0; pointer-events: none; z-index: 100000; }

        @keyframes holoMove { 0% { background-position: 0 0; } 100% { background-position: 0 120px; } }
        @keyframes spin-right { 100% { transform: rotate(360deg); } }
        @keyframes spin-left { 100% { transform: rotate(-360deg); } }
        @keyframes loadBar { 0% { width: 0; } 50% { width: 40%; } 100% { width: 100%; } }
        @keyframes crtTurnOn { 0% { transform: scaleY(0.01) scaleX(0); background: #fff; opacity: 1;} 50% { transform: scaleY(0.01) scaleX(1); background: #fff; opacity: 1;} 60% { transform: scaleY(1) scaleX(1); background: #fff; opacity: 0.1;} 100% { transform: scaleY(1) scaleX(1); background: transparent; opacity: 0;} }


        /* ============================
           NAVBAR (COM SOCIAIS)
           ============================ */
        nav {
            position: fixed;
            top: 0; width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 8%;
            z-index: 1000;
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255,255,255,0.05);
            background: linear-gradient(to bottom, rgba(0,0,0,0.9), transparent);
        }

        .logo {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.5rem;
            font-weight: 900;
            letter-spacing: 2px;
            color: #fff;
            text-shadow: 0 0 10px var(--neon-cyan);
        }
        .logo span { color: var(--neon-cyan); }

        /* Container da direita (Links + Botão) */
        .nav-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .social-link {
            color: #ccc;
            font-size: 1.4rem;
            text-decoration: none;
            transition: 0.3s;
            display: flex;
            align-items: center;
        }

        .social-link:hover {
            transform: scale(1.1);
            color: #fff;
        }

        .social-link:hover .ri-whatsapp-line { color: #00ff88; text-shadow: 0 0 10px #00ff88; }
        .social-link:hover .ri-instagram-line { color: var(--neon-pink); text-shadow: 0 0 10px var(--neon-pink); }

        .nav-divider {
            width: 1px;
            height: 25px;
            background: rgba(255,255,255,0.2);
        }

        .btn-login {
            text-decoration: none;
            color: var(--neon-cyan);
            font-weight: 700;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 8px 25px;
            border: 1px solid var(--neon-cyan);
            border-radius: 4px;
            transition: 0.3s;
            background: rgba(0, 243, 255, 0.1);
        }

        .btn-login:hover {
            background: var(--neon-cyan);
            color: #000;
            box-shadow: 0 0 20px var(--neon-cyan);
        }

        /* ============================
           HERO SECTION
           ============================ */
        .hero {
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 0 20px;
        }

        .tag-version {
            background: linear-gradient(90deg, var(--neon-purple), var(--neon-pink));
            padding: 5px 12px;
            font-size: 0.8rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 20px;
            box-shadow: 0 0 15px rgba(255, 0, 85, 0.5);
            transform: skew(-10deg);
        }

        .hero h1 {
            font-family: 'Orbitron', sans-serif;
            font-size: clamp(3rem, 6vw, 5.5rem);
            line-height: 1;
            text-transform: uppercase;
            margin-bottom: 20px;
            text-shadow: 0 0 30px rgba(0,0,0,0.8);
        }

        .hero h1 span {
            display: block;
            color: transparent;
            -webkit-text-stroke: 1px #fff;
            opacity: 0.8;
            font-size: 0.8em;
        }
        
        .hero h1 strong {
            background: linear-gradient(to bottom, #fff, var(--neon-cyan));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 0 10px var(--neon-cyan));
        }

        .hero p {
            font-size: 1.2rem;
            max-width: 700px;
            color: #ddd;
            margin-bottom: 40px;
            line-height: 1.6;
            text-shadow: 0 2px 5px rgba(0,0,0,1);
            background: rgba(0,0,0,0.5);
            padding: 15px;
            border-radius: 10px;
            backdrop-filter: blur(5px);
        }

        .cta-btn {
            padding: 18px 50px;
            background: var(--neon-pink);
            color: #fff;
            text-decoration: none;
            font-weight: 800;
            font-size: 1.1rem;
            border-radius: 50px;
            transition: 0.3s;
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 0 20px rgba(255, 0, 85, 0.4);
            border: 1px solid rgba(255,255,255,0.2);
        }

        .cta-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 40px rgba(255, 0, 85, 0.8);
            background: #fff;
            color: var(--neon-pink);
        }

        /* ============================
           SEÇÕES GERAIS
           ============================ */
        section { padding: 80px 5%; position: relative; }
        .section-title { text-align: center; font-family: 'Orbitron'; font-size: 2.5rem; margin-bottom: 10px; text-shadow: 0 0 10px var(--neon-purple); }
        .section-subtitle { text-align: center; color: #aaa; margin-bottom: 60px; font-size: 1.1rem; }
        
        .pricing-grid { display: flex; justify-content: center; flex-wrap: wrap; gap: 30px; }

        /* CARDS */
        .price-card {
            background: var(--glass-dark);
            border: 1px solid var(--glass-border);
            backdrop-filter: blur(20px);
            padding: 40px 30px;
            border-radius: 15px;
            width: 350px;
            text-align: center;
            transition: 0.4s;
            position: relative;
        }
        .price-card:hover { transform: translateY(-10px); border-color: var(--neon-cyan); box-shadow: 0 0 30px rgba(0, 243, 255, 0.2); }

        .price-card.featured {
            border: 1px solid var(--neon-pink); background: rgba(20, 0, 10, 0.85);
            box-shadow: 0 0 20px rgba(255, 0, 85, 0.2); transform: scale(1.05); z-index: 10;
        }

        .price-card.ai-tier { border: 1px solid var(--neon-purple); background: rgba(10, 0, 20, 0.85); }
        .price-card.ai-tier:hover { border-color: #fff; box-shadow: 0 0 30px var(--neon-purple); }

        .badge-popular {
            position: absolute; top: -12px; left: 50%; transform: translateX(-50%);
            background: var(--neon-pink); color: #fff; padding: 5px 15px;
            font-size: 0.8rem; font-weight: bold; border-radius: 20px; text-transform: uppercase;
        }

        .plan-name { font-family: 'Orbitron'; font-size: 1.5rem; margin-bottom: 10px; color: #fff; }
        .price { font-size: 2.8rem; font-weight: 700; color: #fff; display: block; margin: 15px 0; text-shadow: 0 0 10px rgba(255,255,255,0.3); }
        .price span { font-size: 1rem; color: #aaa; font-weight: 400; }
        .setup { display: block; color: var(--neon-purple); font-size: 0.9rem; font-weight: bold; text-transform: uppercase; margin-bottom: 30px; }

        .features { list-style: none; text-align: left; margin-bottom: 40px; }
        .features li { padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,0.1); color: #ddd; display: flex; align-items: center; gap: 10px; font-size: 0.95rem; }
        .features li i { color: var(--neon-cyan); font-size: 1.1rem; }
        
        .btn-plan {
            display: block; width: 100%; padding: 15px 0; text-decoration: none; color: #fff;
            border: 1px solid rgba(255,255,255,0.3); border-radius: 5px; font-weight: bold;
            text-transform: uppercase; transition: 0.3s;
        }
        .btn-plan:hover { background: #fff; color: #000; }
        .featured .btn-plan { background: var(--neon-pink); border-color: var(--neon-pink); }
        .featured .btn-plan:hover { background: #ff3377; color: #fff; box-shadow: 0 0 20px var(--neon-pink); }
        .ai-tier .btn-plan { border-color: var(--neon-purple); color: var(--neon-purple); }
        .ai-tier .btn-plan:hover { background: var(--neon-purple); color: #fff; box-shadow: 0 0 20px var(--neon-purple); }

        /* GALERIA */
        .gallery-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-top: 40px; }
        .gallery-item {
            aspect-ratio: 16/9; background: rgba(0,0,0,0.5); border: 1px solid var(--glass-border);
            border-radius: 10px; overflow: hidden; position: relative; display: flex;
            align-items: center; justify-content: center; transition: 0.3s;
        }
        .gallery-item:hover { border-color: var(--neon-purple); transform: scale(1.02); }
        .placeholder-text { color: #555; font-family: 'Orbitron'; text-transform: uppercase; letter-spacing: 2px; text-align: center; }

        footer { text-align: center; padding: 40px; font-size: 0.8rem; color: #888; border-top: 1px solid rgba(255,255,255,0.1); background: #000; margin-top: 50px; }

        @media (max-width: 768px) {
            .hero h1 { font-size: 3rem; }
            .pricing-grid { flex-direction: column; align-items: center; }
            .price-card.featured { transform: scale(1); }
            .nav-right { display: none; } /* Em mobile simplifica */
        }
    </style>
</head>
